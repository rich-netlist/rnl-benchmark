subckt Main (VDD VSS Vo)
C1 (net4 VSS) capacitor c=1p
C2 (Vo VSS) capacitor c=1p
C3 (net3 net0) capacitor c=1p
C4 (net1 net5) capacitor c=1p
C5 (net3 net2) capacitor c=1p
C6 (net6 net5) capacitor c=1p
M1 (VSS net0 net1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (net4 net1 net0 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net0 net1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (net1 net0 net4 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (net4 net2 net6 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (Vo net6 net2 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M7 (net2 net6 net4 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M8 (net6 net2 Vo VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (Vo VSS) resistor r=1k
V1 (net3 net5) vsource dc=1.8
