subckt dut (VDD VSS IN LO LO_bar IF\+ IF\-)
C1 (VSS net0) capacitor c=1p
C2 (VSS net1) capacitor c=1p
C3 (net2 IN) capacitor c=1p
C4 (net3 VSS) capacitor c=1p
L1 (net2 net3) inductor l=1n
M1 (net0 LO net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MN2 (net1 LO_bar net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MN3 (IF\+ net0 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MN4 (IF\- net1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MP1 (IF\+ net0 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1 m=1
MP2 (IF\- net1 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1 m=1
R1 (IF\- net1) resistor r=1k
R2 (IF\+ net0) resistor r=1k
