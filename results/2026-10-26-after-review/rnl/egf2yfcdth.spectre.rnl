subckt opamp_differential (VIP VIN VOP VON VDD VSS)
parameters gain=1e6
EPLUS (VOP 0 VIP VIN) vcvs gain=gain/2
EMINUS (VON 0 VIN VIP) vcvs gain=gain/2
ends opamp_differential

subckt Main (VDD VSS Voutp Vout Vinp Vin Vin2 Vicm Vocm PHI1 S1 X11 X12 PHI2 X3 X4 X5 PHI1pp)
subckt ideal_switch (p n cp cn)
parameters ron=1 roff=1e12 vt=0.5
core (p n) bsource i=v(p,n)/(v(cp,cn)>vt ? ron : roff)
ends ideal_switch
C1 (net2 net3) capacitor c=1p
C2 (net5 net0) capacitor c=1p
C3 (net3 net4) capacitor c=1p
C4 (net0 net1) capacitor c=1p
M1 (Vinp PHI1 net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (Vin PHI1 net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
S1 (net4 Vocm S1 VSS) ideal_switch
X1 (net0 net3 Voutp Vout VDD VSS) opamp_differential
X11 (net3 Vicm X11 VSS) ideal_switch
X12 (Vicm net0 X12 VSS) ideal_switch
X2 (net1 Voutp PHI2 VSS) ideal_switch
X3 (Vout net4 X3 VSS) ideal_switch
X4 (Vin2 net2 X4 VSS) ideal_switch
X5 (net5 Vin2 X5 VSS) ideal_switch
X7 (net1 Vocm PHI1 VSS) ideal_switch
X8 (net3 net0 PHI1pp VSS) ideal_switch
X9 (Vout Voutp PHI1 VSS) ideal_switch
