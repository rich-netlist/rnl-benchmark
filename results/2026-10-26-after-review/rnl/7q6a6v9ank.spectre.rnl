simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="rnl-std", version="0.3");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.2");
//   @USE-PACKAGE(name="rnl-std-logic", version="0.3")
// }

// Ideal buffer: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
subckt buffer (A Y VDD VSS)
parameters vt=10m td=10p
BhA (hA 0) bsource v=0.5*(1+tanh((v(A,VSS)-0.5*v(VDD,VSS))/vt))
Bf (nfn VSS) bsource v=v(VDD,VSS)*(v(hA))
Rd (nfn ndl) resistor r=1k
Cd (ndl VSS) capacitor c=td/1000
BY (Y VSS) bsource v=v(ndl,VSS)
ends buffer

subckt dut (VDD VSS Vin OS CMPout)
model NMOS bsim4 type=n
model PMOS bsim4 type=p
I0 (net9 VSS) isource dc=1m
I2 (net0 net12) isource dc=100u
I3 (net15 net13) isource dc=100u
I4 (net5 VSS) isource dc=100u
I5 (VDD net11) isource dc=1m
I6 (VDD net10) isource dc=1m
I7 (OS VSS) isource dc=100u
M1 (VSS Vin net10 VDD) PMOS l=150n m=1 nf=1 w=1u
M10 (net7 net3 net15 VSS) NMOS l=150n m=1 nf=1 w=1u
M12 (VSS Vin net11 VDD) PMOS l=150n m=1 nf=1 w=1u
M13 (net7 net2 VDD VDD) PMOS l=150n m=1 nf=1 w=1u
M14 (net2 net2 VDD VDD) PMOS l=150n m=1 nf=1 w=1u
M15 (net2 net3 net0 VSS) NMOS l=150n m=1 nf=1 w=1u
M16 (net5 net7 VDD VDD) PMOS l=150n m=1 nf=1 w=1u
M2 (net4 net10 net9 VSS) NMOS l=150n m=1 nf=1 w=1u
M3 (net6 net11 net9 VSS) NMOS l=150n m=1 nf=1 w=1u
M6 (net12 net8 VSS VSS) NMOS l=150n m=1 nf=1 w=1u
M7 (net13 net14 VSS VSS) NMOS l=150n m=1 nf=1 w=1u
M8 (net7 net1 net6 VSS) NMOS l=150n m=1 nf=1 w=1u
M9 (net2 net1 net4 VSS) NMOS l=150n m=1 nf=1 w=1u
X1 (net5 net8 VDD VSS) buffer
X2 (net8 net14 VDD VSS) buffer
X3 (net5 CMPout VDD VSS) buffer
