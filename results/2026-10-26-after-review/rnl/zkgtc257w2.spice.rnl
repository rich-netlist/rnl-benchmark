
* @RNL(type="header") {
*   @VERSION("0.3");
*   @USE-PACKAGE(name="rnl-std", version="0.3");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.2")
* }
.subckt opamp_differential VIP VIN VOP VON VDD VSS params: gain=1e6
EPLUS VOP 0 VIP VIN {gain/2}
EMINUS VON 0 VIN VIP {gain/2}
.ends opamp_differential

.subckt dut VSS Vi Vo+ Vo-
C1 net2 Vi 1p
C2 net3 VSS 1p
C3 net6 net2 1p
C4 net7 net3 1p
C5 VSS net4 1p
C6 net5 VSS 1p
C7 Vo- net1 1p
C8 Vo+ net0 1p
R1 net6 net2 1k
R2 net7 net3 1k
R3 net5 net6 1k
R4 net4 net7 1k
R5 net1 net5 1k
R6 net0 net4 1k
R7 Vo- net5 1k
R8 Vo+ net4 1k
X1 net2 net3 net7 net6 0 VSS opamp_differential gain=1e6
X2 net1 net0 Vo+ Vo- 0 VSS opamp_differential gain=1e6
