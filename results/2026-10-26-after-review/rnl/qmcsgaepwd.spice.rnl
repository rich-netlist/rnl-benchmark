
* @RNL(type="header") {
*   @VERSION("0.3");
*   @USE-PACKAGE(name="rnl-std", version="0.3");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.2");
*   @USE-PACKAGE(name="rnl-std-logic", version="0.3")
* }
* Ideal d-flip-flop: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt d_flip_flop D CK Q QBAR VDD VSS params: vt=10m td=10p
BhD hD 0 V={0.5*(1+tanh((V(D,VSS)-0.5*V(VDD,VSS))/vt))}
BhCK hCK 0 V={0.5*(1+tanh((V(CK,VSS)-0.5*V(VDD,VSS))/vt))}
Bm 0 nm I={10m*((V(hD)-V(nm))*(1-V(hCK)))}
Cm nm 0 1p
Rm nm 0 1T
Bs 0 ns I={10m*((V(nm)-V(ns))*V(hCK))}
Cs ns 0 1p
Rs ns 0 1T
Bf nfn VSS V={V(VDD,VSS)*(0.5*(1+tanh((V(ns)-0.5)/10m)))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BQ Q VSS V={V(ndl,VSS)}
BQBAR QBAR VSS V={V(VDD,VSS)-V(ndl,VSS)}
.ends d_flip_flop

.subckt johnson_counter VDD VSS clk q1 q2 q3
X1 net0 clk q1 NC0001 VDD VSS d_flip_flop td=10p vt=10m
X2 q1 clk q2 NC0002 VDD VSS d_flip_flop td=10p vt=10m
X3 q2 clk q3 net0 VDD VSS d_flip_flop td=10p vt=10m
* @RNL(author="analog-canvas") {
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #X1 @SET-SYMBOL $D_FLIP_FLOP => @PLACE(10, 0) => @ORIENT("R0");
*   #X2 @SET-SYMBOL $D_FLIP_FLOP => @PLACE(24, 0) => @ORIENT("R0");
*   #X3 @SET-SYMBOL $D_FLIP_FLOP => @PLACE(38, 0) => @ORIENT("R0");
*   $IO_PORT @ATTACH &clk(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(3, -6) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &q1(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(17, 3) => @ORIENT("R270") => %port2;
*   $IO_PORT @ATTACH &q2(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(31, 3) => @ORIENT("R270") => %port3;
*   $IO_PORT @ATTACH &q3(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(44, 3) => @ORIENT("R270") => %port4;
*   &VDD @REMOVE-FROM $PORT_FILL_SET;
*   &VSS @REMOVE-FROM $PORT_FILL_SET;
*   %j1 = (5, -6);
*   $JUNCTION @ATTACH %j1;
*   %j2 = (19, -6);
*   $JUNCTION @ATTACH %j2;
*   %j3 = (17, 1);
*   $JUNCTION @ATTACH %j3;
*   %j4 = (31, 1);
*   $JUNCTION @ATTACH %j4;
*   &q1 @WIRE(mode="straight") {#X1:3 %j3};
*   &q1 @WIRE(mode="straight") {%j3 #X2:1};
*   &q2 @WIRE(mode="straight") {#X2:3 %j4};
*   &q2 @WIRE(mode="straight") {%j4 #X3:1};
*   &net0 @WIRE(mode="straight") {#X3:4 (46, -1) (46, 10) (4, 10) (4, 1) #X1:1};
*   &clk @WIRE(mode="straight") {%port1:p %j1};
*   &clk @WIRE(mode="straight") {%j1 %j2};
*   &clk @WIRE(mode="straight") {%j2 (33, -6) (33, -1) #X3:2};
*   &clk @WIRE(mode="straight") {#X1:2 (5, -1) %j1};
*   &clk @WIRE(mode="straight") {#X2:2 (19, -1) %j2};
*   &q1 @WIRE(mode="straight") {%j3 %port2:p};
*   &q2 @WIRE(mode="straight") {%j4 %port3:p};
*   &q3 @WIRE(mode="straight") {#X3:3 (44, 1) %port4:p};
*   %port1 @TEXT("\textbf{\textit{clk}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::name(label);
*   %port2 @TEXT("\textbf{\textit{q1}}", key="name", dx=0, dy=1.9, halign="middle", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::name(label);
*   %port3 @TEXT("\textbf{\textit{q2}}", key="name", dx=0, dy=1.9, halign="middle", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::name(label);
*   %port4 @TEXT("\textbf{\textit{q3}}", key="name", dx=0, dy=1.9, halign="middle", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::name(label)
* }
.ends johnson_counter
