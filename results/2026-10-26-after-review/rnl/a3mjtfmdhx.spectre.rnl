simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="rnl-std", version="0.3");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.2")
// }

subckt dut (VDD VSS Vctrl S1)
subckt ideal_switch (p n cp cn)
parameters ron=1 roff=1e12 vt=0.5
core (p n) bsource i=v(p,n)/(v(cp,cn)>vt ? ron : roff)
ends ideal_switch
C1 (net1 net0) capacitor c=1p
C2 (net2 net4) capacitor c=1p
C3 (Vctrl net0) capacitor c=1p
C4 (Vctrl net0) capacitor c=1p
C5 (Vctrl net2) capacitor c=1p
I1 (VDD net3) isource dc=100u
L1 (net0 net2) inductor l=1n
M1 (net0 net2 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (net2 net0 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net2 net0 net3 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (net0 net2 net3 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
S1 (net1 net4 S1 VSS) ideal_switch
