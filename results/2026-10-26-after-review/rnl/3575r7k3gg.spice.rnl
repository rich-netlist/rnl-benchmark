*   $CANVAS_NAME @ATTACH(name="MNM1") #XMNM1(part);
*   $IO_PORT @ATTACH &VOUT(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(45, 40) => @ORIENT("MY") => %port1;
*   #Xmp0 @SET-SYMBOL $PMOS_4TERM => @PLACE(8, 3) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="mp0") #Xmp0(part);
