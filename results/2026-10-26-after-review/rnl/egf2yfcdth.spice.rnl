
* @RNL(type="header") {
*   @VERSION("0.3");
*   @USE-PACKAGE(name="rnl-std", version="0.3");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.2")
* }
.subckt opamp_differential VIP VIN VOP VON VDD VSS params: gain=1e6
EPLUS VOP 0 VIP VIN {gain/2}
EMINUS VON 0 VIN VIP {gain/2}
.ends opamp_differential

.subckt Main VDD VSS Voutp Vout Vinp Vin Vin2 Vicm Vocm PHI1 S1 X11 X12 PHI2 X3 X4 X5 PHI1pp
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
C1 net2 net3 1p
C2 net5 net0 1p
C3 net3 net4 1p
C4 net0 net1 1p
XM1 Vinp PHI1 net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 Vin PHI1 net5 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
S1 net4 Vocm S1 VSS ideal_switch
X1 net0 net3 Voutp Vout VDD VSS opamp_differential
SX11 net3 Vicm X11 VSS ideal_switch
SX12 Vicm net0 X12 VSS ideal_switch
SX2 net1 Voutp PHI2 VSS ideal_switch
SX3 Vout net4 X3 VSS ideal_switch
SX4 Vin2 net2 X4 VSS ideal_switch
SX5 net5 Vin2 X5 VSS ideal_switch
SX7 net1 Vocm PHI1 VSS ideal_switch
SX8 net3 net0 PHI1pp VSS ideal_switch
SX9 Vout Voutp PHI1 VSS ideal_switch
