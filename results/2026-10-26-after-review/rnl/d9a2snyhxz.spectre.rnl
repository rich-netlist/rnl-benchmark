subckt dut (VDD VSS)
C1 (net2 net1) capacitor c=1p
C2 (Vout net1) capacitor c=1p
M1 (net0 Vin\- net6 VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M10 (net4 net3 VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M11 (Vout Vb1 VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M12 (net4 net4 VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M13 (Vout net4 VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M2 (net5 Vin\+ net6 VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M3 (net0 net0 VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M4 (net5 net0 VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M5 (net6 Vb1 VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M6 (net2 Vb2 VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M7 (VDD net3 net2 VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M8 (VSS net5 net3 VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M9 (net3 Vb1 VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
R1 (net1 net5) resistor r=1k
