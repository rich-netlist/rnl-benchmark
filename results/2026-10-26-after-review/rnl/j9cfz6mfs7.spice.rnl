XM5 net5 VB3 net12 VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 net4 VB4 net6 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
