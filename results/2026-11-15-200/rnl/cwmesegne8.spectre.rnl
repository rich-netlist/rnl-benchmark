simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
//   @DEVICE(model="sky130_fd_pr__pfet_01v8", terminals=["d", "g", "s", "b"], type="pmos");
//   @DEVICE(model="sky130_fd_pr__nfet_01v8", terminals=["d", "g", "s", "b"], type="nmos")
// }

subckt dut (VDD VSS Vinp Vinn VBN VBIAS VBB1 VBB2 VCMI Vop Von)
subckt ideal_switch (p n cp cn)
parameters ron=1 roff=1e12 vt=0.5
core (p n) bsource i=v(p,n)/(v(cp,cn)>vt ? ron : roff)
ends ideal_switch
C1 (Von net3) capacitor c=0.3p
C2 (net6 net7) capacitor c=5f
C3 (net5 net7) capacitor c=5f
C4 (net5 net4) capacitor c=5f
C5 (net6 net4) capacitor c=5f
Cc (net0 Vop) capacitor c=0.3p
I1 (VBB1 VSS) isource dc=33.333333u
I2 (VBIAS VSS) isource dc=33.333333u
M1 (net0 VBIAS VDD VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=35.64 nf=12 m=1
M10 (net8 VBB1 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=2.22 nf=1 m=1
M11 (VBB1 VBB1 net8 VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=13.8 nf=6 m=1
M12 (net9 VBIAS VDD VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=17.82 nf=6 m=1
M13 (VBIAS VBB1 net9 VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=14.91 nf=6 m=1
M14 (net13 VBIAS VDD VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=17.82 nf=6 m=1
M15 (VBN VBB1 net13 VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=15.03 nf=6 m=1
M16 (net12 VBIAS VDD VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=17.82 nf=6 m=1
M17 (VCMI VBB1 net12 VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=16.11 nf=6 m=1
M18 (VBN VCMI net14 VSS) sky130_fd_pr__nfet_01v8 l=0.3 w=7.25 nf=1 m=1
M19 (net14 VBN VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=13.9833 nf=3 m=1
M2 (net3 VBIAS VDD VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=35.64 nf=12 m=1
M20 (VCMI VCMI net15 VSS) sky130_fd_pr__nfet_01v8 l=0.3 w=3.465 nf=1 m=1
M21 (net15 VCMI VSS VSS) sky130_fd_pr__nfet_01v8 l=0.3 w=0.915 nf=1 m=1
M22 (Vx Vcmfb VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=13.9833 nf=3 m=3
M23 (Von net2 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=600 nf=240 m=1
M24 (Vop net1 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=600 nf=240 m=1
M25 (Vop VBN VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=400 nf=160 m=1
M26 (Von VBN VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=400 nf=160 m=1
M27 (net17 VBB2 Vx VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1.02 nf=1 m=1
M28 (net16 VBB2 net17 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1.02 nf=1 m=1
M29 (VBB2 VBB2 net16 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1.02 nf=1 m=1
M3 (net1 VBB1 net0 VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=62.16 nf=24 m=1
M30 (VBB2 VBIAS VDD VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=16.44 nf=6 m=1
M31 (Vcmfb net7 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=17.82 nf=6 m=1
M32 (Vcmfb Vcmfb VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=13.9833 nf=3 m=1
M4 (net2 VBB1 net3 VDD) sky130_fd_pr__pfet_01v8 l=0.3 w=62.16 nf=24 m=1
M5 (net1 VBB2 net10 VSS) sky130_fd_pr__nfet_01v8 l=0.3 w=6.68 nf=4 m=1
M6 (net2 VBB2 net11 VSS) sky130_fd_pr__nfet_01v8 l=0.3 w=6.68 nf=4 m=1
M7 (net10 Vinp Vx VSS) sky130_fd_pr__nfet_01v8 l=0.3 w=7.62 nf=4 m=1
M8 (net11 Vinn Vx VSS) sky130_fd_pr__nfet_01v8 l=0.3 w=7.62 nf=4 m=1
M9 (Vx VBN VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=13.9833 nf=3 m=2
S1 (net4 net7 phi2 VSS) ideal_switch
S2 (VBIAS net4 phi1 VSS) ideal_switch
S3 (Vcmref net5 phi1 VSS) ideal_switch
S4 (Vcmref net6 phi1 VSS) ideal_switch
S5 (net5 Von phi2 VSS) ideal_switch
S6 (net6 Vop phi2 VSS) ideal_switch
V1 (phi1 VSS) vsource type=pulse val0=0 val1=1.8 delay=0 rise=50p fall=50p width=0.8666666666666667n period=2n dc=1.8
V2 (phi2 VSS) vsource type=pulse val0=0 val1=1.8 delay=1n rise=50p fall=50p width=0.8666666666666667n period=2n dc=0
