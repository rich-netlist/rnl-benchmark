//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
//   @USE-PACKAGE(name="rnl-std-logic", version="0.4")
// }

// Ideal inverter: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
subckt inverter (A Y VDD VSS)
parameters vt=10m td=10p
BhA (hA 0) bsource v=0.5*(1+tanh((v(A,VSS)-0.5*v(VDD,VSS))/vt))
Bf (nfn VSS) bsource v=v(VDD,VSS)*(1-v(hA))
Rd (nfn ndl) resistor r=1k
Cd (ndl VSS) capacitor c=td/1000
BY (Y VSS) bsource v=v(ndl,VSS)
ends inverter

// Ideal nand-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
subckt nand_gate (A B Y VDD VSS)
parameters vt=10m td=10p
BhA (hA 0) bsource v=0.5*(1+tanh((v(A,VSS)-0.5*v(VDD,VSS))/vt))
BhB (hB 0) bsource v=0.5*(1+tanh((v(B,VSS)-0.5*v(VDD,VSS))/vt))
Bf (nfn VSS) bsource v=v(VDD,VSS)*(1-v(hA)*v(hB))
Rd (nfn ndl) resistor r=1k
Cd (ndl VSS) capacitor c=td/1000
BY (Y VSS) bsource v=v(ndl,VSS)
ends nand_gate

subckt dut (VDD VSS fclk phi1 phi1_bar phi2_bar phi2)
X1 (fclk fclk_bar VDD VSS) inverter td=10p vt=10m
X10 (net2 phi2 VDD VSS) inverter td=10p vt=10m
X11 (phi2 phi2_bar VDD VSS) inverter td=10p vt=10m
X2 (fclk phi2_bar net1 VDD VSS) nand_gate td=10p vt=10m
X3 (phi1_bar fclk_bar net0 VDD VSS) nand_gate td=10p vt=10m
X4 (net1 net4 VDD VSS) inverter td=10p vt=10m
X5 (net4 net5 VDD VSS) inverter td=10p vt=10m
X6 (net5 phi1 VDD VSS) inverter td=10p vt=10m
X7 (phi1 phi1_bar VDD VSS) inverter td=10p vt=10m
X8 (net0 net3 VDD VSS) inverter td=10p vt=10m
X9 (net3 net2 VDD VSS) inverter td=10p vt=10m
