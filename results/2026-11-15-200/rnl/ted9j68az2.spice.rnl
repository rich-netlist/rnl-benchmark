
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @DEVICE(model="sky130_fd_pr__nfet_01v8", terminals=["d", "g", "s", "b"], type="nmos")
* }
.subckt Main VDD VSS Voutn Voutp Vinp Vinn Vb
XM1 Voutn Vinp net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 Voutp Vinn net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 net0 Vb VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 VDD Voutn 1k
R2 VDD Voutp 1k
* @RNL(author="analog-canvas") {
*   $CANVAS_TYPESETTING @ATTACH #(level);
*   #XM1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(31, -16) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M1") #XM1(part);
*   #XM2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(41, -16) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M2") #XM2(part);
*   $IO_PORT @ATTACH &Voutn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(33, -12) => @ORIENT("MY") => %port1;
*   $IO_PORT @ATTACH &Voutp(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(39, -12) => @ORIENT("R0") => %port2;
*   #R1 @SET-SYMBOL $RESISTOR => @PLACE(31, -8) => @ORIENT("R0");
*   #XM3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(36, -25) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M3") #XM3(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(36, -27) => @ORIENT("R0") => %gnd1;
*   #R2 @SET-SYMBOL $RESISTOR => @PLACE(41, -8) => @ORIENT("R0");
*   $IO_PORT @ATTACH &Vinp(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(24, -16) => @ORIENT("R0") => %port3;
*   $IO_PORT @ATTACH &Vinn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(24, -20) => @ORIENT("R0") => %port4;
*   $IO_PORT @ATTACH &Vb(p) => @SET-SYMBOL $CANVAS_PORT_FILLED => @PLACE(32, -25) => @ORIENT("R0") => %port5;
*   %j1 = (36, -23);
*   %j2 = (36, -19);
*   %j3 = (31, -12);
*   %j4 = (41, -12);
*   %j5 = (31, -4);
*   %j6 = (41, -4);
*   %j7 = (29, -4);
*   %j8 = (44, -4);
*   &net0 @WIRE(mode="straight") {#XM1:3 (31, -19) %j2};
*   &net0 @WIRE(mode="straight") {%j2 (41, -19) #XM2:3};
*   &net0 @WIRE(mode="straight") {%j1 %j2};
*   &Voutn @WIRE(mode="straight") {#R1:2 %j3};
*   &Voutn @WIRE(mode="straight") {%j3 #XM1:1};
*   &Voutn @WIRE(mode="straight") {%port1::pin %j3};
*   &Voutp @WIRE(mode="straight") {#R2:2 %j4};
*   &Voutp @WIRE(mode="straight") {%j4 #XM2:1};
*   &Voutp @WIRE(mode="straight") {%port2::pin %j4};
*   &VDD @WIRE(mode="straight") {#R1:1 %j5};
*   &VDD @WIRE(mode="straight") {#R2:1 %j6};
*   &Vinp @WIRE(mode="straight") {%port3::pin #XM1:2};
*   &Vinn @WIRE(mode="straight") {%port4::pin (47, -20) (47, -16) #XM2:2};
*   &Vb @WIRE(mode="straight") {#XM3:2 %port5::pin};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j7 %j5};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j5 %j6};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j6 %j8};
*   $JUNCTION @ATTACH %j3(p) => @PLACE(31, -12) => %dot1;
*   $JUNCTION @ATTACH %j4(p) => @PLACE(41, -12) => %dot2;
*   &VSS @WIRE(mode="straight") {%gnd1::pin #XM3:3};
*   $JUNCTION @ATTACH %j5(p) => @PLACE(31, -4) => %dot3;
*   $JUNCTION @ATTACH %j6(p) => @PLACE(41, -4) => %dot4;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(36, -19) => %dot5;
*   &net0 @WIRE(mode="straight") {%j1 #XM3:1};
*   #XM1
*       @TEXT("\textbf{\textit{M}}_{\textbf{1a}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   #XM2
*       @TEXT("\textbf{\textit{M}}_{\textbf{1b}}", key="name", dx=-1, dy=-1, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   #R1
*       @TEXT("\textbf{\textit{R}}_{\textbf{1a}}", key="name", dx=-4, dy=0, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   #XM3
*       @TEXT("\textbf{\textit{M}}_{\textbf{3}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM3::name(label);
*   #R2
*       @TEXT("\textbf{\textit{R}}_{\textbf{1b}}", key="name", dx=1, dy=0, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   %port5
*       @TEXT("\textbf{\textit{V}}_{\textbf{b}}", key="netname", dx=-2, dy=0, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port5::netname(label);
*   &VDD @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", size=1.5116, bold=false) => @PLACE(45, -5) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   @LINE {(20.652332, -16.473284) (21.347668, -16.473284)} => @LAYER("top") => %polarity1_plus1;
*   @LINE {(21, -16.125616) (21, -16.820952)} => @LAYER("top") => %polarity1_plus2;
*   @LINE {(20.652332, -19.526716) (21.347668, -19.526716)} => @LAYER("top") => %polarity1_minus;
*   (21, -18) @TEXT("\textbf{\textit{V}}_{\textbf{in}}", halign="middle", valign="middle", size=1.5116, bold=true) => %polarity1;
*   $CANVAS_TYPOGRAPHY @ATTACH(token="label") %polarity1(text);
*   @LINE {(37.070213, -10.5) (37.765549, -10.5)} => @LAYER("top") => %polarity2_plus1;
*   @LINE {(37.417881, -10.152332) (37.417881, -10.847668)} => @LAYER("top") => %polarity2_plus2;
*   @LINE {(34.234451, -10.5) (34.929787, -10.5)} => @LAYER("top") => %polarity2_minus;
*   (36, -10.5) @TEXT("\textbf{\textit{V}}_{\textbf{o}}", halign="middle", valign="middle", rotate=270, size=1.5116, bold=false) =>
*       %polarity2;
*   $CANVAS_TYPOGRAPHY @ATTACH(token="label") %polarity2(text);
*   %port1 @TEXT("${p}", key="netname", textvisible=false);
*   %port2 @TEXT("${p}", key="netname", textvisible=false);
*   %port3 @TEXT("${p}", key="netname", textvisible=false);
*   %port4 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends Main
