simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
//   @DEVICE(model="sky130_fd_pr__npn_05v5_W1p00L1p00", terminals=["c", "b", "e", "s"], type="npn")
// }

subckt xfmr (p_plus p_minus s_plus s_minus)
parameters lp=1n ls=1n k=1
LP (p_plus p_minus) inductor l=lp
LS (s_plus s_minus) inductor l=ls
K1 mutual_inductor coupling=k ind1=LP ind2=LS
ends xfmr

subckt dut (\+8V VSS Audio Video RFout)
model DIODE diode is=1e-14 n=1
C1 (net3 VSS) capacitor c=10n
C10 (net19 net16) capacitor c=3p
C11 (net16 net6) capacitor c=4.7p
C12 (net6 VSS) capacitor c=10p
C13 (net11 VSS) capacitor c=1n
C14 (net2 net9) capacitor c=10p
C15 (net5 VSS) capacitor c=10n
C16 (net14 RFout) capacitor c=10p
C2 (net1 net18) capacitor c=10n
C3 (net18 VSS) capacitor c=1n
C4 (net3 net10) capacitor c=100p
C5 (net10 net0) capacitor c=10p
C6 (net4 net8) capacitor c=56p
C7 (Video net17) capacitor c=10n
C8 (net7 VSS) capacitor c=1n
C9 (net19 VSS) capacitor c=8.2p
D1 (net15 net2) DIODE
D2 (net2 net12) DIODE
L1 (net7 net13) inductor l=1n
L2 (net15 net11) inductor l=1n
L3 (net11 net12) inductor l=1n
L4 (net19 VSS) inductor l=1n
L5 (net5 net14) inductor l=1n
Q1 (net10 net18 net0 VSS) sky130_fd_pr__npn_05v5_W1p00L1p00 m=1
Q2 (net13 net16 net6 VSS) sky130_fd_pr__npn_05v5_W1p00L1p00 m=1
Q3 (net14 net9 VSS VSS) sky130_fd_pr__npn_05v5_W1p00L1p00 m=1
R1 (\+8V net3) resistor r=100
R10 (net7 net16) resistor r=6.8k
R11 (net16 VSS) resistor r=3.3k
R12 (net6 VSS) resistor r=470
R13 (net7 net11) resistor r=470
R14 (net5 net9) resistor r=4.7k
R15 (\+8V net5) resistor r=100
R2 (net3 net18) resistor r=6.8k
R3 (net18 VSS) resistor r=3.3k
R4 (Audio net1) resistor r=1k
R5 (net0 VSS) resistor r=1k
R6 (net8 net2) resistor r=100
R7 (net17 VSS) resistor r=560
R8 (net17 net2) resistor r=2.2k
R9 (\+8V net7) resistor r=100
X1 (net10 net3 VSS net4) xfmr lp=1n ls=1n k=1
TF1 mutual_inductor coupling=1 ind1=L1 ind2=L2
TF2 mutual_inductor coupling=1 ind1=L1 ind2=L3
TF3 mutual_inductor coupling=1 ind1=L2 ind2=L3
