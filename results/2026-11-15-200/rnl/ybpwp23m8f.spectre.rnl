// Ideal buffer: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
subckt buffer (A Y VDD VSS)
parameters vt=10m td=10p
BhA (hA 0) bsource v=0.5*(1+tanh((v(A,VSS)-0.5*v(VDD,VSS))/vt))
Bf (nfn VSS) bsource v=v(VDD,VSS)*(v(hA))
Rd (nfn ndl) resistor r=1k
Cd (ndl VSS) capacitor c=td/1000
BY (Y VSS) bsource v=v(ndl,VSS)
ends buffer

subckt dut (VSS Vinp EN Vcmp)
M1 (net5 net0 VDD VDD) pch l=150n m=1 nf=1 w=1u
M10 (net6 net0 net7 VDD) pch l=150n m=1 nf=1 w=1u
M11 (net5 net1 net8 VSS) nch l=150n m=1 nf=1 w=1u
M12 (net5 net1 net7 VDD) pch l=150n m=1 nf=1 w=1u
M13 (net7 net2 VDD VDD) pch l=150n m=1 nf=1 w=1u
M14 (net8 net2 net4 VSS) nch l=150n m=1 nf=1 w=1u
M15 (net8 net2 net4 VSS) nch l=150n m=1 nf=1 w=1u
M16 (net4 EN VSS VSS) nch l=150n m=1 nf=1 w=1u
M2 (net0 net0 VDD VDD) pch l=150n m=1 nf=1 w=1u
M3 (net0 Vinp net9 VSS) nch l=150n m=1 nf=1 w=1u
M4 (net5 Vinp net9 VSS) nch l=150n m=1 nf=1 w=1u
M5 (net9 net0 net3 VSS) nch l=150n m=1 nf=1 w=1u
M6 (net9 net0 net3 VSS) nch l=150n m=1 nf=1 w=1u
M7 (net3 EN VSS VSS) nch l=150n m=1 nf=1 w=1u
M8 (net6 net0 net8 VSS) nch l=150n m=1 nf=1 w=1u
X1 (net1 Vcmp VDD VSS) buffer td=10p vt=10m
