subckt dut (VDD Vss GND Vin1 Vin2 Vout Vb1 Vb2 Vb3 Vb4 Vb5 CLK1 CLK2)
Cc (net4 net12) capacitor c=Cc
M1 (N1 net2 net6 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M10 (net10 net3 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M11 (net0 Vb1 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M12 (net6 Vb2 net0 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M13 (Vout net4 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M14 (Vout Vb4 Vss Vss) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (N2 net9 net6 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (N1 Vb5 Vss Vss) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (N2 Vb5 Vss Vss) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (net3 Vb3 net5 Vss) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (net4 Vb3 net11 Vss) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M7 (net3 Vb2 net8 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M8 (net4 Vb2 net7 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M9 (net1 net3 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (net12 Vout) resistor r=R1
X1 (GND Vin1 Vin2 net2 net9 CLK1 CLK2) Chopper2Phase
X2 (GND N1 N2 net5 net11 CLK1 CLK2) Chopper2Phase
X3 (GND net8 net7 net1 net10 CLK1 CLK2) Chopper2Phase
