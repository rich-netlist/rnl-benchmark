
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @USE-PACKAGE(name="rnl-std-functional", version="0.4");
*   @USE-PACKAGE(name="rnl-std-logic", version="0.4")
* }
* Ideal and-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt and_gate A B Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
BhB hB 0 V={0.5*(1+tanh((V(B,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(V(hA)*V(hB))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends and_gate

* Ideal d-flip-flop-reset: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt d_flip_flop_reset D CK RST Q QBAR VDD VSS params: vt=10m td=10p
BhD hD 0 V={0.5*(1+tanh((V(D,VSS)-0.5*V(VDD,VSS))/vt))}
BhCK hCK 0 V={0.5*(1+tanh((V(CK,VSS)-0.5*V(VDD,VSS))/vt))}
BhRST hRST 0 V={0.5*(1+tanh((V(RST,VSS)-0.5*V(VDD,VSS))/vt))}
Bm 0 nm I={10m*((V(hD)-V(nm))*(1-V(hCK))*(1-V(hRST))-V(nm)*V(hRST))}
Cm nm 0 1p
Rm nm 0 1T
Bs 0 ns I={10m*((V(nm)-V(ns))*V(hCK)*(1-V(hRST))-V(ns)*V(hRST))}
Cs ns 0 1p
Rs ns 0 1T
Bf nfn VSS V={V(VDD,VSS)*(0.5*(1+tanh((V(ns)-0.5)/10m)))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BQ Q VSS V={V(ndl,VSS)}
BQBAR QBAR VSS V={V(VDD,VSS)-V(ndl,VSS)}
.ends d_flip_flop_reset

.subckt voltage_amplifier VIN VOUT VDD VSS params: gain=1
ECORE VOUT 0 VIN 0 {gain}
.ends voltage_amplifier

.subckt pfd_charge_pump VDD VSS ref fb vctrl
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
C1 net3 VSS 100pF
C2 vctrl VSS 10pF
IDN net0 VSS DC 50uA
IUP VDD net1 DC 50uA
R1 vctrl net3 10kΩ
S1 net1 vctrl up VSS ideal_switch
S2 vctrl net0 dn VSS ideal_switch
S3 vrep net1 upb VSS ideal_switch
S4 net0 vrep dnb VSS ideal_switch
X1 VDD ref net2 up upb VDD VSS d_flip_flop_reset td=10p vt=10m
X2 VDD fb net2 dn dnb VDD VSS d_flip_flop_reset td=10p vt=10m
X3 up dn net2 VDD VSS and_gate td=10p vt=10m
X4 vctrl vrep VDD VSS voltage_amplifier gain=1
* @RNL(author="analog-canvas") {
*   %pfd_charge_pump_SYMBOL = @DEFINE-SYMBOL(box=[-6, -5, 6, 5]) {
*     (0, 5) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (-6, 0) @PIN(terminal="ref", label="\textbf{\textit{ref}}", direction="left");
*     (-6, -2) @PIN(terminal="fb", label="\textbf{\textit{fb}}", direction="left");
*     (6, -1) @PIN(terminal="vctrl", label="\textbf{\textit{v}}_{\textbf{ctrl}}", direction="right");
*     (0, 0) @RECTANGLE(width=10, height=8);
