*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMB(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(26, -31) => @ORIENT("R0") => %gnd8;
