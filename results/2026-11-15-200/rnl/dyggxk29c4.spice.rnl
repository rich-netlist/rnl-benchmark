*   $IO_PORT @ATTACH &ibias(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(46, -6) => @ORIENT("MY") => %port3;
*   #XM3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(20, 2) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M3") #XM3(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XM3(part);
*   $IO_PORT @ATTACH &vcas(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(14, 2) => @ORIENT("R0") => %port4;
*   #XM4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(32, 2) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M4") #XM4(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XM4(part);
*   $IO_PORT @ATTACH &vcas(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(38, 2) => @ORIENT("MY") => %port5;
*   #X2 @SET-SYMBOL(terminals=[[2, "n1"], [1, "p1"], [4, "n2"], [3, "p2"]]) $TRANSFORMER => @PLACE(26, 13) => @ORIENT("R180");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(36, 12) => @ORIENT("R0") => %gnd4;
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(12, 15) => @ORIENT("R0") => %vdd1;
