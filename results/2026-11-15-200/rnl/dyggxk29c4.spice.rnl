*   &net3 @WIRE(mode="straight") {%j5 (21, -12) #C3:2};
*   &net5 @WIRE(mode="straight") {#C3:1 (31, -12) %j6};
*   &rfout @WIRE(mode="straight") {#X2:3 (18, 14) (18, 21) %j7};
