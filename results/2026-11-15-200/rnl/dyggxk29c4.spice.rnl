*   &rfout @WIRE(mode="straight") {#CS:1 %j8};
*   &VSS @WIRE(mode="straight") {#CS:2 %gnd7::pin};
*   &net0 @WIRE(mode="straight") {#LF2:2 (40, 8) %j4};
*   &ibias @WIRE(mode="straight") {%port7::pin %j9};
*   &ibias @WIRE(mode="straight") {%j9 %j10};
*   &ibias @WIRE(mode="straight") {%j10 (34, -23) #CB:1};
*   &ibias @WIRE(mode="straight") {#XMB:1 %j9};
*   &ibias @WIRE(mode="straight") {#XMB:2 (30, -27) %j10};
*   &VSS @WIRE(mode="straight") {#XMB:3 %gnd8::pin};
*   &VSS @WIRE(mode="straight") {#CB:2 %gnd9::pin};
*   $JUNCTION @ATTACH %j7(p) => @PLACE(48, 21) => %dot1;
*   $JUNCTION @ATTACH %j8(p) => @PLACE(55, 21) => %dot2;
*   $JUNCTION @ATTACH %j9(p) => @PLACE(26, -23) => %dot3;
*   $JUNCTION @ATTACH %j10(p) => @PLACE(30, -23) => %dot4;
*   &VDD @WIRE(mode="straight") {#LF2:1 %vdd2::pin};
*   &VDD @WIRE(mode="straight") {%vdd1::pin #LF1:1};
