*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(48, 13) => @ORIENT("R0") => %gnd5;
*   $IO_PORT @ATTACH &rfout(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(60, 21) => @ORIENT("MY") => %port6;
