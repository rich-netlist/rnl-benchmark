*   %j5 = (21, -13);
*   %j6 = (31, -13);
*   %j7 = (48, 21);
*   %j8 = (55, 21);
*   %j9 = (26, -23);
*   %j10 = (30, -23);
*   &rfin @WIRE(mode="straight") {%port1::pin #X1:1};
*   &VSS @WIRE(mode="straight") {#X1:2 (31, -17) %gnd1::pin};
*   &ibias @WIRE(mode="straight") {%port2::pin #Rg1:2};
*   &ibias @WIRE(mode="straight") {%port3::pin #Rg2:1};
*   &VSS @WIRE(mode="straight") {#XM1:3 %gnd2::pin};
*   &VSS @WIRE(mode="straight") {#XM2:3 %gnd3::pin};
*   &net1 @WIRE(mode="straight") {#XM1:1 #XM3:3};
*   &net2 @WIRE(mode="straight") {#XM2:1 #XM4:3};
*   &vcas @WIRE(mode="straight") {%port4::pin #XM3:2};
*   &vcas @WIRE(mode="straight") {%port5::pin #XM4:2};
*   &net4 @WIRE(mode="straight") {#XM3:1 %j3};
*   &net4 @WIRE(mode="straight") {%j3 (20, 12) #X2:1};
*   &net4 @WIRE(mode="straight") {#LF1:2 (12, 8) %j3};
*   &VSS @WIRE(mode="straight") {#X2:4 (36, 14) %gnd4::pin};
*   &VSS @WIRE(mode="straight") {#RL:2 %gnd5::pin};
*   &net0 @WIRE(mode="straight") {#X2:2 (32, 12) %j4};
*   &net0 @WIRE(mode="straight") {%j4 #XM4:1};
*   &net4 @WIRE(mode="straight") {%j3 #C1:2};
*   &VSS @WIRE(mode="straight") {#C1:1 %gnd6::pin};
*   &VSS @WIRE(mode="straight") {#C2:2 %gnd6::pin};
*   &net0 @WIRE(mode="straight") {#C2:1 %j4};
*   &net3 @WIRE(mode="straight") {#Rg1:1 %j1};
*   &net3 @WIRE(mode="straight") {%j1 #XM1:2};
*   &net3 @WIRE(mode="straight") {%j1 (15, -13) %j5};
*   &net3 @WIRE(mode="straight") {%j5 (21, -15) #X1:3};
*   &net5 @WIRE(mode="straight") {#X1:4 (31, -15) %j6};
