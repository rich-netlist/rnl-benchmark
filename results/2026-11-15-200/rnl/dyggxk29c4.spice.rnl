
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @DEVICE(model="sky130_fd_pr__nfet_01v8", terminals=["d", "g", "s", "b"], type="nmos")
* }
.subckt xfmr p_plus p_minus s_plus s_minus params: lp=1n ls=1n k=1
LP p_plus p_minus {lp}
LS s_plus s_minus {ls}
K1 LP LS {k}
.ends xfmr

.subckt class_ab_pa VDD VSS rfin ibias vcas rfout
C1 VSS net4 3.2pF
C2 net0 VSS 3.2pF
C3 net5 net3 0.5pF
CB ibias VSS 10pF
CS rfout VSS 1.75pF
LF1 VDD net4 3nH
LF2 VDD net0 3nH
XM1 net1 net3 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=400 nf=80 m=1
XM2 net2 net5 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=400 nf=80 m=1
XM3 net4 vcas net1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=400 nf=80 m=1
XM4 net0 vcas net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=400 nf=80 m=1
XMB ibias ibias VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=2 m=1
Rg1 net3 ibias 600Ω
Rg2 ibias net5 600Ω
RL rfout VSS 50Ω
X1 rfin VSS net3 net5 xfmr lp=0.9n ls=6n k=0.8
X2 net4 net0 rfout VSS xfmr lp=2.4n ls=1.6n k=0.8
* @RNL(author="analog-canvas") {
*   %class_ab_pa_SYMBOL = @DEFINE-SYMBOL(box=[-7, -6, 7, 6]) {
*     (-7, -3) @PIN(terminal="rfin", label="\textbf{\textit{rfin}}", direction="left");
*     (-7, -1) @PIN(terminal="ibias", label="\textbf{\textit{i}}_{\textbf{bias}}", direction="left");
*     (-7, 1) @PIN(terminal="vcas", label="\textbf{\textit{v}}_{\textbf{cas}}", direction="left");
*     (0, 6) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (7, -1) @PIN(terminal="rfout", label="\textbf{\textit{rfout}}", direction="right");
*     (0, 0) @RECTANGLE(width=12, height=10);
*     @LINE {(-7, -3) (-6, -3)};
*     @LINE {(-7, -1) (-6, -1)};
*     @LINE {(-7, 1) (-6, 1)};
*     @LINE {(0, 6) (0, 5)};
*     @LINE {(7, -1) (6, -1)}
*   };
*   # @SET-SYMBOL %class_ab_pa_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #X1 @SET-SYMBOL(terminals=[[2, "n1"], [1, "p1"], [4, "n2"], [3, "p2"]]) $TRANSFORMER => @PLACE(26, -16) => @ORIENT("R180");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(31, -19) => @ORIENT("R0") => %gnd1;
*   $IO_PORT @ATTACH &rfin(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(18, -17) => @ORIENT("R0") => %port1;
*   #XM1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(20, -6) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M1") #XM1(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XM1(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(20, -10) => @ORIENT("R0") => %gnd2;
*   #XM2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(32, -6) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M2") #XM2(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XM2(part);
