
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @DEVICE(model="sky130_fd_pr__nfet_01v8", terminals=["d", "g", "s", "b"], type="nmos");
*   @DEVICE(model="sky130_fd_pr__pfet_01v8", terminals=["d", "g", "s", "b"], type="pmos")
* }
.subckt dut VDD VSS IN LO LO_bar IF+ IF-
C1 VSS net0 1p
C2 VSS net1 1p
C3 net2 IN 1p
C4 net3 VSS 1p
L1 net2 net3 1n
XM1 net0 LO net3 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMN2 net1 LO_bar net3 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMN3 IF+ net0 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMN4 IF- net1 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMP1 IF+ net0 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1 m=1
XMP2 IF- net1 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1 m=1
R1 IF- net1 1k
R2 IF+ net0 1k
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-7, -6, 7, 6]) {
*     (-7, -1) @PIN(terminal="IN", label="\textbf{\textit{IN}}", direction="left");
*     (-7, 1) @PIN(terminal="LO", label="\textbf{\textit{LO}}", direction="left");
*     (-7, -3) @PIN(terminal="LO_bar", label="\overline{\textbf{\textit{LO}}}", direction="left");
*     (0, 6) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (7, 0) @PIN(terminal="IF+", label="\textbf{\textit{IF+}}", direction="right");
*     (7, -2) @PIN(terminal="IF-", label="\textbf{\textit{IF-}}", direction="right");
*     (0, 0) @RECTANGLE(width=12, height=10);
*     @LINE {(-7, -1) (-6, -1)};
*     @LINE {(-7, 1) (-6, 1)};
*     @LINE {(-7, -3) (-6, -3)};
*     @LINE {(0, 6) (0, 5)};
*     @LINE {(7, 0) (6, 0)};
*     @LINE {(7, -2) (6, -2)}
*   };
*   # @SET-SYMBOL %dut_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XM1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(39, -15) => @ORIENT("R270");
*   $CANVAS_NAME @ATTACH(name="M1") #XM1(part);
*   #XMN2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(39, -23) => @ORIENT("MXR90");
*   $CANVAS_NAME @ATTACH(name="MN2") #XMN2(part);
*   $IO_PORT @ATTACH &IN(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(20, -19) => @ORIENT("R0") => %port1;
*   #C1 @SET-SYMBOL $CAPACITOR => @PLACE(45, -13) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(45, -11) => @ORIENT("R180") => %gnd1;
*   #C2 @SET-SYMBOL $CAPACITOR => @PLACE(45, -25) => @ORIENT("MX");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(45, -27) => @ORIENT("MY") => %gnd2;
*   $IO_PORT @ATTACH &LO(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(39, -12) => @ORIENT("R270") => %port2;
*   $IO_PORT @ATTACH &LO_bar(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(39, -26) => @ORIENT("R90") => %port3;
*   #XMP1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(63, -3) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP1") #XMP1(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMP1(part);
*   #XMN3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(63, -11) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MN3") #XMN3(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMN3(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(63, -14) => @ORIENT("R0") => %gnd3;
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(63, 0) => @ORIENT("R0") => %vdd1;
*   #XMP2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(63, -35) => @ORIENT("MX");
*   $CANVAS_NAME @ATTACH(name="MP2") #XMP2(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMP2(part);
*   #XMN4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(63, -27) => @ORIENT("MX");
*   $CANVAS_NAME @ATTACH(name="MN4") #XMN4(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMN4(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(63, -24) => @ORIENT("MX") => %gnd4;
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(63, -38) => @ORIENT("MX") => %vdd2;
*   #R1 @SET-SYMBOL $RESISTOR => @PLACE(59, -31) => @ORIENT("MXR90");
*   #R2 @SET-SYMBOL $RESISTOR => @PLACE(59, -7) => @ORIENT("R270");
*   #L1 @SET-SYMBOL $INDUCTOR => @PLACE(28, -19) => @ORIENT("R90");
*   #C3 @SET-SYMBOL $CAPACITOR => @PLACE(23, -19) => @ORIENT("R270");
*   #C4 @SET-SYMBOL $CAPACITOR => @PLACE(32, -23) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(32, -27) => @ORIENT("MY") => %gnd5;
*   $IO_PORT @ATTACH &"IF+"(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(69, -7) => @ORIENT("R180") => %port4;
*   $IO_PORT @ATTACH &"IF-"(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(69, -31) => @ORIENT("R180") => %port5;
*   %j1 = (36, -19);
*   %j2 = (63, 0);
*   %j3 = (63, -38);
*   %j4 = (55, -7);
*   %j5 = (55, -31);
*   %j6 = (63, -31);
*   %j7 = (63, -7);
*   %j8 = (32, -19);
*   %j9 = (69, -31);
*   %j10 = (69, -7);
*   &VDD @WIRE(mode="straight") {#XMP1:3 %j2};
*   &VSS @WIRE(mode="straight") {#XMN3:3 %gnd3::pin};
*   &"IF+" @WIRE(mode="straight") {#XMP1:1 %j7};
*   &"IF+" @WIRE(mode="straight") {%j7 #XMN3:1};
*   &VDD @WIRE(mode="straight") {#XMP2:3 %j3};
*   &VSS @WIRE(mode="straight") {#XMN4:3 %gnd4::pin};
*   &"IF-" @WIRE(mode="straight") {#XMP2:1 %j6};
*   &"IF-" @WIRE(mode="straight") {%j6 #XMN4:1};
*   &net0 @WIRE(mode="straight") {#XM1:1 #C1:2};
*   &net0 @WIRE(mode="straight") {#C1:2 (50, -15) (50, -7) %j4};
*   &net0 @WIRE(mode="straight") {%j4 (55, -11) #XMN3:2};
*   &net0 @WIRE(mode="straight") {%j4 (55, -3) #XMP1:2};
*   &net1 @WIRE(mode="straight") {#XMN2:1 #C2:2};
*   &net1 @WIRE(mode="straight") {#C2:2 (50, -23) (50, -31) %j5};
*   &net1 @WIRE(mode="straight") {%j5 (55, -35) #XMP2:2};
*   &net1 @WIRE(mode="straight") {%j5 (55, -27) #XMN4:2};
*   &net1 @WIRE(mode="straight") {#R1:2 %j5};
*   &"IF-" @WIRE(mode="straight") {#R1:1 %j6};
*   &net0 @WIRE(mode="straight") {#R2:2 %j4};
*   &"IF+" @WIRE(mode="straight") {#R2:1 %j7};
*   &net3 @WIRE(mode="straight") {#L1:2 %j8};
*   &net3 @WIRE(mode="straight") {%j8 #C4:1};
*   &net3 @WIRE(mode="straight") {%j8 %j1};
*   &net3 @WIRE(mode="straight") {%j1 (36, -15) #XM1:3};
*   &net3 @WIRE(mode="straight") {%j1 (36, -23) #XMN2:3};
*   &IN @WIRE(mode="straight") {#C3:2 %port1::pin};
*   &VSS @WIRE(mode="straight") {%gnd5::pin #C4:2};
*   &net2 @WIRE(mode="straight") {#C3:1 #L1:1};
*   &"IF-" @WIRE(mode="straight") {%j6 %j9};
*   &"IF+" @WIRE(mode="straight") {%j7 %j10};
*   $JUNCTION @ATTACH (45, -15)(p) => @PLACE(45, -15) => %dot1;
*   $JUNCTION @ATTACH %j4(p) => @PLACE(55, -7) => %dot2;
*   $JUNCTION @ATTACH (45, -23)(p) => @PLACE(45, -23) => %dot3;
*   $JUNCTION @ATTACH %j5(p) => @PLACE(55, -31) => %dot4;
*   &VDD @WIRE(mode="straight") {%j2 %vdd1::pin};
*   &VDD @WIRE(mode="straight") {%j3 %vdd2::pin};
*   $JUNCTION @ATTACH %j8(p) => @PLACE(32, -19) => %dot5;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(36, -19) => %dot6;
*   &VSS @WIRE(mode="straight") {#C1:1 %gnd1::pin};
*   &VSS @WIRE(mode="straight") {#C2:1 %gnd2::pin};
*   &LO @WIRE(mode="straight") {#XM1:2 %port2::pin};
*   &LO_bar @WIRE(mode="straight") {#XMN2:2 %port3::pin};
*   $JUNCTION @ATTACH %j7(p) => @PLACE(63, -7) => %dot7;
*   &"IF+" @WIRE(mode="straight") {%j10 %port4::pin};
*   $JUNCTION @ATTACH %j6(p) => @PLACE(63, -31) => %dot8;
*   &"IF-" @WIRE(mode="straight") {%j9 %port5::pin};
*   #XM1
*       @TEXT("\textbf{\textit{M}}_{\textbf{N1}}", key="name", dx=0, dy=-1.5, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   #XMN2
*       @TEXT("\textbf{\textit{M}}_{\textbf{N2}}", key="name", dx=0, dy=1, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN2::name(label);
*   %port1
*       @TEXT("\textbf{\textit{IN}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{LO}}", key="netname", dx=0, dy=2.4, halign="middle", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %port3
*       @TEXT("\overline{\textbf{\textit{LO}}}", key="netname", dx=0, dy=-3, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
*   #XMP1
*       @TEXT("\textbf{\textit{M}}_{\textbf{P1}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMP1::name(label);
*   #XMP1
*       @TEXT("\frac{\textbf{2u}}{\textbf{0.15u}}", key="value", dx=0.4, dy=-3.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=false);
*   $CANVAS_LABEL @ATTACH(bind="value") #XMP1::value(label);
*   #XMN3
*       @TEXT("\textbf{\textit{M}}_{\textbf{N3}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN3::name(label);
*   #XMN3
*       @TEXT("\frac{\textbf{1u}}{\textbf{0.15u}}", key="value", dx=0.5, dy=-3.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=false);
*   $CANVAS_LABEL @ATTACH(bind="value") #XMN3::value(label);
*   %vdd1 @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", dx=2, dy=1, size=1.5116, bold=false) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   #XMP2
*       @TEXT("\textbf{\textit{M}}_{\textbf{P2}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMP2::name(label);
*   #XMP2
*       @TEXT("\frac{\textbf{2u}}{\textbf{0.15u}}", key="value", dx=0.4, dy=-3.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=false);
*   $CANVAS_LABEL @ATTACH(bind="value") #XMP2::value(label);
*   #XMN4
*       @TEXT("\textbf{\textit{M}}_{\textbf{N4}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN4::name(label);
*   #XMN4
*       @TEXT("\frac{\textbf{1u}}{\textbf{0.15u}}", key="value", dx=0.5, dy=-3.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=false);
*   $CANVAS_LABEL @ATTACH(bind="value") #XMN4::value(label);
*   %vdd2 @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", dx=2, dy=-1.6, size=1.5116, bold=false) => %power2;
*   $CANVAS_LABEL @ATTACH(bind="port") %power2(label);
*   #R1
*       @TEXT("\textbf{\textit{R}}_{\textbf{1}}", key="name", dx=0, dy=1.4, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #R1::name(label);
*   #R2
*       @TEXT("\textbf{\textit{R}}_{\textbf{2}}", key="name", dx=0, dy=-2, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #R2::name(label);
*   #L1
*       @TEXT("\textbf{\textit{L}}_{\textbf{1}}", key="name", dx=0, dy=1.7, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #L1::name(label);
*   #C3
*       @TEXT("\textbf{\textit{C}}_{\textbf{1}}", key="name", dx=0, dy=-2.3, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   #C4
*       @TEXT("\textbf{\textit{C}}_{\textbf{2}}", key="name", dx=1.2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   %port4
*       @TEXT("\textbf{\textit{IF+}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::netname(label);
*   %port5
*       @TEXT("\textbf{\textit{IF-}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port5::netname(label);
*   %vdd1 @TEXT("${p}", key="netname", textvisible=false);
*   %vdd2 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends dut
