
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @DEVICE(model="sg13_lv_nmos", terminals=["d", "g", "s", "b"], type="nmos");
*   @DEVICE(model="sg13_lv_pmos", terminals=["d", "g", "s", "b"], type="pmos")
* }
.subckt dut VDD VSS
C1 net0 net1 1p
C2 net1 net0 1p
L1 net3 VSS 1n
L2 net1 net0 1n
L3 net0 net1 1n
L4 VDD net2 1n
XM1 net1 net0 net3 VSS sg13_lv_nmos w=1u l=150n ng=1 m=1
XM2 net0 net1 net3 VSS sg13_lv_nmos w=1u l=150n ng=1 m=1
XM3 net0 net1 net2 VDD sg13_lv_pmos w=1u l=150n ng=1 m=1
XM4 net1 net0 net2 VDD sg13_lv_pmos w=1u l=150n ng=1 m=1
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-5, -3, 5, 3]) {
*     (0, 3) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (0, 0) @RECTANGLE(width=8, height=4);
*     @LINE {(0, 3) (0, 2)}
*   };
*   # @SET-SYMBOL %dut_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XM1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(18, 6) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M1") #XM1(part);
*   #XM2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(38, 6) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M2") #XM2(part);
*   #L1 @SET-SYMBOL $INDUCTOR => @PLACE(28, 2) => @ORIENT("R0");
*   #L2 @SET-SYMBOL $INDUCTOR => @PLACE(14, -5) => @ORIENT("MY");
*   #L3 @SET-SYMBOL $INDUCTOR => @PLACE(42, -5) => @ORIENT("R0");
*   #L4 @SET-SYMBOL $INDUCTOR => @PLACE(28, -14) => @ORIENT("R0");
*   #XM3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(18, -18) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M3") #XM3(part);
*   #XM4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(38, -18) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M4") #XM4(part);
*   #C1 @SET-SYMBOL $CAPACITOR => @PLACE(28, 12) => @ORIENT("R270");
*   #C2 @SET-SYMBOL $CAPACITOR => @PLACE(28, -24) => @ORIENT("R270");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(28, 0) => @ORIENT("R0") => %gnd1;
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(28, -12) => @ORIENT("R0") => %vdd1;
*   %j1 = (38, 8);
*   %j2 = (18, 10);
*   %j3 = (38, 10);
*   %j4 = (14, 10);
*   %j5 = (14, -1);
*   %j6 = (42, 10);
*   %j7 = (42, -1);
*   %j8 = (42, -9);
*   %j9 = (14, -9);
*   %j10 = (18, -22);
*   %j11 = (14, -22);
*   %j12 = (38, -22);
*   %j13 = (42, -22);
*   &net3 @WIRE(mode="straight") {#XM1:3 #L1:1 #XM2:3};
*   &net0 @WIRE(mode="straight") {#XM1:2 (26, 6) (30, 10) %j3};
*   &net0 @WIRE(mode="straight") {#C1:1 (42, 12) %j6};
*   &net0 @WIRE(mode="straight") {%j6 %j3};
*   &net0 @WIRE(mode="straight") {%j3 %j1};
*   &net0 @WIRE(mode="straight") {%j6 %j7};
*   &net0 @WIRE(mode="straight") {%j7 #L3:1};
*   &net0 @WIRE(mode="straight") {%j7 (32, -1) (24, -9) %j9};
*   &net0 @WIRE(mode="straight") {%j9 #L2:2};
*   &net2 @WIRE(mode="straight") {#XM3:3 #L4:2};
*   &net2 @WIRE(mode="straight") {#L4:2 #XM4:3};
*   &net0 @WIRE(mode="straight") {#XM3:1 %j10};
*   &net0 @WIRE(mode="straight") {%j10 (26, -22) (30, -18) #XM4:2};
*   &net0 @WIRE(mode="straight") {%j9 %j11};
*   &net0 @WIRE(mode="straight") {%j11 (14, -24) #C2:2};
*   &net0 @WIRE(mode="straight") {%j10 %j11};
*   &net1 @WIRE(mode="straight") {%j4 %j5};
*   &net1 @WIRE(mode="straight") {%j4 %j2};
*   &net1 @WIRE(mode="straight") {%j4 (14, 12) #C1:2};
*   &net1 @WIRE(mode="straight") {%j5 #L2:1};
*   &net1 @WIRE(mode="straight") {%j5 (24, -1) (32, -9) %j8};
*   &net1 @WIRE(mode="straight") {%j2 #XM1:1};
*   &net1 @WIRE(mode="straight") {%j2 (26, 10) (30, 6) #XM2:2};
*   &net1 @WIRE(mode="straight") {#XM3:2 (26, -18) (30, -22) %j12};
*   &net1 @WIRE(mode="straight") {#C2:1 (42, -24) %j13};
*   &net1 @WIRE(mode="straight") {#XM4:1 %j12};
*   &net1 @WIRE(mode="straight") {%j12 %j13};
*   &net1 @WIRE(mode="straight") {%j13 %j8};
*   &net1 @WIRE(mode="straight") {#L3:2 %j8};
*   $JUNCTION @ATTACH %j9(p) => @PLACE(14, -9) => %dot1;
*   $JUNCTION @ATTACH %j11(p) => @PLACE(14, -22) => %dot2;
*   $JUNCTION @ATTACH %j10(p) => @PLACE(18, -22) => %dot3;
*   $JUNCTION @ATTACH %j3(p) => @PLACE(38, 10) => %dot4;
*   &net0 @WIRE(mode="straight") {%j1 #XM2:1};
*   $JUNCTION @ATTACH %j6(p) => @PLACE(42, 10) => %dot5;
*   $JUNCTION @ATTACH %j7(p) => @PLACE(42, -1) => %dot6;
*   &VSS @WIRE(mode="straight") {%gnd1::pin #L1:2};
*   &VDD @WIRE(mode="straight") {#L4:1 %vdd1::pin};
*   $JUNCTION @ATTACH %j4(p) => @PLACE(14, 10) => %dot7;
*   $JUNCTION @ATTACH %j5(p) => @PLACE(14, -1) => %dot8;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(18, 10) => %dot9;
*   $JUNCTION @ATTACH %j12(p) => @PLACE(38, -22) => %dot10;
*   $JUNCTION @ATTACH %j8(p) => @PLACE(42, -9) => %dot11;
*   $JUNCTION @ATTACH %j13(p) => @PLACE(42, -22) => %dot12;
*   $JUNCTION @ATTACH (28, -16)(p) => @PLACE(28, -16) => %dot13;
*   $JUNCTION @ATTACH (28, 4)(p) => @PLACE(28, 4) => %dot14;
*   #XM1
*       @TEXT("\textbf{\textit{M}}_{\textbf{1}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM1::name(label);
*   #XM2
*       @TEXT("\textbf{\textit{M}}_{\textbf{2}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM2::name(label);
*   #L1
*       @TEXT("\textbf{\textit{L}}_{\textbf{1}}", key="name", dx=1.2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #L1::name(label);
*   #L2
*       @TEXT("\textbf{\textit{L}}_{\textbf{2}}", key="name", dx=-1.2, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #L2::name(label);
*   #L3
*       @TEXT("\textbf{\textit{L}}_{\textbf{3}}", key="name", dx=1.2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #L3::name(label);
*   #L4
*       @TEXT("\textbf{\textit{L}}_{\textbf{4}}", key="name", dx=1.2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #L4::name(label);
*   #XM3
*       @TEXT("\textbf{\textit{M}}_{\textbf{3}}", key="name", dx=-0.4, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM3::name(label);
*   #XM4
*       @TEXT("\textbf{\textit{M}}_{\textbf{4}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM4::name(label);
*   #C1
*       @TEXT("\textbf{\textit{C}}_{\textbf{1}}", key="name", dx=0, dy=1.5, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #C1::name(label);
*   #C2
*       @TEXT("\textbf{\textit{C}}_{\textbf{2}}", key="name", dx=0, dy=-2.3, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #C2::name(label);
*   %vdd1 @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", dx=2, dy=1, size=1.5116, bold=false) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   %vdd1 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends dut
