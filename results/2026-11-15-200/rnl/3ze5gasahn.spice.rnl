
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @DEVICE(model="sky130_fd_pr__npn_05v5_W1p00L1p00", terminals=["c", "b", "e", "s"], type="npn")
* }
.subckt icm_opamp_vdd_vss VIP VIN VDD VSS VOUT params: gain=1e6
Blin nlin 0 V={gain*(V(VIP)-V(VIN))}
Bcore VOUT 0 V={0.5*(V(VDD)+(0.5*(V(VSS)+V(nlin)+sqrt((V(nlin)-V(VSS))*(V(nlin)-V(VSS))+(1e-4*(V(VDD)-V(VSS)))*(1e-4*(V(VDD)-V(VSS)))+1e-12)))-sqrt((V(VDD)-(0.5*(V(VSS)+V(nlin)+sqrt((V(nlin)-V(VSS))*(V(nlin)-V(VSS))+(1e-4*(V(VDD)-V(VSS)))*(1e-4*(V(VDD)-V(VSS)))+1e-12))))*(V(VDD)-(0.5*(V(VSS)+V(nlin)+sqrt((V(nlin)-V(VSS))*(V(nlin)-V(VSS))+(1e-4*(V(VDD)-V(VSS)))*(1e-4*(V(VDD)-V(VSS)))+1e-12))))+(1e-4*(V(VDD)-V(VSS)))*(1e-4*(V(VDD)-V(VSS)))+1e-12))}
.ends icm_opamp_vdd_vss

.subckt dut VDD VSS VOUT params: P_M6_w={20u} P_M6_l={1u} P_M2_w={20u} P_M2_l={1u} P_M7_w={20u}
+ P_M7_l={1u} P_M3_w={20u} P_M3_l={1u} P_IF_dc={10u} P_VN_dc={1.5}
XQ1 net1 VOUT net3 VSS sky130_fd_pr__npn_05v5_W1p00L1p00 m=1
XQ2 net2 VOUT net4 VSS sky130_fd_pr__npn_05v5_W1p00L1p00 m=1
R1 net3 net4 1k
R2 net4 VSS 1k
R3 VDD net2 1k
R4 VDD net1 1k
X1 net2 net1 VDD VSS VOUT icm_opamp_vdd_vss gain=1e6
