parameters P_Mcsc_w=10u P_Mcsc_l=1u P_Morg_w=10u P_Morg_l=1u P_Moc_w=10u P_Moc_l=1u P_M0i_w=10u P_M0i_l=1u P_M0_w=10u P_M0_l=1u P_M1i_w=10u P_M1i_l=1u P_M1_w=10u P_M1_l=1u P_Mni_w=10u P_Mni_l=1u P_Mn_w=10u P_Mn_l=1u P_Icsc_dc=20u P_Iorg_dc=20u P_C0_value=10p
C0 (VDD net0) capacitor c=P_C0_value
Icsc (net0 VSS) isource dc=P_Icsc_dc
Iorg (net1 VSS) isource dc=P_Iorg_dc
M0 (I0 net0 net2 net2) IV_SKY_P_SI L=P_M0_l W=P_M0_w
M0i (net2 net1 VDD VDD) IV_SKY_P_SI L=P_M0i_l W=P_M0i_w
M1 (I1 net0 net3 net3) IV_SKY_P_SI L=P_M1_l W=P_M1_w
M1i (net3 net1 VDD VDD) IV_SKY_P_SI L=P_M1i_l W=P_M1i_w
Mcsc (net0 net0 VDD VDD) IV_SKY_P_SI L=P_Mcsc_l W=P_Mcsc_w
MN (IN net0 net4 net4) IV_SKY_P_SI L=P_Mn_l W=P_Mn_w
Mni (net4 net1 VDD VDD) IV_SKY_P_SI L=P_Mni_l W=P_Mni_w
Moc (net1 net0 net5 net5) IV_SKY_P_SI L=P_Moc_l W=P_Moc_w
Morg (net5 net1 VDD VDD) IV_SKY_P_SI L=P_Morg_l W=P_Morg_w
