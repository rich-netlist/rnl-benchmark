*   &net1 @WIRE(mode="straight") {#S4:1 %j4};
*   &VSS @WIRE(mode="straight") {#S4:2 %gnd5::pin};
*   &VSS @WIRE(mode="straight") {%gnd6::pin %j5};
*   &VSS @WIRE(mode="straight") {%j5 #C2:2};
*   &net7 @WIRE(mode="straight") {#C2:1 %j6};
*   &net7 @WIRE(mode="straight") {%j6 #L2:1};
*   &VSS @WIRE(mode="straight") {#I2:2 (34, -44) %j5};
*   &net7 @WIRE(mode="straight") {#I2:1 (34, -36) %j6};
*   &net4 @WIRE(mode="straight") {#V2:1 (-5, -36) %j11};
*   &VSS @WIRE(mode="straight") {%gnd8::pin #V2:2};
*   &net2 @WIRE(mode="straight") {#S5:2 %j7};
*   &net2 @WIRE(mode="straight") {%j7 #L3:2};
*   &net2 @WIRE(mode="straight") {%j13 %j7};
*   &VSS @WIRE(mode="straight") {%j12 %gnd9::pin};
*   &VSS @WIRE(mode="straight") {%gnd10::pin %j8};
*   &VSS @WIRE(mode="straight") {%j8 #C3:2};
*   &net8 @WIRE(mode="straight") {#C3:1 %j9};
*   &net8 @WIRE(mode="straight") {%j9 #L3:1};
*   &VSS @WIRE(mode="straight") {#I3:2 (34, -69) %j8};
