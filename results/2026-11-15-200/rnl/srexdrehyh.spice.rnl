*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(7, -73) => @ORIENT("R0") => %gnd11;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(-5, -73) => @ORIENT("R0") => %gnd12;
*   #S3 @SET-SYMBOL $CLOSED_SWITCH => @PLACE(1, -36) => @ORIENT("R0");
