*   $CANVAS_PARAMETER @ATTACH(name="waveform", text="dc") #V1(part);
*   $CANVAS_PARAMETER @ATTACH(name="width", text="5ns") #V1(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(7, -22) => @ORIENT("R0") => %gnd3;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(-5, -22) => @ORIENT("R0") => %gnd4;
*   #S4 @SET-SYMBOL $SWITCH => @PLACE(7, -41) => @ORIENT("R270");
