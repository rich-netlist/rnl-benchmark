
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt dut VSS S1 S2 S3 S4 S5 S6
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
C1 net6 VSS 1p
C2 net7 VSS 1p
C3 net8 VSS 1p
I1 net6 VSS DC 100u
I2 net7 VSS DC 100u
I3 net8 VSS DC 100u
L1 net6 net0 1n
L2 net7 net1 1n
L3 net8 net2 1n
S1 net3 net0 S1 VSS ideal_switch
S2 net0 VSS S2 VSS ideal_switch
S3 net4 net1 S3 VSS ideal_switch
S4 net1 VSS S4 VSS ideal_switch
S5 net5 net2 S5 VSS ideal_switch
S6 net2 VSS S6 VSS ideal_switch
V1 net3 VSS DC 1.8
V2 net4 VSS DC 1.8
V3 net5 VSS DC 1.8
* @RNL(author="analog-canvas") {
*   $CANVAS_TYPESETTING @ATTACH #(level);
*   #S1 @SET-SYMBOL $SWITCH => @PLACE(1, -10) => @ORIENT("R0");
*   #S2 @SET-SYMBOL $SWITCH => @PLACE(7, -15) => @ORIENT("R270");
*   #L1 @SET-SYMBOL $CANVAS_INDUCTOR_LARGE => @PLACE(17, -10) => @ORIENT("R270");
*   #C1 @SET-SYMBOL $CAPACITOR => @PLACE(25, -15) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(7, -22) => @ORIENT("R0") => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(25, -22) => @ORIENT("R0") => %gnd2;
*   #I1 @SET-SYMBOL $CURRENT_SOURCE => @PLACE(34, -15) => @ORIENT("R0");
*   $CANVAS_PARAMETER @ATTACH(name="amplitude", text="1m") #I1(part);
