subckt dut (VDD VSS CLK Vin\- Vin\+ Vout\+ Vout\-)
M1 (Di\+ Vin\- net2 VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M10 (Vout\- Vout\+ net0 VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M11 (Vout\+ Vout\- net1 VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M12 (net0 Di\+ VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M13 (net1 Di\- VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M14 (net0 Di\+ VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M15 (net1 Di\- VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M2 (Di\- Vin\+ net2 VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M3 (Di\+ CLK VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M4 (Di\- CLK VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M5 (net2 CLK VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M6 (Vout\- Vout\+ VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M7 (Vout\+ Vout\- VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M8 (Vout\- Di\+ VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M9 (Vout\+ Di\- VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
