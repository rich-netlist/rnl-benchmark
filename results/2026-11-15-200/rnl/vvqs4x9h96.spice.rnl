* @RNL(author="analog-canvas") {
*   %Chopper2Phase_SYMBOL = @DEFINE-SYMBOL(box=[-2.4, -6.4, 2.4, 5.4]) {
*     (-2, 4) @PIN(terminal="INP", direction="left");
*     (-2, -4) @PIN(terminal="INN", direction="left");
*     (2, 4) @PIN(terminal="OUTP", direction="right");
*     (2, -4) @PIN(terminal="OUTN", direction="right");
*     (-1, -6) @PIN(terminal="CLK1", direction="down");
*     (1, -6) @PIN(terminal="CLK2", direction="down");
*     @LINE {(-2, 5) (2, 5) (2, -5) (-2, -5) (-2, 5)};
*     @LINE {(-2, 5) (2, -5)};
*     @LINE {(-2, -5) (2, 5)};
*     @LINE {(-1, -5) (-1, -6)};
*     @LINE {(1, -5) (1, -6)}
*   };
*   # @SET-SYMBOL %Chopper2Phase_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #S1 @SET-SYMBOL $EXTERNALLY_CONTROLLED_SWITCH => @PLACE(14, -10) => @ORIENT("R0");
*   #S2 @SET-SYMBOL $EXTERNALLY_CONTROLLED_SWITCH => @PLACE(14, -24) => @ORIENT("R0");
*   #S3 @SET-SYMBOL $EXTERNALLY_CONTROLLED_SWITCH => @PLACE(34, -10) => @ORIENT("R0");
*   #S4 @SET-SYMBOL $EXTERNALLY_CONTROLLED_SWITCH => @PLACE(34, -24) => @ORIENT("R0");
*   $IO_PORT @ATTACH &INP(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(0, -6) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &INN(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(0, -20) => @ORIENT("R0") => %port2;
*   $IO_PORT @ATTACH &OUTP(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(48, -6) => @ORIENT("MY") => %port3;
*   $IO_PORT @ATTACH &OUTN(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(48, -20) => @ORIENT("MY") => %port4;
*   $IO_PORT @ATTACH &CLK1(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(6, -10) => @ORIENT("R0") => %port5;
*   $IO_PORT @ATTACH &CLK2(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(26, -10) => @ORIENT("R0") => %port6;
*   %j1 = (34, -6);
*   %j2 = (34, -14);
*   %j3 = (34, -20);
*   %j4 = (34, -28);
*   %j5 = (8, -24);
*   %j6 = (28, -24);
*   &INP @WIRE(mode="straight") {%port1::pin (14, -6) #S1:1};
*   &INN @WIRE(mode="straight") {%port2::pin (14, -20) #S2:1};
*   &OUTP @WIRE(mode="straight") {#S1:2 (14, -14) (20, -14) (20, -2) (46, -2) (46, -6) %port3::pin};
*   &OUTN @WIRE(mode="straight") {#S2:2 (14, -28) (20, -28) (20, -32) (46, -32) (46, -20) %port4::pin};
*   &CLK1 @WIRE(mode="straight") {%port5::pin #S1:3};
*   &CLK2 @WIRE(mode="straight") {%port6::pin #S3:3};
*   &INP @WIRE(mode="straight") {#S3:1 %j1} => %wire1;
*   &OUTN @WIRE(mode="straight") {#S3:2 %j2} => %wire2;
*   &INN @WIRE(mode="straight") {#S4:1 %j3} => %wire3;
*   &OUTP @WIRE(mode="straight") {#S4:2 %j4} => %wire4;
*   &CLK1 @WIRE(mode="straight") {#S2:3 %j5} => %wire5;
*   &CLK2 @WIRE(mode="straight") {#S4:3 %j6} => %wire6;
*   #S1
*       @TEXT("\textbf{\textit{S}}_{\textbf{1}}", key="name", dx=3, dy=0, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #S1::name(label);
*   #S2
*       @TEXT("\textbf{\textit{S}}_{\textbf{2}}", key="name", dx=3, dy=0, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #S2::name(label);
*   #S3
*       @TEXT("\textbf{\textit{S}}_{\textbf{3}}", key="name", dx=3, dy=0, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #S3::name(label);
*   #S4
*       @TEXT("\textbf{\textit{S}}_{\textbf{4}}", key="name", dx=3, dy=0, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #S4::name(label);
*   %port1
*       @TEXT("\textbf{\textit{INP}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{INN}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %port3
*       @TEXT("\textbf{\textit{OUTP}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
*   %port4
*       @TEXT("\textbf{\textit{OUTN}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::netname(label);
*   %port5
*       @TEXT("\textbf{\textit{CLK1}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port5::netname(label);
*   %port6
*       @TEXT("\textbf{\textit{CLK2}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port6::netname(label);
*   %wire1 @TEXT("\textbf{\textit{INP}}", size=1.5116, bold=false) => @PLACE(34.8, -6) => %label1;
*   $CANVAS_LABEL @ATTACH(bind="net") %label1(label);
*   %wire2 @TEXT("\textbf{\textit{OUTN}}", size=1.5116, bold=false) => @PLACE(34.8, -14) => %label2;
*   $CANVAS_LABEL @ATTACH(bind="net") %label2(label);
*   %wire3 @TEXT("\textbf{\textit{INN}}", size=1.5116, bold=false) => @PLACE(34.8, -20) => %label3;
*   $CANVAS_LABEL @ATTACH(bind="net") %label3(label);
*   %wire4 @TEXT("\textbf{\textit{OUTP}}", size=1.5116, bold=false) => @PLACE(34.8, -28) => %label4;
*   $CANVAS_LABEL @ATTACH(bind="net") %label4(label);
*   %wire5 @TEXT("\textbf{\textit{CLK1}}", halign="middle", size=1.5116, bold=false) => @PLACE(8, -23.6) => %label5;
*   $CANVAS_LABEL @ATTACH(bind="net") %label5(label);
*   %wire6 @TEXT("\textbf{\textit{CLK2}}", halign="middle", size=1.5116, bold=false) => @PLACE(28, -23.6) => %label6;
*   $CANVAS_LABEL @ATTACH(bind="net") %label6(label)
* }
.ends Chopper2Phase

