.subckt bootstrap_track_hold_cell vdd VSS clk_inverted vin gate_boost
CBOOTSTRAP net2 net0 950fF
XMBOOT_CAP_DISCHARGE net0 clk_inverted VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
XMBOOTSTRAP_CLAMP vdd gate_boost net2 net2 sky130_fd_pr__pfet_01v8 l=0.15 w=32 nf=16 m=1
XMBOOTSTRAP_GATE_TRANSFER gate_boost net1 net2 net2 sky130_fd_pr__pfet_01v8 l=0.15 w=32 nf=16 m=1
XMBOOTSTRAP_OFF_CLAMP gate_boost vdd clk_internal VSS sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
XMBOOTSTRAP_PRECHARGE vdd clk_internal gate_boost VSS sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
XMCLK_INV_N clk_internal clk_inverted VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
XMCLK_INV_P clk_internal clk_inverted vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=32 nf=16 m=1
XMGATE_CONTROL_PRECHARGE net1 clk_internal vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=16 nf=8 m=1
XMGATE_CONTROL_TRACK net1 clk_internal net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
XMINPUT_TRACK net0 gate_boost vin VSS sky130_fd_pr__nfet_01v8 l=0.15 w=32 nf=16 m=1
* @RNL(author="analog-canvas") {
*   %bootstrap_track_hold_cell_SYMBOL = @DEFINE-SYMBOL(box=[-13, -6, 13, 6]) {
*     (-13, -1) @PIN(terminal="vin", label="\textbf{\textit{v}}_{\textbf{in}}", direction="left");
*     (13, 0) @PIN(terminal="gate_boost", label="\textbf{\textit{gate}}_{\textbf{\textit{boost}}}", direction="right");
*     (0, 6) @PIN(terminal="vdd", label="\textbf{\textit{v}}_{\textbf{dd}}", direction="up");
*     (0, 0) @RECTANGLE(width=24, height=10);
