*   &net0 @WIRE(mode="straight") {#XMINPUT_TRACK:1 (100, 5) %j7};
*   &vin @WIRE(mode="straight") {%port3:p (100, -10) #XMINPUT_TRACK:3};
*   &gate_boost @WIRE(mode="straight") {#XMBOOTSTRAP_PRECHARGE:3 %j8};
*   &gate_boost @WIRE(mode="straight") {%j8 #XMBOOTSTRAP_OFF_CLAMP:1};
*   &gate_boost @WIRE(mode="straight") {%port4:p %j8};
*   &vdd @WIRE(mode="straight") {#XMBOOTSTRAP_OFF_CLAMP:2 (109, 8) %vdd1:p};
*   &gate_boost @WIRE(mode="straight") {#XMBOOTSTRAP_CLAMP:2 %j9};
*   &gate_boost @WIRE(mode="straight") {#XMBOOTSTRAP_GATE_TRANSFER:1 %j10};
*   &gate_boost @WIRE(mode="straight") {#XMINPUT_TRACK:2 %j11};
*   &clk_internal @WIRE(mode="straight") {#XMBOOTSTRAP_PRECHARGE:2 %j12};
*   &clk_internal @WIRE(mode="straight") {#XMBOOTSTRAP_OFF_CLAMP:3 %j13};
*   &vdd @WIRE(mode="straight") {#XMCLK_INV_P:3 %j14};
*   &clk_inverted @WIRE(mode="straight") {%port1:p %j15};
*   &clk_inverted @WIRE(mode="straight") {%j15 %j1};
*   &clk_inverted @WIRE(mode="straight") {%j15 (3, 16) #XMCLK_INV_P:2};
*   &clk_inverted @WIRE(mode="straight") {%j1 #XMCLK_INV_N:2};
*   &clk_internal @WIRE(mode="straight") {%j16 %j3};
*   &clk_internal @WIRE(mode="straight") {%j16 (25, 16) #XMGATE_CONTROL_PRECHARGE:2};
*   &clk_internal @WIRE(mode="straight") {%j16 %j2};
*   &clk_internal @WIRE(mode="straight") {%j3 #XMGATE_CONTROL_TRACK:2};
*   &clk_internal @WIRE(mode="straight") {#XMCLK_INV_N:1 %j2};
*   &clk_internal @WIRE(mode="straight") {%j2 #XMCLK_INV_P:1};
*   &vdd @WIRE(mode="straight") {#XMGATE_CONTROL_PRECHARGE:3 %j17};
*   &vdd @WIRE(mode="straight") {#XMBOOTSTRAP_CLAMP:1 %j18};
*   &vdd @WIRE(mode="straight") {#XMBOOTSTRAP_PRECHARGE:1 %j19};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j20 %j14};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j14 %j17};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j17 %j18};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j18 %j19};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j19 %j21};
*   &VSS @WIRE(mode="straight") {%gnd2:p #XMBOOT_CAP_DISCHARGE:3};
