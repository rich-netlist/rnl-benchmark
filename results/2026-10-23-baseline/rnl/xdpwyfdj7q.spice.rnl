.ends bootstrap_track_hold_cell

.subckt bootstrap_gate_driver vdd VSS clk vinp vinn gatep gaten
XBOOTSTRAP_N vdd VSS clk vinn gaten bootstrap_track_hold_cell
XBOOTSTRAP_P vdd VSS clk vinp gatep bootstrap_track_hold_cell
* @RNL(author="analog-canvas") {
*   $IO_PORT @ATTACH &clk(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(2, 1) => %port1;
*   $IO_PORT @ATTACH &vinp(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(2, -1) => %port2;
*   $IO_PORT @ATTACH &clk(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(2, -19) => %port3;
*   $IO_PORT @ATTACH &vinn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(2, -21) => %port4;
*   $IO_PORT @ATTACH &gatep(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(38, 0) => @ORIENT("MY") => %port5;
*   $IO_PORT @ATTACH &gaten(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(38, -20) => @ORIENT("MY") => %port6;
*   $SUPPLY @ATTACH &vdd(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(20, 8) => %vdd1;
*   $SUPPLY @ATTACH &vdd(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(20, -12) => %vdd2;
*   #XBOOTSTRAP_P @PLACE(20, 0);
*   #XBOOTSTRAP_N @PLACE(20, -20);
*   &vdd @REMOVE-FROM $PORT_FILL_SET;
*   &VSS @REMOVE-FROM $PORT_FILL_SET;
*   &vinp @WIRE(mode="straight") {%port2:p #XBOOTSTRAP_P:4};
*   &vinn @WIRE(mode="straight") {%port4:p #XBOOTSTRAP_N:4};
*   &gatep @WIRE(mode="straight") {%port5:p #XBOOTSTRAP_P:5};
*   &gaten @WIRE(mode="straight") {%port6:p #XBOOTSTRAP_N:5};
*   &vdd @WIRE(mode="straight") {%vdd1:p #XBOOTSTRAP_P:1};
*   &vdd @WIRE(mode="straight") {%vdd2:p #XBOOTSTRAP_N:1};
*   %port1 @TEXT("\textbf{\textit{clk}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   %port2 @TEXT("\textbf{\textit{v}}_{\textbf{inp}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   %port3 @TEXT("\textbf{\textit{clk}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   %port4 @TEXT("\textbf{\textit{v}}_{\textbf{inn}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   %port5 @TEXT("\textbf{\textit{gatep}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   %port6 @TEXT("\textbf{\textit{gaten}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   &vdd @TEXT("\textbf{\textit{v}}_{\textbf{dd}}", size=1.5116) => @PLACE(22, 9) => %power1;
*   &vdd @TEXT("\textbf{\textit{v}}_{\textbf{dd}}", size=1.5116) => @PLACE(22, -11) => %power2;
*   #XBOOTSTRAP_P
*       @TEXT("\textbf{bootstrap\_track\_hold\_cell}", key="value", dx=0, dy=-6.5, halign="middle", valign="baseline", size=1.5116);
*   #XBOOTSTRAP_N
*       @TEXT("\textbf{bootstrap\_track\_hold\_cell}", key="value", dx=0, dy=-6.5, halign="middle", valign="baseline", size=1.5116)
* }
.ends bootstrap_gate_driver
