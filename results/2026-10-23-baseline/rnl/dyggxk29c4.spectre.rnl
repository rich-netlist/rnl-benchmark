subckt xfmr (p_plus p_minus s_plus s_minus)
parameters lp=1n ls=1n k=1
LP (p_plus p_minus) inductor l=lp
LS (s_plus s_minus) inductor l=ls
K1 mutual_inductor coupling=k ind1=LP ind2=LS
ends xfmr

subckt class_ab_pa (VDD VSS rfin ibias vcas rfout)
C1 (VSS net4) capacitor c=3.2pF
C2 (net0 VSS) capacitor c=3.2pF
C3 (net5 net3) capacitor c=0.5pF
CB (ibias VSS) capacitor c=10pF
CS (rfout VSS) capacitor c=1.75pF
LF1 (VDD net4) inductor l=3nH
LF2 (VDD net0) inductor l=3nH
M1 (net1 net3 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=400 nf=80 m=1
M2 (net2 net5 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=400 nf=80 m=1
M3 (net4 vcas net1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=400 nf=80 m=1
M4 (net0 vcas net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=400 nf=80 m=1
MB (ibias ibias VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=2 m=1
Rg1 (net3 ibias) resistor r=600Ω
Rg2 (ibias net5) resistor r=600Ω
RL (rfout VSS) resistor r=50Ω
X1 (rfin VSS net3 net5) xfmr lp=0.9n ls=6n k=0.8
X2 (net4 net0 rfout VSS) xfmr lp=2.4n ls=1.6n k=0.8
