simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="rnl-std", version="0.3");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.1");
//   @USE-PACKAGE(name="rnl-std-functional", version="0.3")
// }

subckt icm_opamp_vdd_vss (VIP VIN VDD VSS VOUT)
parameters gain=1e6
Blin (nlin 0) bsource v=gain*(v(VIP)-v(VIN))
Bcore (VOUT 0) bsource v=0.5*(v(VDD)+(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12)))-sqrt((v(VDD)-(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))))*(v(VDD)-(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))
ends icm_opamp_vdd_vss

subckt dut (VDD VSS Vref VB1)
M1 (net7 net2 net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (net8 net2 net1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net9 net2 net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
Mc1 (net0 VB1 net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
Mc2 (net1 VB1 net4 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
Mc3 (net3 VB1 Vref VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
Q1 (VSS VSS net5) sky130_fd_pr__pnp_05v5_W0p68L0p68
Q2 (VSS VSS net6) sky130_fd_pr__pnp_05v5_W0p68L0p68
R1 (net4 net6) resistor r=1k
R3 (net5 VSS) resistor r=1k
R4 (net4 VSS) resistor r=1k
R5 (Vref VSS) resistor r=1k
Rs1 (VDD net7) resistor r=1k
Rs2 (VDD net8) resistor r=1k
Rs3 (VDD net9) resistor r=1k
X1 (net4 net5 VDD VSS net2) icm_opamp_vdd_vss
