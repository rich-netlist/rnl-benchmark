//   &y @WIRE(mode="straight") {%j2 #MN1:1};
//   &y @WIRE(mode="straight") {#MP2:1 %j3};
//   &y @WIRE(mode="straight") {%j3 %j2};
//   &y @WIRE(mode="straight") {%port3:p %j3};
