//   $IO_PORT @ATTACH &y(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(6, 0) => @ORIENT("MY") => %port2;
//   $IO_PORT @ATTACH &vdd(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(0, 9) => @ORIENT("R270") => %port3;
//   $IO_PORT @ATTACH &vss(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(0, -9) => @ORIENT("R90") => %port4;
//   %j1 = (-3, 0);
//   $JUNCTION @ATTACH %j1;
//   %j2 = (0, 0);
//   $JUNCTION @ATTACH %j2;
//   &a @WIRE(mode="straight") {#MP:2 %j1};
//   &a @WIRE(mode="straight") {%j1 #MN:2};
//   &a @WIRE(mode="straight") {%port1:p %j1};
//   &y @WIRE(mode="straight") {#MP:1 %j2};
//   &y @WIRE(mode="straight") {%j2 #MN:1};
//   &y @WIRE(mode="straight") {%port2:p %j2};
//   &vdd @WIRE(mode="straight") {%port3:p #MP:3};
//   &vss @WIRE(mode="straight") {%port4:p #MN:3};
//   #MP @TEXT("\textbf{\textit{M}}_{\textbf{P}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116);
//   #MN @TEXT("\textbf{\textit{M}}_{\textbf{N}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116);
//   %port1 @TEXT("\textbf{\textit{a}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
//   %port2 @TEXT("\textbf{\textit{y}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
