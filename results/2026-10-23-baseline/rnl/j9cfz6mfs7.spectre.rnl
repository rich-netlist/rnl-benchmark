simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="rnl-std", version="0.3");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.1")
// }

subckt ideal_chopper (INP INN OUTP OUTN CK)
parameters ron=1 roff=1e12 vt=0.5
s1 (INP OUTP) bsource i=v(INP,OUTP)/(v(CK)>vt ? ron : roff)
s2 (INN OUTN) bsource i=v(INN,OUTN)/(v(CK)>vt ? ron : roff)
s3 (INP OUTN) bsource i=v(INP,OUTN)/(v(CK)>vt ? roff : ron)
s4 (INN OUTP) bsource i=v(INN,OUTP)/(v(CK)>vt ? roff : ron)
ends ideal_chopper

subckt dut (VDD VSS VB3 VB4 VB2 VCMFB VB1 VinP VinN VB5 VB6 VoutN VoutP PHIch)
C1 (VoutN net0) capacitor c=1p
C2 (VoutP net1) capacitor c=1p
CH1 (net11 net10 net12 net13 PHIch) ideal_chopper
CH2 (net7 net6 net2 net8 PHIch) ideal_chopper
M1 (net3 VB1 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M10 (net9 VB2 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M11 (net9 VCMFB VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M12 (VoutN net5 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M13 (VoutN VB5 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M14 (VoutP net4 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M15 (VoutP VB6 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (net10 VinP net3 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net11 VinN net3 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (net4 VB3 net13 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (net5 VB3 net12 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (net4 VB4 net6 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M7 (net5 VB4 net7 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M8 (net8 VinP net9 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M9 (net2 VinN net9 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (net0 net5) resistor r=1k
R2 (net1 net4) resistor r=1k
