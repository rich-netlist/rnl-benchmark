X2 net1 net0 VDD VSS delay_cell tpd=20n vt=10m
X9 net2 Valid net1 VDD VSS nor_gate td=20n vt=10m
* @RNL(author="analog-canvas") {
*   %CLKC_SYMBOL = @DEFINE-SYMBOL(box=[-7, -5, 7, 5]) {
*     (-7, -2) @PIN(terminal="CLKC", label="\textbf{\textit{CLKC}}", direction="left");
*     (7, -2) @PIN(terminal="CLKS", label="\textbf{\textit{CLKS}}", direction="right");
*     (7, 1) @PIN(terminal="Valid", label="\textbf{\textit{V}}\textbf{alid}", direction="right");
*     (-7, 1) @PIN(terminal="CLK0", label="\textbf{\textit{CLK0}}", direction="left");
*     (0, 0) @RECTANGLE(width=12, height=8);
*     @LINE {(-7, -2) (-6, -2)};
*     @LINE {(7, -2) (6, -2)};
*     @LINE {(7, 1) (6, 1)};
*     @LINE {(-7, 1) (-6, 1)}
