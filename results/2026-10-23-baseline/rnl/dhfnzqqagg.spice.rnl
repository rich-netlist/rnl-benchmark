*   &VDD @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", size=1.5116) => @PLACE(103, -15) => %power5;
*   %port9 @TEXT("\textbf{\textit{V}}_{\textbf{on}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116);
*   &Vlp @TEXT("\textbf{\textit{V}}_{\textbf{lp}}", size=1.5116) => @PLACE(77, -21);
*   &Vln @TEXT("\textbf{\textit{V}}_{\textbf{ln}}", size=1.5116) => @PLACE(93, -21)
* }
.ends COMP

