*   $IO_PORT @ATTACH &CLKSB(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(79, -16) => @ORIENT("R270") => %port3;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(84, -21) => %gnd1;
