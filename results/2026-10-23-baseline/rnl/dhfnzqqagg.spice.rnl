
* @RNL(type="header") {
*   @VERSION("0.3");
*   @USE-PACKAGE(name="rnl-std", version="0.3");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
*   @USE-PACKAGE(name="rnl-std-logic", version="0.3")
* }
* Ideal and-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt and_gate A B Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
BhB hB 0 V={0.5*(1+tanh((V(B,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(V(hA)*V(hB))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends and_gate

* Ideal buffer: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt buffer A Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(V(hA))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends buffer

* Ideal d-flip-flop: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt d_flip_flop D CK Q QBAR VDD VSS params: vt=10m td=10p
BhD hD 0 V={0.5*(1+tanh((V(D,VSS)-0.5*V(VDD,VSS))/vt))}
BhCK hCK 0 V={0.5*(1+tanh((V(CK,VSS)-0.5*V(VDD,VSS))/vt))}
Bm 0 nm I={10m*((V(hD)-V(nm))*(1-V(hCK)))}
Cm nm 0 1p
Rm nm 0 1T
Bs 0 ns I={10m*((V(nm)-V(ns))*V(hCK))}
Cs ns 0 1p
Rs ns 0 1T
Bf nfn VSS V={V(VDD,VSS)*(0.5*(1+tanh((V(ns)-0.5)/10m)))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BQ Q VSS V={V(ndl,VSS)}
BQBAR QBAR VSS V={V(VDD,VSS)-V(ndl,VSS)}
.ends d_flip_flop

* Ideal d-flip-flop-reset: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt d_flip_flop_reset D CK RST Q QBAR VDD VSS params: vt=10m td=10p
BhD hD 0 V={0.5*(1+tanh((V(D,VSS)-0.5*V(VDD,VSS))/vt))}
BhCK hCK 0 V={0.5*(1+tanh((V(CK,VSS)-0.5*V(VDD,VSS))/vt))}
BhRST hRST 0 V={0.5*(1+tanh((V(RST,VSS)-0.5*V(VDD,VSS))/vt))}
Bm 0 nm I={10m*((V(hD)-V(nm))*(1-V(hCK))*(1-V(hRST))-V(nm)*V(hRST))}
Cm nm 0 1p
Rm nm 0 1T
Bs 0 ns I={10m*((V(nm)-V(ns))*V(hCK)*(1-V(hRST))-V(ns)*V(hRST))}
Cs ns 0 1p
Rs ns 0 1T
Bf nfn VSS V={V(VDD,VSS)*(0.5*(1+tanh((V(ns)-0.5)/10m)))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BQ Q VSS V={V(ndl,VSS)}
BQBAR QBAR VSS V={V(VDD,VSS)-V(ndl,VSS)}
.ends d_flip_flop_reset

* Delay Cell: nominal 50% propagation tpd, tau=tpd/ln(2), logic regeneration; not pure transport delay
.subckt delay_cell A Y VDD VSS params: vt=10m tpd=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*V(hA)}
Rd nfn ndl 1k
Cd ndl VSS {tpd/(1000*ln(2))}
BY Y VSS V={V(VDD,VSS)*0.5*(1+tanh((V(ndl,VSS)-0.5*V(VDD,VSS))/vt))}
.ends delay_cell

* Ideal inverter: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt inverter A Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(1-V(hA))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends inverter

* Ideal nor-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt nor_gate A B Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
BhB hB 0 V={0.5*(1+tanh((V(B,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*((1-V(hA))*(1-V(hB)))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends nor_gate

* Ideal or-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt or_gate A B Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
BhB hB 0 V={0.5*(1+tanh((V(B,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(1-(1-V(hA))*(1-V(hB)))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends or_gate

.subckt COMP VDD VSS Vinp Vinn CLK Vop Von
XM1 net0 Vinp net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM10 net0 CLK VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
