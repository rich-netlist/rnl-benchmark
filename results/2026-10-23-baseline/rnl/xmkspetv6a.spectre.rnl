simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="rnl-std", version="0.3");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.1")
// }

subckt opamp_differential (VIP VIN VOP VON VDD VSS)
parameters gain=1e6
EPLUS (VOP 0 VIP VIN) vcvs gain=gain/2
EMINUS (VON 0 VIN VIP) vcvs gain=gain/2
ends opamp_differential

subckt dut (VDD VSS Outp Outn Inp Inn a S1 S2)
subckt ideal_switch (p n cp cn)
parameters ron=1 roff=1e12 vt=0.5
core (p n) bsource i=v(p,n)/(v(cp,cn)>vt ? ron : roff)
ends ideal_switch
C1 (Outp net0) capacitor c=1p
C2 (net0 Inp) capacitor c=1p
C3 (a Inn) capacitor c=1p
C4 (Outn a) capacitor c=1p
C5 (net2 Outp) capacitor c=1p
C6 (Outn net3) capacitor c=1p
M1 (Outp VBP VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M10 (Outp net5 VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M11 (Outn net4 VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M12 (net7 net7 a a) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M13 (net7 net7 net6 net6) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M14 (net8 net8 net6 net6) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M15 (net8 net8 Outn Outn) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M2 (net1 VBP VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M3 (Outn VBP VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M4 (net2 Inp net1 VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M5 (net3 Inn net1 VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M6 (net5 VBC net2 VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M7 (net4 VBC net3 VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M8 (net5 VCMFB VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M9 (net4 VCMFB VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
R1 (Outp net0) resistor r=1k
R2 (Outn a) resistor r=1k
S1 (net0 Outp S1 VSS) ideal_switch
S2 (a Outn S2 VSS) ideal_switch
X1 (net0 a Outn Outp VDD VSS) opamp_differential gain=1e6
