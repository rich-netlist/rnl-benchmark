.subckt UBVCO VDD VSS gs Vc Vte ibg450u_ic inp inn vs
C1 inn Vc 1p
C2 inp Vc 1p
C3 inn Vte 1p
C4 inp Vte 1p
L1 inn net0 1n
L2 net0 inp 1n
XM1 inp inn net1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 inn inp net1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 net1 ibg450u_ic gs VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 ibg450u_ic ibg450u_ic gs gs sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 vs net0 1k
