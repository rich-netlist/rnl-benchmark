*   $IO_PORT @ATTACH &a(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-6, 0) => %port1;
*   $IO_PORT @ATTACH &y(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(6, 0) => @ORIENT("MY") => %port2;
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(1, 6) => %vdd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(1, -6) => %gnd1;
*   &VSS @REMOVE-FROM $PORT_FILL_SET;
*   %j1 = (-2, 0);
*   $JUNCTION @ATTACH %j1;
*   %j2 = (1, 0);
*   $JUNCTION @ATTACH %j2;
*   &a @WIRE(mode="straight") {#XMP:2 %j1};
*   &a @WIRE(mode="straight") {%j1 #XMN:2};
*   &a @WIRE(mode="straight") {%port1:p %j1};
*   &y @WIRE(mode="straight") {#XMP:1 %j2};
*   &y @WIRE(mode="straight") {%j2 #XMN:1};
*   &y @WIRE(mode="straight") {%j2 %port2:p};
*   &VDD @WIRE(mode="straight") {#XMP:3 %vdd1:p};
*   &VSS @WIRE(mode="straight") {%gnd1:p #XMN:3};
*   #XMP @TEXT("\textbf{\textit{M}}_{\textbf{P}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   #XMN @TEXT("\textbf{\textit{M}}_{\textbf{N}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   %port1 @TEXT("\textbf{\textit{a}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   %port2 @TEXT("\textbf{\textit{y}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   &VDD @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", size=1.5116) => @PLACE(3, 7) => %power1
* }
.ends fa_inv

