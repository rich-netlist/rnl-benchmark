*   %fa_comp_SYMBOL = @DEFINE-SYMBOL(box=[-6, -6, 6, 6]) {
*     (-6, 1) @PIN(terminal="vinp", label="\textbf{\textit{v}}_{\textbf{inp}}", direction="left");
*     (-6, -1) @PIN(terminal="vinn", label="\textbf{\textit{v}}_{\textbf{inn}}", direction="left");
*     (-6, -3) @PIN(terminal="clk", label="\textbf{\textit{clk}}", direction="left");
*     (6, 1) @PIN(terminal="outp", label="\textbf{\textit{outp}}", direction="right");
*     (6, -1) @PIN(terminal="outn", label="\textbf{\textit{outn}}", direction="right");
*     (0, 0) @RECTANGLE(width=10, height=10);
*     @LINE {(-6, 1) (-5, 1)};
*     @LINE {(-6, -1) (-5, -1)};
*     @LINE {(-6, -3) (-5, -3)};
*     @LINE {(6, 1) (5, 1)};
*     @LINE {(6, -1) (5, -1)}
*   };
*   # @SET-SYMBOL %fa_comp_SYMBOL;
*   #XMPC3 @SET-SYMBOL $PMOS => @PLACE(-8, 0) => @ORIENT("MY");
*   #XMPC1 @SET-SYMBOL $PMOS => @PLACE(4, 0);
