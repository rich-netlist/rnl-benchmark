*   %j2 = (50, 4);
*   %j3 = (-8, 4);
*   $JUNCTION @ATTACH %j3;
*   %j4 = (4, 4);
*   $JUNCTION @ATTACH %j4;
*   %j5 = (15, 4);
*   $JUNCTION @ATTACH %j5;
*   %j6 = (25, 4);
*   $JUNCTION @ATTACH %j6;
*   %j7 = (36, 4);
*   $JUNCTION @ATTACH %j7;
*   %j8 = (48, 4);
*   $JUNCTION @ATTACH %j8;
*   %j9 = (15, -4);
*   $JUNCTION @ATTACH %j9;
*   %j10 = (18, -4);
*   $JUNCTION @ATTACH %j10;
*   %j11 = (25, -4);
*   $JUNCTION @ATTACH %j11;
*   %j12 = (22, -4);
*   $JUNCTION @ATTACH %j12;
*   %j13 = (15, -12);
*   $JUNCTION @ATTACH %j13;
*   %j14 = (25, -12);
*   $JUNCTION @ATTACH %j14;
*   %j15 = (20, -20);
*   $JUNCTION @ATTACH %j15;
*   %j16 = (47, -24);
*   %j17 = (47, -28);
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j1 %j3};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j3 %j4};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j4 %j5};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j5 %j6};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j6 %j7};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j7 %j8};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j8 %j2};
*   &VDD @WIRE(mode="straight") {#XMPC3:3 %j3};
*   &VDD @WIRE(mode="straight") {#XMPC1:3 %j4};
*   &VDD @WIRE(mode="straight") {#XMPL1:3 %j5};
*   &VDD @WIRE(mode="straight") {#XMPL2:3 %j6};
*   &VDD @WIRE(mode="straight") {#XMPC2:3 %j7};
*   &VDD @WIRE(mode="straight") {#XMPC4:3 %j8};
*   &clk @WIRE(mode="straight") {#XMPC3:2 #XMPC1:2};
*   &clk @WIRE(mode="straight") {#XMPC2:2 #XMPC4:2};
*   &clk @WIRE(mode="straight") {%port3:p #XMTAIL:2};
*   &outn @WIRE(mode="straight") {#XMPL1:1 %j9};
*   &outn @WIRE(mode="straight") {%j9 #XMNL1:1};
*   &outp @WIRE(mode="straight") {#XMPL2:1 %j11};
*   &outp @WIRE(mode="straight") {%j11 #XMNL2:1};
*   &outn @WIRE(mode="straight") {#XMPC1:1 #XMPL1:1};
*   &outp @WIRE(mode="straight") {#XMPC2:1 #XMPL2:1};
