*   #XMNL1 @SET-SYMBOL $NMOS => @PLACE(15, -8) => @ORIENT("MY");
*   #XMNL2 @SET-SYMBOL $NMOS => @PLACE(25, -8);
*   #XMIN1 @SET-SYMBOL $NMOS => @PLACE(15, -16);
*   #XMIN2 @SET-SYMBOL $NMOS => @PLACE(25, -16) => @ORIENT("MY");
*   #XMTAIL @SET-SYMBOL $NMOS => @PLACE(20, -24);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(20, -26) => %gnd1;
*   $IO_PORT @ATTACH &vinp(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-12, -16) => %port1;
*   $IO_PORT @ATTACH &vinn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(52, -16) => @ORIENT("MY") => %port2;
*   $IO_PORT @ATTACH &clk(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(10, -24) => %port3;
