*   &outp @WIRE(mode="straight") {%j11 %j12};
*   &outn @WIRE(mode="straight") {#XMPL2:2 %j10};
*   &outn @WIRE(mode="straight") {#XMNL2:2 %j10};
*   &outp @WIRE(mode="straight") {#XMPL1:2 %j12};
*   &outp @WIRE(mode="straight") {#XMNL1:2 %j12};
*   &dx @WIRE(mode="straight") {#XMNL1:3 %j13};
*   &dx @WIRE(mode="straight") {%j13 #XMIN1:1};
*   &dy @WIRE(mode="straight") {#XMNL2:3 %j14};
*   &dy @WIRE(mode="straight") {%j14 #XMIN2:1};
*   &dx @WIRE(mode="straight") {#XMPC3:1 (-8, -12) %j13};
*   &dy @WIRE(mode="straight") {#XMPC4:1 (48, -12) %j14};
*   &vinp @WIRE(mode="straight") {%port1:p #XMIN1:2};
*   &vinn @WIRE(mode="straight") {#XMIN2:2 %port2:p};
*   &net0 @WIRE(mode="straight") {#XMIN1:3 (15, -20) %j15};
*   &net0 @WIRE(mode="straight") {%j15 (25, -20) #XMIN2:3};
*   &net0 @WIRE(mode="straight") {#XMTAIL:1 %j15};
*   &outp @WIRE(mode="straight") {%port4:p %j16};
*   &outn @WIRE(mode="straight") {%port5:p %j17};
*   &VSS @WIRE(mode="straight") {%gnd1:p #XMTAIL:3};
*   $JUNCTION @ATTACH (25, -2)(p) => %dot1;
*   $JUNCTION @ATTACH (15, -2)(p) => %dot2;
*   #XMPC3 @TEXT("\textbf{\textit{M}}_{\textbf{PC3}}", key="name", dx=-0.4, dy=-0.5, halign="end", valign="baseline", size=1.5116);
