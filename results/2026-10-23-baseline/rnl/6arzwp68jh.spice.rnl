XMP2 y b VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=4 nf=1 m=1
* @RNL(author="analog-canvas") {
*   #XMP1 @SET-SYMBOL $PMOS => @PLACE(1, 4);
*   #XMP2 @SET-SYMBOL $PMOS => @PLACE(11, 4) => @ORIENT("MY");
*   #XMN1 @SET-SYMBOL $NMOS => @PLACE(1, -3);
*   #XMN2 @SET-SYMBOL $NMOS => @PLACE(1, -10);
*   $IO_PORT @ATTACH &a(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-8, 1) => %port1;
*   $IO_PORT @ATTACH &b(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-8, -10) => %port2;
*   $IO_PORT @ATTACH &y(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(19, 0) => @ORIENT("MY") => %port3;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(1, -12) => %gnd1;
*   &VSS @REMOVE-FROM $PORT_FILL_SET;
*   %j1 = (-1, 8);
*   %j2 = (13, 8);
*   %j3 = (1, 8);
*   $JUNCTION @ATTACH %j3;
*   %j4 = (11, 8);
*   $JUNCTION @ATTACH %j4;
*   %j5 = (1, 0);
*   $JUNCTION @ATTACH %j5;
*   %j6 = (11, 0);
*   $JUNCTION @ATTACH %j6;
*   %j7 = (-2, 1);
*   $JUNCTION @ATTACH %j7;
*   %j8 = (16, 4);
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j1 %j3};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j3 %j4};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j4 %j2};
*   &VDD @WIRE(mode="straight") {#XMP1:3 %j3};
*   &VDD @WIRE(mode="straight") {#XMP2:3 %j4};
*   &y @WIRE(mode="straight") {#XMP1:1 %j5};
*   &y @WIRE(mode="straight") {%j5 #XMN1:1};
*   &y @WIRE(mode="straight") {#XMP2:1 %j6};
*   &y @WIRE(mode="straight") {%j6 %j5};
*   &y @WIRE(mode="straight") {%j6 %port3:p};
*   &a @WIRE(mode="straight") {#XMP1:2 %j7};
*   &a @WIRE(mode="straight") {%j7 #XMN1:2};
*   &a @WIRE(mode="straight") {%port1:p %j7};
*   &nx @WIRE(mode="straight") {#XMN1:3 #XMN2:1};
*   &b @WIRE(mode="straight") {%port2:p #XMN2:2};
*   &b @WIRE(mode="straight") {#XMP2:2 %j8};
*   &VSS @WIRE(mode="straight") {%gnd1:p #XMN2:3};
*   #XMP1 @TEXT("\textbf{\textit{M}}_{\textbf{P1}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   #XMP2 @TEXT("\textbf{\textit{M}}_{\textbf{P2}}", key="name", dx=-0.4, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   #XMN1 @TEXT("\textbf{\textit{M}}_{\textbf{N1}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   #XMN2 @TEXT("\textbf{\textit{M}}_{\textbf{N2}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   %port1 @TEXT("\textbf{\textit{a}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   %port2 @TEXT("\textbf{\textit{b}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   %port3 @TEXT("\textbf{\textit{y}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   &VDD @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", size=1.5116) => @PLACE(14, 7) => %power1;
*   &b @TEXT("\textbf{\textit{b}}", size=1.5116) => @PLACE(15, 4.4);
*   &nx @TEXT("\textbf{\textit{nx}}", size=1.5116) => @PLACE(1.4, -6.6)
