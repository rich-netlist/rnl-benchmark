.ends fa_nand2

.subckt flash4_xor VSS a b y
X1 VSS a b n1 fa_nand2
X2 VSS a n1 n2 fa_nand2
X3 VSS b n1 n3 fa_nand2
X4 VSS n2 n3 y fa_nand2
* @RNL(author="analog-canvas") {
*   #X1 @SET-SYMBOL $NAND_2INPUT => @PLACE(0, 0);
*   #X2 @SET-SYMBOL $NAND_2INPUT => @PLACE(12, 6);
*   #X3 @SET-SYMBOL $NAND_2INPUT => @PLACE(12, -6) => @ORIENT("MX");
*   #X4 @SET-SYMBOL $NAND_2INPUT => @PLACE(24, 0);
*   $IO_PORT @ATTACH &a(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-11, 7) => %port1;
*   $IO_PORT @ATTACH &b(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-11, -7) => %port2;
*   $IO_PORT @ATTACH &y(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(33, 0) => @ORIENT("MY") => %port3;
*   &VSS @REMOVE-FROM $PORT_FILL_SET;
*   %j1 = (-7, 7);
*   $JUNCTION @ATTACH %j1;
*   %j2 = (-6, -7);
*   $JUNCTION @ATTACH %j2;
*   %j3 = (6, 0);
*   $JUNCTION @ATTACH %j3;
*   &a @WIRE(mode="straight") {%port1:p %j1};
*   &a @WIRE(mode="straight") {%j1 #X2:1};
*   &b @WIRE(mode="straight") {%port2:p %j2};
*   &b @WIRE(mode="straight") {%j2 #X3:1};
*   &a @WIRE(mode="straight") {%j1 (-7, 1) #X1:1};
*   &b @WIRE(mode="straight") {%j2 (-6, -1) #X1:2};
*   &n1 @WIRE(mode="straight") {#X1:3 %j3};
*   &n1 @WIRE(mode="straight") {%j3 (6, 5) #X2:2};
*   &n1 @WIRE(mode="straight") {%j3 (6, -5) #X3:2};
*   &n2 @WIRE(mode="straight") {#X2:3 (18, 6) (18, 1) #X4:1};
*   &n3 @WIRE(mode="straight") {#X3:3 (19, -6) (19, -1) #X4:2};
*   &y @WIRE(mode="straight") {#X4:3 %port3:p};
*   #X1 @TEXT("\textbf{\textit{X}}_{\textbf{1}}", key="name", dx=0, dy=-3, halign="middle", valign="baseline", size=1.5116);
*   #X2 @TEXT("\textbf{\textit{X}}_{\textbf{2}}", key="name", dx=0, dy=-3, halign="middle", valign="baseline", size=1.5116);
*   #X3 @TEXT("\textbf{\textit{X}}_{\textbf{3}}", key="name", dx=0, dy=2.4, halign="middle", valign="baseline", size=1.5116);
*   #X4 @TEXT("\textbf{\textit{X}}_{\textbf{4}}", key="name", dx=0, dy=-3, halign="middle", valign="baseline", size=1.5116);
*   %port1 @TEXT("\textbf{\textit{a}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   %port2 @TEXT("\textbf{\textit{b}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   %port3 @TEXT("\textbf{\textit{y}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   &n1 @TEXT("\textbf{\textit{n1}}", size=1.5116) => @PLACE(3.6, 0.4);
*   &n2 @TEXT("\textbf{\textit{n2}}", size=1.5116) => @PLACE(15.4, 6.4);
*   &n3 @TEXT("\textbf{\textit{n3}}", size=1.5116) => @PLACE(15.4, -5.6)
* }
.ends flash4_xor

