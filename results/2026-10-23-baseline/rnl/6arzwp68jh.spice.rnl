.subckt fa_sr VSS sn rn q qb
XG1 VSS sn qb q fa_nand2
XG2 VSS rn q qb fa_nand2
* @RNL(author="analog-canvas") {
*   %fa_sr_SYMBOL = @DEFINE-SYMBOL(box=[-5, -4, 5, 4]) {
*     (-5, -1) @PIN(terminal="sn", label="\textbf{\textit{sn}}", direction="left");
*     (-5, 1) @PIN(terminal="rn", label="\textbf{\textit{rn}}", direction="left");
