simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="rnl-std", version="0.3");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.1")
// }

subckt xfmr (p_plus p_minus s_plus s_minus)
parameters lp=1n ls=1n k=1
LP (p_plus p_minus) inductor l=lp
LS (s_plus s_minus) inductor l=ls
K1 mutual_inductor coupling=k ind1=LP ind2=LS
ends xfmr

subckt dut (VDD VSS VB1 Vip Vin VB2 Vg Vop Von)
model DIODE diode is=1e-14 n=1
C1 (net4 net2) capacitor c=1p
C2 (Von VSS) capacitor c=1p
C3 (net1 net0) capacitor c=1p
C4 (Vip VSS) capacitor c=1p
C5 (Vin VSS) capacitor c=1p
CS (Vop VSS) capacitor c=1p
D1 (net1 VDD) DIODE
D2 (VSS net1) DIODE
D3 (net2 VDD) DIODE
D4 (VSS net2) DIODE
L1 (net9 net11) inductor l=1n
L2 (net8 net10) inductor l=1n
L3 (Vg net5) inductor l=1n
L4 (net3 Vg) inductor l=1n
M1 (Vop net6 VDD VDD) sg13_lv_pmos w=1u l=150n ng=1 m=1
M10 (net10 net0 VSS VSS) sg13_lv_nmos w=1u l=150n ng=1 m=1
M11 (net1 net12 VSS VSS) sg13_lv_nmos w=1u l=150n ng=1 m=1
M12 (net2 net15 VSS VSS) sg13_lv_nmos w=1u l=150n ng=1 m=1
M2 (Von net6 VDD VDD) sg13_lv_pmos w=1u l=150n ng=1 m=1
M3 (Vop net6 Von VDD) sg13_lv_pmos w=1u l=150n ng=1 m=1
M4 (Von net6 Vop VDD) sg13_lv_pmos w=1u l=150n ng=1 m=1
M5 (Von net7 net8 VSS) sg13_lv_nmos w=1u l=150n ng=1 m=1
M6 (Vop net7 net9 VSS) sg13_lv_nmos w=1u l=150n ng=1 m=1
M7 (net11 net5 net1 VSS) sg13_lv_nmos w=1u l=150n ng=1 m=1
M8 (net10 net3 net2 VSS) sg13_lv_nmos w=1u l=150n ng=1 m=1
M9 (net11 net4 VSS VSS) sg13_lv_nmos w=1u l=150n ng=1 m=1
R1 (VB1 net4) resistor r=1k
R2 (VB1 net0) resistor r=1k
R3 (net1 net13) resistor r=1k
R4 (net2 net14) resistor r=1k
X1 (net13 Vip net12 VB2) xfmr lp=1n ls=1n k=1
X2 (net14 Vin net15 VB2) xfmr lp=1n ls=1n k=1
