
* @RNL(type="header") {
*   @VERSION("0.3");
*   @USE-PACKAGE(name="rnl-std", version="0.3");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.1")
* }
.subckt dut VDD VSS VB1 Vout
C1 net0 net1 1p
L1 VDD Vout 1n
XM1 Vout VB1 net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
RB net0 VSS 1k
RS net1 net2 1k
VIN net2 VSS DC 1
* @RNL(author="analog-canvas") {
*   #C1 @SET-SYMBOL $CAPACITOR => @PLACE(29, -24) => @ORIENT("MXR90");
*   #RS @SET-SYMBOL $RESISTOR => @PLACE(25, -24) => @ORIENT("R270");
*   #VIN @SET-SYMBOL $VOLTAGE_SOURCE => @PLACE(18, -27);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(18, -31) => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(39, -33) => %gnd2;
*   $IO_PORT @ATTACH &VB1(p) => @SET-SYMBOL $CANVAS_PORT_FILLED => @PLACE(44, -19) => @ORIENT("R180") => %port1;
*   #L1 @SET-SYMBOL $INDUCTOR => @PLACE(39, -8);
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(39, -5) => %vdd1;
*   $IO_PORT @ATTACH &Vout(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(44, -14) => @ORIENT("R180") => %port2;
*   #XM1 @SET-SYMBOL $NMOS => @PLACE(39, -19) => @ORIENT("MY");
*   #RB @SET-SYMBOL $RESISTOR => @PLACE(39, -28);
*   &VDD @REMOVE-FROM $PORT_FILL_SET;
*   &VSS @REMOVE-FROM $PORT_FILL_SET;
*   %j1 = (39, -14);
*   $JUNCTION @ATTACH %j1;
*   %j2 = (39, -24);
*   $JUNCTION @ATTACH %j2;
*   &net2 @WIRE(mode="straight") {#RS:2 (18, -24) #VIN:1};
*   &VSS @WIRE(mode="straight") {%gnd1:p #VIN:2};
*   &VDD @WIRE(mode="straight") {#L1:1 %vdd1:p};
*   &Vout @WIRE(mode="straight") {#L1:2 %j1};
*   &Vout @WIRE(mode="straight") {%j1 %port2:p};
*   &Vout @WIRE(mode="straight") {#XM1:1 %j1};
*   &VB1 @WIRE(mode="straight") {#XM1:2 %port1:p};
*   &net0 @WIRE(mode="straight") {#C1:1 %j2};
*   &net0 @WIRE(mode="straight") {%j2 #XM1:3};
*   &net0 @WIRE(mode="straight") {%j2 #RB:1};
*   &VSS @WIRE(mode="straight") {#RB:2 %gnd2:p};
*   &net1 @WIRE(mode="straight") {#C1:2 #RS:1};
*   #C1 @TEXT("\textbf{\textit{C}}_{\textbf{1}}", key="name", dx=0, dy=1.7, halign="middle", valign="baseline", size=1.5116);
*   #RS @TEXT("\textbf{\textit{R}}_{\textbf{S}}", key="name", dx=0, dy=1.5, halign="middle", valign="baseline", size=1.5116);
*   #VIN @TEXT("\textbf{\textit{V}}_{\textbf{IN}}", key="name", dx=-6, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   %port1 @TEXT("\textbf{\textit{V}}_{\textbf{B1}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   #L1 @TEXT("\textbf{\textit{L}}_{\textbf{1}}", key="name", dx=1.2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   &VDD @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", size=1.5116) => @PLACE(40.5, -2.5) => %power1;
*   %port2 @TEXT("\textbf{\textit{V}}_{\textbf{out}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   #XM1 @TEXT("\textbf{\textit{M}}_{\textbf{1}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   #RB @TEXT("\textbf{\textit{R}}_{\textbf{B}}", key="name", dx=1.5, dy=-0.5, halign="start", valign="baseline", size=1.5116)
* }
.ends dut
