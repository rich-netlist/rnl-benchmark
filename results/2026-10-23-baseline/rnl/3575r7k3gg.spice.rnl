*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(8, -5) => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(24, -5) => %gnd2;
*   #XMPM0 @SET-SYMBOL $PMOS => @PLACE(16, 10);
*   $SUPPLY @ATTACH &AVDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(16, 12) => %vdd1;
*   $IO_PORT @ATTACH &ICTR(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(9, 10) => %port2;
*   #XI1 @SET-SYMBOL $NAND_2INPUT => @PLACE(0, -15);
