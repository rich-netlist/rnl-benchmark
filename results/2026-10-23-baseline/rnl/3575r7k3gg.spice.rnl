*   %port1 @TEXT("\textbf{\textit{V}}_{\textbf{OUT}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   #Xmp0 @TEXT("\textbf{\textit{m}}_{\textbf{p0}}", key="name", dx=-0.4, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   #Xmn0 @TEXT("\textbf{\textit{m}}_{\textbf{n0}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116);
