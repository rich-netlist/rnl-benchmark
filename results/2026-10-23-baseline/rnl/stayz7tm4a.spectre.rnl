//   @USE-PACKAGE(name="rnl-std-logic", version="0.3")
// }

// Ideal xor-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
subckt xor_gate (A B Y VDD VSS)
parameters vt=10m td=10p
BhA (hA 0) bsource v=0.5*(1+tanh((v(A,VSS)-0.5*v(VDD,VSS))/vt))
BhB (hB 0) bsource v=0.5*(1+tanh((v(B,VSS)-0.5*v(VDD,VSS))/vt))
Bf (nfn VSS) bsource v=v(VDD,VSS)*(v(hA)+v(hB)-2*v(hA)*v(hB))
Rd (nfn ndl) resistor r=1k
Cd (ndl VSS) capacitor c=td/1000
BY (Y VSS) bsource v=v(ndl,VSS)
ends xor_gate

subckt Main (VDD VSS Vin Voutp Voutn)
model DIODE diode is=1e-14 n=1
C1 (net1 VSS) capacitor c=1p
D1 (net1 Voutn) DIODE
D2 (net1 Voutp) DIODE
I1 (net2 VSS) isource dc=100u
L1 (VDD Voutn) inductor l=1n
L2 (VDD Voutp) inductor l=1n
M1 (Voutp Voutn net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (Voutn Voutp net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (net1 net0) resistor r=1k
X1 (Vin Voutn net0 VDD VSS) xor_gate
