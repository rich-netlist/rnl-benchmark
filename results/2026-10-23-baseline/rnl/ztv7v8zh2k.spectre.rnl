M29 (VON net4 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M30 (net6 net0 net10 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M31 (net6 net12 net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M32 (net4 net12 net11 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M33 (VOP net6 VDD VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M34 (net4 net0 net7 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M35 (VOP net1 VSS VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
R3 (net8 net4) resistor r=1k
R4 (net2 net6) resistor r=1k
