*       @TEXT("\frac{\textbf{1u}}{\textbf{0.15u}}", key="value", dx=-0.5, dy=-3.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=false);
*   $CANVAS_LABEL @ATTACH(bind="value") #XM6::value(label);
