*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM10::name(label);
*   #XM10
*       @TEXT("\frac{\textbf{4u}}{\textbf{0.15u}}", key="value", dx=-0.4, dy=-3.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=false);
*   $CANVAS_LABEL @ATTACH(bind="value") #XM10::value(label);
*   #XM11
*       @TEXT("\textbf{\textit{M}}_{\textbf{7}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   #XM11
*       @TEXT("\frac{\textbf{1u}}{\textbf{0.15u}}", key="value", dx=0.5, dy=-3.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=false);
*   $CANVAS_LABEL @ATTACH(bind="value") #XM11::value(label);
*   #XM12
*       @TEXT("\textbf{\textit{M}}_{\textbf{9}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
