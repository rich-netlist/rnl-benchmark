*   $CANVAS_LABEL @ATTACH(bind="value") #XM12::value(label);
*   &VDD @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", size=1.5116, bold=false) => @PLACE(30, 26) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   &VDD @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", size=1.5116, bold=false) => @PLACE(30, -8) => %power2;
