*       @TEXT("\frac{\textbf{4u}}{\textbf{0.15u}}", key="value", dx=0.4, dy=-3.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=false);
*   $CANVAS_LABEL @ATTACH(bind="value") #XM8::value(label);
