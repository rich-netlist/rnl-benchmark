//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt dut (vdd VSS lmt gn out)
parameters P_M9_w=20u P_M9_l=1u P_M10_w=20u P_M10_l=1u P_M11_w=20u P_M11_l=1u P_M12_w=20u P_M12_l=1u P_M7_w=20u P_M7_l=1u P_M8_w=20u P_M8_l=1u P_MNs_w=10u P_MNs_l=1u P_M4_w=20u P_M4_l=1u P_M5_w=20u P_M5_l=1u P_M6_w=20u P_M6_l=1u P_MN_w=100u P_MN_l=1u P_M1_w=20u P_M1_l=1u P_M2_w=20u P_M2_l=1u P_M3_w=20u P_M3_l=1u P_I3_dc=10u P_I1top_dc=10u P_I1bottom_dc=10u P_Itail_dc=10u P_Vgm_dc=1 P_VP_dc=1.5 P_Rext_value=100k
I_I3 (vdd net1) isource dc=P_I3_dc
I1bottom (net10 VSS) isource dc=P_I1bottom_dc
I1top (vdd net0) isource dc=P_I1top_dc
I2 (net8 VSS) isource dc=P_Itail_dc
M1 (gn net3 VSS VSS) IV_SKY_N_SI L=P_M1_l W=P_M1_w
M10 (net4 net6 vdd vdd) IV_SKY_P_SI L=P_M10_l W=P_M10_w
M11 (lmt net4 vdd vdd) IV_SKY_P_SI L=P_M11_l W=P_M11_w
M12 (net7 net4 vdd vdd) IV_SKY_P_SI L=P_M12_l W=P_M12_w
M2 (net5 net5 VSS VSS) IV_SKY_N_SI L=P_M2_l W=P_M2_w
M3 (net3 net5 VSS VSS) IV_SKY_N_SI L=P_M3_l W=P_M3_w
M4 (net1 net0 net7 VSS) IV_SKY_N_SI L=P_M4_l W=P_M4_w
M5 (net0 net0 out VSS) IV_SKY_N_SI L=P_M5_l W=P_M5_w
M6 (Vref net2 net1 vdd) IV_SKY_P_SI L=P_M6_l W=P_M6_w
M7 (net6 lmt net8 VSS) IV_SKY_N_SI L=P_M7_l W=P_M7_w
M8 (net4 net9 net8 VSS) IV_SKY_N_SI L=P_M8_l W=P_M8_w
M9 (net6 net6 vdd vdd) IV_SKY_P_SI L=P_M9_l W=P_M9_w
MN (out gn VSS VSS) IV_SKY_N_SI L=P_MN_l W=P_MN_w
MNs (net7 Vref VSS VSS) IV_SKY_N_SI L=P_MNs_l W=P_MNs_w
Q0 (net3 net10 gn) IV_SKY_PNP3 AREA=1
Q1 (net5 net10 Vref) IV_SKY_PNP3 AREA=1
Q2 (net10 net10 Vref) IV_SKY_PNP3 AREA=1
Rext (lmt VSS) resistor r=P_Rext_value
V1 (vdd net2) vsource dc=P_VP_dc
Vgm (net9 VSS) vsource dc=P_Vgm_dc
