M2 (Voutp Vinn net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net0 Vb VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (VDD Voutn) resistor r=1k
R2 (VDD Voutp) resistor r=1k
