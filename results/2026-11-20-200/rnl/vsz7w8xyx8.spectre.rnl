//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
//   @USE-PACKAGE(name="rnl-std-functional", version="0.4");
//   @USE-PACKAGE(name="rnl-std-logic", version="0.4")
// }

subckt icm_ideal_comparator_vdd (VIP VIN VOUT VDD)
parameters vlow=0 vtransition=1m
Bcmp (VOUT 0) bsource v=vlow+(v(VDD)-vlow)*0.5*(1+tanh((v(VIP)-v(VIN))/vtransition))
ends icm_ideal_comparator_vdd

// Ideal nand-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
subckt nand_gate (A B Y VDD VSS)
parameters vt=10m td=10p
BhA (hA 0) bsource v=0.5*(1+tanh((v(A,VSS)-0.5*v(VDD,VSS))/vt))
BhB (hB 0) bsource v=0.5*(1+tanh((v(B,VSS)-0.5*v(VDD,VSS))/vt))
Bf (nfn VSS) bsource v=v(VDD,VSS)*(1-v(hA)*v(hB))
Rd (nfn ndl) resistor r=1k
Cd (ndl VSS) capacitor c=td/1000
BY (Y VSS) bsource v=v(ndl,VSS)
ends nand_gate

subckt dut (VDD VSS S1 S2 S3 S4)
subckt ideal_switch (p n cp cn)
parameters ron=1 roff=1e12 vt=0.5
core (p n) bsource i=v(p,n)/(v(cp,cn)>vt ? ron : roff)
ends ideal_switch
C1 (net6 VSS) capacitor c=1p
C2 (net7 VSS) capacitor c=1p
R1 (net1 net6) resistor r=1k
R2 (net2 net7) resistor r=1k
S1 (VDD net1 S1 VSS) ideal_switch
S2 (net6 VSS S2 VSS) ideal_switch
S3 (VDD net2 S3 VSS) ideal_switch
S4 (net7 VSS S4 VSS) ideal_switch
X1 (net6 net8 net3 VDD) icm_ideal_comparator_vdd vlow=0 vtransition=1m
X2 (net7 net8 net4 VDD) icm_ideal_comparator_vdd vlow=0 vtransition=1m
X3 (net3 net0 net5 VDD VSS) nand_gate td=10p vt=10m
X4 (net5 net4 net0 VDD VSS) nand_gate td=10p vt=10m
