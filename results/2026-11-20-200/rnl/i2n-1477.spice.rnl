*   @DEVICE(model="sky130_fd_pr__npn_05v5_W1p00L1p00", terminals=["c", "b", "e", "s"], type="npn");
*   @DEVICE(model="sky130_fd_pr__pnp_05v5_W0p68L0p68", terminals=["c", "b", "e"], type="pnp")
* }
* Potentiometer: end 1 to wiper r*pos, wiper to end 2 r*(1-pos)
.subckt potentiometer n1 nw n2 params: r=10k pos=0.5
R1 n1 nw {max(r*pos,1m)}
R2 nw n2 {max(r*(1-pos),1m)}
.ends potentiometer

.subckt dut +55V -55V +34V -34V VSS Input Output
.model DIODE D(IS=1e-14 N=1)
.model NJF NJF(VTO=-2 BETA=1e-3 LAMBDA=0.01)
.model PJF PJF(VTO=-2 BETA=1e-3 LAMBDA=0.01)
.model icm_zener_D3 D(BV=5.1)
.model icm_zener_D4 D(BV=6.2)
C1 net16 VSS 1p
C2 net7 VSS 1p
C3 FB Output 20pF
C4 net0 net25 3pF
D1 net23 net2 DIODE
