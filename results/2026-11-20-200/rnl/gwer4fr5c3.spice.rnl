.subckt inv vdd VSS A Y
XMN Y A VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=0.42 nf=1 m=1
XMP Y A vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=0.55 nf=1 m=1
* @RNL(author="analog-canvas") {
*   %inv_SYMBOL = @DEFINE-SYMBOL(box=[-5, -5, 5, 5]) {
*     (0, 5) @PIN(terminal="vdd", label="\textbf{\textit{v}}_{\textbf{dd}}", direction="up");
*     (-5, 0) @PIN(terminal="A", label="\textbf{\textit{A}}", direction="left");
*     (5, 0) @PIN(terminal="Y", label="\textbf{\textit{Y}}", direction="right");
*     (0, 0) @RECTANGLE(width=8, height=8);
*     @LINE {(0, 5) (0, 4)};
*     @LINE {(-5, 0) (-4, 0)};
*     @LINE {(5, 0) (4, 0)}
*   };
*   # @SET-SYMBOL %inv_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XMP @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(0, 6) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP") #XMP(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMP(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="w", text="0.55u") #XMP(part);
*   #XMN @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(0, -2) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MN") #XMN(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMN(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="w", text="0.42u") #XMN(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(0, -4) => @ORIENT("R0") => %gnd1;
*   $SUPPLY @ATTACH &vdd(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(0, 8) => @ORIENT("R0") => %vdd1;
*   $IO_PORT @ATTACH &A(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-8, 2) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &Y(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(4, 2) => @ORIENT("MY") => %port2;
*   %j1 = (-5, 2);
*   %j2 = (0, 2);
*   &Y @WIRE(mode="straight") {#XMP:1 %j2};
*   &Y @WIRE(mode="straight") {%j2 #XMN:1};
*   &A @WIRE(mode="straight") {#XMP:2 (-5, 6) %j1};
*   &A @WIRE(mode="straight") {%j1 (-5, -2) #XMN:2};
*   &A @WIRE(mode="straight") {%port1::pin %j1};
*   &Y @WIRE(mode="straight") {%port2::pin %j2};
*   $JUNCTION @ATTACH %j2(p) => @PLACE(0, 2) => %dot1;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(-5, 2) => %dot2;
*   &vdd @WIRE(mode="straight") {#XMP:3 %vdd1::pin};
*   &VSS @WIRE(mode="straight") {%gnd1::pin #XMN:3};
*   #XMP
*       @TEXT("\textbf{\textit{M}}_{\textbf{P}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMP::name(label);
*   #XMN
*       @TEXT("\textbf{\textit{M}}_{\textbf{N}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN::name(label);
*   %vdd1 @TEXT("\textbf{\textit{v}}_{\textbf{dd}}", dx=-1.3, dy=3, size=1.5116, bold=false) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   %port1
*       @TEXT("\textbf{\textit{A}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{Y}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %vdd1 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends inv

