*   #XMP7 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(84, 6) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP7") #XMP7(part);
*   #XMN7 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(84, -2) => @ORIENT("R0");
