.subckt non_overlap vdd VSS clk p2 p1
XI0 vdd VSS clk net0 inv
XI1 vdd VSS net2 net0 net3 nand
XI2 vdd VSS net3 p1 delay_chain
XI3 vdd VSS clk p1 net1 nand
XI4 vdd VSS net1 net2 delay_chain
XI5 vdd VSS net2 p2 inv
* @RNL(author="analog-canvas") {
*   %non_overlap_SYMBOL = @DEFINE-SYMBOL(box=[-5, -5, 5, 5]) {
*     (-5, 0) @PIN(terminal="clk", label="\textbf{\textit{clk}}", direction="left");
*     (5, -2) @PIN(terminal="p2", label="\textbf{\textit{p2}}", direction="right");
*     (5, 2) @PIN(terminal="p1", label="\textbf{\textit{p1}}", direction="right");
*     (0, 5) @PIN(terminal="vdd", label="\textbf{\textit{v}}_{\textbf{dd}}", direction="up");
*     (0, 0) @RECTANGLE(width=8, height=8);
*     @LINE {(-5, 0) (-4, 0)};
*     @LINE {(5, -2) (4, -2)};
*     @LINE {(5, 2) (4, 2)};
*     @LINE {(0, 5) (0, 4)}
*   };
*   # @SET-SYMBOL %non_overlap_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XI4 @PLACE(31, 0) => @ORIENT("R0");
*   #XI2 @PLACE(31, -20) => @ORIENT("R0");
*   $IO_PORT @ATTACH &clk(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(6, -21) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &p2(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(49, 0) => @ORIENT("MY") => %port2;
*   $IO_PORT @ATTACH &p1(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(45, -20) => @ORIENT("MY") => %port3;
*   $SUPPLY @ATTACH &vdd(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(31, 5) => @ORIENT("R0") => %vdd1;
*   $SUPPLY @ATTACH &vdd(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(31, -15) => @ORIENT("R0") => %vdd2;
*   #XI3 @SET-SYMBOL $CANVAS_CALL_NAND_GATE__0_0_1_2_3 => @PLACE(20, 0) => @ORIENT("R0");
*   #XI5 @SET-SYMBOL $CANVAS_CALL_INVERTER__0_0_1_2 => @PLACE(45, 0) => @ORIENT("R0");
*   #XI0 @SET-SYMBOL $CANVAS_CALL_INVERTER__0_0_1_2 => @PLACE(13, -21) => @ORIENT("MX");
*   #XI1 @SET-SYMBOL $CANVAS_CALL_NAND_GATE__0_0_1_2_3 => @PLACE(20, -20) => @ORIENT("R0");
*   %j1 = (39, 0);
*   %j2 = (8, -21);
*   %j3 = (40, -20);
*   &p1 @WIRE(mode="straight") {#XI2:4 %j3};
*   &p1 @WIRE(mode="straight") {%j3 %port3::pin};
*   &net3 @WIRE(mode="straight") {#XI1:5 #XI2:3};
*   &net1 @WIRE(mode="straight") {#XI3:5 #XI4:3};
*   &net2 @WIRE(mode="straight") {#XI4:4 %j1};
*   &net2 @WIRE(mode="straight") {%j1 #XI5:3};
*   &p2 @WIRE(mode="straight") {#XI5:4 %port2::pin};
*   &net0 @WIRE(mode="straight") {#XI0:4 #XI1:4};
*   &net2 @WIRE(mode="straight") {#XI1:3 (16, -19) (16, -10) (39, -10) %j1};
*   &clk @WIRE(mode="straight") {#XI0:3 %j2};
*   &clk @WIRE(mode="straight") {%j2 %port1::pin};
*   &clk @WIRE(mode="straight") {%j2 (8, 1) #XI3:3};
*   &p1 @WIRE(mode="straight") {#XI3:4 (16, -1) (16, -9) (40, -9) %j3};
*   $JUNCTION @ATTACH %j2(p) => @PLACE(8, -21) => %dot1;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(39, 0) => %dot2;
*   $JUNCTION @ATTACH %j3(p) => @PLACE(40, -20) => %dot3;
*   &vdd @WIRE(mode="straight") {%vdd2::pin #XI2:1};
*   &vdd @WIRE(mode="straight") {%vdd1::pin #XI4:1};
*   #XI4
*       @TEXT("\textbf{delay\_chain}", key="value", dx=0, dy=-5.5, halign="middle", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   #XI2
*       @TEXT("\textbf{delay\_chain}", key="value", dx=0, dy=-5.5, halign="middle", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   %port1
*       @TEXT("\textbf{\textit{clk}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{p2}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %port3
*       @TEXT("\textbf{\textit{p1}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
*   %vdd1 @TEXT("\textbf{\textit{v}}_{\textbf{dd}}", dx=-1.3, dy=3, size=1.5116, bold=false) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   %vdd2 @TEXT("\textbf{\textit{v}}_{\textbf{dd}}", dx=-1.3, dy=3, size=1.5116, bold=false) => %power2;
*   $CANVAS_LABEL @ATTACH(bind="port") %power2(label);
*   #XI3
*       @TEXT("\textbf{\textit{XI}}_{\textbf{3}}", key="name", dx=0, dy=-3, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XI3::name(label);
*   #XI5
*       @TEXT("\textbf{\textit{XI}}_{\textbf{5}}", key="name", dx=-0.5, dy=-2.9, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XI5::name(label);
*   #XI0
*       @TEXT("\textbf{\textit{XI}}_{\textbf{0}}", key="name", dx=-0.5, dy=2.3, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XI0::name(label);
*   #XI1
*       @TEXT("\textbf{\textit{XI}}_{\textbf{1}}", key="name", dx=0, dy=-3, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XI1::name(label);
*   %vdd1 @TEXT("${p}", key="netname", textvisible=false);
*   %vdd2 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends non_overlap

.subckt half_bridge vDD VSS clk_in sw
XMNM0 sw g2 VSS VSS sky130_fd_pr__nfet_01v8_lvt l=0.15 w=50 nf=1 m=1024
XMPM0 sw g1 vDD vDD sky130_fd_pr__pfet_01v8 l=0.15 w=50 nf=1 m=4096
Xbuffer vDD VSS net1 g1 buffer
XbufferN vDD VSS net0 g2 bufferN
Xnon_overlap vDD VSS clk_in net0 net1 non_overlap
* @RNL(author="analog-canvas") {
*   %half_bridge_SYMBOL = @DEFINE-SYMBOL(box=[-7, -4, 7, 4]) {
*     (7, 1) @PIN(terminal="vDD", label="\textbf{\textit{v}}_{\textbf{DD}}", direction="right");
*     (-7, 0) @PIN(terminal="clk_in", label="\textbf{\textit{clk}}_{\textbf{\textit{in}}}", direction="left");
*     (7, -1) @PIN(terminal="sw", label="\textbf{\textit{sw}}", direction="right");
*     (0, 0) @RECTANGLE(width=12, height=6);
*     @LINE {(7, 1) (6, 1)};
*     @LINE {(-7, 0) (-6, 0)};
*     @LINE {(7, -1) (6, -1)}
*   };
*   # @SET-SYMBOL %half_bridge_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #Xnon_overlap @PLACE(0, 0) => @ORIENT("R0");
*   #XMPM0 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(23, 4) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MPM0") #XMPM0(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMPM0(part);
*   #XMNM0 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(23, -4) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MNM0") #XMNM0(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMNM0(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(23, -6) => @ORIENT("R0") => %gnd1;
*   $SUPPLY @ATTACH &vDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(23, 6) => @ORIENT("R0") => %vdd1;
*   $SUPPLY @ATTACH &vDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(0, 5) => @ORIENT("R0") => %vdd2;
*   $IO_PORT @ATTACH &clk_in(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-10, 0) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &sw(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(28, -1) => @ORIENT("MY") => %port2;
