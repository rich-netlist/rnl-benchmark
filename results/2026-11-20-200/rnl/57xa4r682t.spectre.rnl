subckt cmfb_amp (vdd VSS vsense vocm vbn vctrl)
CCM (vdd vctrl) capacitor c=500f
MC1 (net1 vsense net0 VSS) sky130_fd_pr__nfet_01v8_lvt l=0.5 w=24 nf=4 m=1
MC2 (vctrl vocm net2 VSS) sky130_fd_pr__nfet_01v8_lvt l=0.5 w=24 nf=4 m=1
MCL1 (net1 net1 vdd vdd) sky130_fd_pr__pfet_01v8 l=1 w=48 nf=4 m=1
MCL2 (vctrl vctrl vdd vdd) sky130_fd_pr__pfet_01v8 l=1 w=48 nf=4 m=1
MCTA (net0 vbn VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=8 nf=2 m=1
MCTB (net2 vbn VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=8 nf=2 m=1
RCM (net2 net0) resistor r=5k
