subckt fd_ota_c_biquad (vdd VSS iref vinp vinn voutp voutn vbpp vbpn vocm)
C1N (vbpn VSS) capacitor c=8p
C1P (vbpp VSS) capacitor c=8p
C2N (voutn VSS) capacitor c=4p
C2P (voutp VSS) capacitor c=4p
MREF (iref iref VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=16 nf=2 m=1
RS1A (vbpp sense1) resistor r=1M
RS1B (sense1 vbpn) resistor r=1M
RS2A (voutp sense2) resistor r=1M
RS2B (sense2 voutn) resistor r=1M
XCM1 (vdd VSS sense1 vocm iref vc1) cmfb_amp_bp
XCM2 (vdd VSS sense2 vocm iref vc2) cmfb_amp
XGB (vdd VSS voutp voutn iref vbpp vbpn vc1) gmc_core_bp
XGF (vdd VSS vbpp vbpn iref voutn voutp vc2) gmc_core
XGIN (vdd VSS vinp vinn iref vbpn vbpp vc1) gmc_core_bp
XGQ (VSS vbpp vbpn iref vbpp vbpn) gmc_sink
