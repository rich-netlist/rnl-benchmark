.subckt sc_nand vdd vss a b y
XMN1 y a net0 vss sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=2 m=1
XMN2 net0 b vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=2 m=1
XMP1 y a vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=4 nf=2 m=1
XMP2 y b vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=4 nf=2 m=1
* @RNL(author="analog-canvas") {
*   %sc_nand_SYMBOL = @DEFINE-SYMBOL(box=[-5, -5, 5, 5]) {
*     (-5, 0) @PIN(terminal="a", label="\textbf{\textit{a}}", direction="left");
*     (-5, 2) @PIN(terminal="b", label="\textbf{\textit{b}}", direction="left");
*     (5, 0) @PIN(terminal="y", label="\textbf{\textit{y}}", direction="right");
*     (5, 2) @PIN(terminal="vdd", label="\textbf{\textit{v}}_{\textbf{dd}}", direction="right");
*     (0, -5) @PIN(terminal="vss", label="\textbf{\textit{v}}_{\textbf{ss}}", direction="down");
*     (0, 0) @RECTANGLE(width=8, height=8);
*     @LINE {(-5, 0) (-4, 0)};
*     @LINE {(-5, 2) (-4, 2)};
*     @LINE {(5, 0) (4, 0)};
*     @LINE {(5, 2) (4, 2)};
*     @LINE {(0, -5) (0, -4)}
*   };
*   # @SET-SYMBOL %sc_nand_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XMP1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(0, 8) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP1") #XMP1(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMP1(part);
*   #XMP2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(10, 8) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MP2") #XMP2(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMP2(part);
*   #XMN1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(0, 0) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MN1") #XMN1(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMN1(part);
*   #XMN2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(0, -7) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MN2") #XMN2(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMN2(part);
*   $IO_PORT @ATTACH &a(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-9, 4) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &b(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-9, -7) => @ORIENT("R0") => %port2;
*   $IO_PORT @ATTACH &y(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(17, 4) => @ORIENT("MY") => %port3;
*   $IO_PORT @ATTACH &vdd(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(5, 13) => @ORIENT("R270") => %port4;
*   $IO_PORT @ATTACH &vss(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(0, -11) => @ORIENT("R90") => %port5;
*   %j1 = (-3, 4);
*   %j2 = (0, 4);
*   %j3 = (10, 4);
*   %j4 = (16, 8);
*   %j5 = (5, 11);
*   &a @WIRE(mode="straight") {#XMP1:2 %j1};
*   &a @WIRE(mode="straight") {%j1 #XMN1:2};
*   &a @WIRE(mode="straight") {%port1::pin %j1};
*   &y @WIRE(mode="straight") {#XMP1:1 %j2};
*   &y @WIRE(mode="straight") {%j2 #XMN1:1};
*   &y @WIRE(mode="straight") {#XMP2:1 %j3};
*   &y @WIRE(mode="straight") {%j3 %j2};
*   &y @WIRE(mode="straight") {%port3::pin %j3};
*   &net0 @WIRE(mode="straight") {#XMN1:3 #XMN2:1};
*   &b @WIRE(mode="straight") {%port2::pin #XMN2:2};
*   &b @WIRE(mode="straight") {#XMP2:2 %j4} => %wire1;
*   &vdd @WIRE(mode="straight") {%port4::pin %j5};
*   &vdd @WIRE(mode="straight") {%j5 (0, 11) #XMP1:3};
*   &vdd @WIRE(mode="straight") {#XMP2:3 (10, 11) %j5};
*   &vss @WIRE(mode="straight") {%port5::pin #XMN2:3};
*   $JUNCTION @ATTACH %j5(p) => @PLACE(5, 11) => %dot1;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(0, 4) => %dot2;
*   $JUNCTION @ATTACH %j3(p) => @PLACE(10, 4) => %dot3;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(-3, 4) => %dot4;
*   #XMP1
*       @TEXT("\textbf{\textit{M}}_{\textbf{P1}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMP1::name(label);
*   #XMP2
*       @TEXT("\textbf{\textit{M}}_{\textbf{P2}}", key="name", dx=-0.4, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMP2::name(label);
*   #XMN1
*       @TEXT("\textbf{\textit{M}}_{\textbf{N1}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN1::name(label);
*   #XMN2
*       @TEXT("\textbf{\textit{M}}_{\textbf{N2}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN2::name(label);
*   %port1
*       @TEXT("\textbf{\textit{a}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{b}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %port3
*       @TEXT("\textbf{\textit{y}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
*   %port4
*       @TEXT("\textbf{\textit{v}}_{\textbf{dd}}", key="netname", dx=0, dy=1.9, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::netname(label);
*   %port5
*       @TEXT("\textbf{\textit{v}}_{\textbf{ss}}", key="netname", dx=0, dy=-2.8, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port5::netname(label);
*   %wire1 @TEXT("\textbf{\textit{b}}", halign="middle", size=1.5116, bold=false) => @PLACE(15, 8.4) => %label1;
*   $CANVAS_LABEL @ATTACH(bind="net") %label1(label)
* }
