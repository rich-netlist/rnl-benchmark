
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @DEVICE(model="sky130_fd_pr__nfet_01v8", terminals=["d", "g", "s", "b"], type="nmos");
*   @DEVICE(model="sky130_fd_pr__pfet_01v8", terminals=["d", "g", "s", "b"], type="pmos")
* }
.subckt sc_inv vdd vss a y
XMN y a vss vss sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMP y a vdd vdd sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1 m=1
* @RNL(author="analog-canvas") {
*   %sc_inv_SYMBOL = @DEFINE-SYMBOL(box=[-5, -5, 5, 5]) {
*     (-5, 0) @PIN(terminal="a", label="\textbf{\textit{a}}", direction="left");
*     (5, 0) @PIN(terminal="y", label="\textbf{\textit{y}}", direction="right");
*     (-5, 2) @PIN(terminal="vdd", label="\textbf{\textit{v}}_{\textbf{dd}}", direction="left");
*     (0, -5) @PIN(terminal="vss", label="\textbf{\textit{v}}_{\textbf{ss}}", direction="down");
*     (0, 0) @RECTANGLE(width=8, height=8);
*     @LINE {(-5, 0) (-4, 0)};
*     @LINE {(5, 0) (4, 0)};
*     @LINE {(-5, 2) (-4, 2)};
*     @LINE {(0, -5) (0, -4)}
*   };
*   # @SET-SYMBOL %sc_inv_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XMP @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(0, 4) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP") #XMP(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMP(part);
*   #XMN @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(0, -4) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MN") #XMN(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMN(part);
*   $IO_PORT @ATTACH &a(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-7, 0) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &y(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(6, 0) => @ORIENT("MY") => %port2;
*   $IO_PORT @ATTACH &vdd(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(0, 9) => @ORIENT("R270") => %port3;
*   $IO_PORT @ATTACH &vss(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(0, -9) => @ORIENT("R90") => %port4;
*   %j1 = (-3, 0);
*   %j2 = (0, 0);
*   &a @WIRE(mode="straight") {#XMP:2 %j1};
*   &a @WIRE(mode="straight") {%j1 #XMN:2};
*   &a @WIRE(mode="straight") {%port1::pin %j1};
*   &y @WIRE(mode="straight") {#XMP:1 %j2};
*   &y @WIRE(mode="straight") {%j2 #XMN:1};
*   &y @WIRE(mode="straight") {%port2::pin %j2};
*   &vdd @WIRE(mode="straight") {%port3::pin #XMP:3};
*   &vss @WIRE(mode="straight") {%port4::pin #XMN:3};
*   $JUNCTION @ATTACH %j2(p) => @PLACE(0, 0) => %dot1;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(-3, 0) => %dot2;
*   #XMP
*       @TEXT("\textbf{\textit{M}}_{\textbf{P}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMP::name(label);
*   #XMN
*       @TEXT("\textbf{\textit{M}}_{\textbf{N}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN::name(label);
*   %port1
*       @TEXT("\textbf{\textit{a}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{y}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %port3
*       @TEXT("\textbf{\textit{v}}_{\textbf{dd}}", key="netname", dx=0, dy=1.9, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
*   %port4
*       @TEXT("\textbf{\textit{v}}_{\textbf{ss}}", key="netname", dx=0, dy=-2.8, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::netname(label)
* }
.ends sc_inv

