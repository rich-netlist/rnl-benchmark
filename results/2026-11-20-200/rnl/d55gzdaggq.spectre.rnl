simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt icm_opamp_vdd_vss (VIP VIN VDD VSS VOUT)
parameters gain=1e6
Blin (nlin 0) bsource v=gain*(v(VIP)-v(VIN))
Bcore (VOUT 0) bsource v=0.5*(v(VDD)+(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12)))-sqrt((v(VDD)-(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))))*(v(VDD)-(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))
ends icm_opamp_vdd_vss

subckt dut (VDD VSS Vx Vy Vsum)
model DIODE diode is=1e-14 n=1
C1 (net0 VSS) capacitor c=1p
C2 (net3 net6) capacitor c=1p
C3 (net4 net7) capacitor c=1p
C4 (net5 net1) capacitor c=1p
C5 (net2 net8) capacitor c=1p
D3 (net6 net0) DIODE
D4 (net7 net0) DIODE
D5 (net1 net0) DIODE
D6 (net8 net0) DIODE
R1 (net0 VDD) resistor r=1k
R10 (net12 VSS) resistor r=1k
R11 (Vx net9) resistor r=1k
R12 (net10 net2) resistor r=1k
R13 (net10 net5) resistor r=1k
R14 (net13 net4) resistor r=1k
R15 (net13 net3) resistor r=1k
R16 (net13 VSS) resistor r=1k
R17 (Vy net10) resistor r=1k
R18 (net11 net4) resistor r=1k
R19 (net11 net2) resistor r=1k
R2 (net3 net6) resistor r=1k
R20 (net11 net3) resistor r=1k
R21 (net11 net5) resistor r=1k
R23 (Vsum net11) resistor r=1k
R3 (net4 net7) resistor r=1k
R4 (net5 net1) resistor r=1k
R5 (net2 net8) resistor r=1k
R6 (net9 net3) resistor r=1k
R7 (net9 net2) resistor r=1k
R8 (net12 net4) resistor r=1k
R9 (net12 net5) resistor r=1k
X1 (VSS net6 VDD VSS net3) icm_opamp_vdd_vss gain=1e6
X2 (VSS net7 VDD VSS net4) icm_opamp_vdd_vss gain=1e6
X3 (VSS net1 VDD VSS net5) icm_opamp_vdd_vss gain=1e6
X4 (VSS net8 VDD VSS net2) icm_opamp_vdd_vss gain=1e6
X5 (net12 net9 VDD VSS Vx) icm_opamp_vdd_vss gain=1e6
X6 (net13 net10 VDD VSS Vy) icm_opamp_vdd_vss gain=1e6
X7 (VSS net11 VDD VSS Vsum) icm_opamp_vdd_vss gain=1e6
