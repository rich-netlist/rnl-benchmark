
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt Main VDD VSS Vin Vo_meas Vctrl Vbp Vbn
.model NMOS nmos level=54
.model PMOS pmos level=54
C1 net1 net0 1p
C2 net5 VSS 1p
C3 VSS VSS 1p
C4 Vo_meas VSS 1p
L1 VSS net1 1n
M1 net4 net4 net2 VSS NMOS l=150n m=1 nf=1 w=1u
M10 net3 Vbn VSS VSS NMOS l=150n m=1 nf=1 w=1u
M11 VSS net5 VSS VSS NMOS l=150n m=1 nf=1 w=1u
M12 VSS Vbp VDD VDD PMOS l=150n m=1 nf=1 w=1u
M13 VSS Vctrl net5 VSS NMOS l=150n m=1 nf=1 w=1u
M14 VSS VSS VSS VSS NMOS l=150n m=1 nf=1 w=1u
M16 VDD Vbp VSS VSS NMOS l=150n m=1 nf=1 w=1u
M2 net6 net4 VSS VSS NMOS l=150n m=1 nf=1 w=1u
M3 net6 net6 VDD VDD PMOS l=150n m=1 nf=1 w=1u
M4 net4 net6 VDD VDD PMOS l=150n m=1 nf=1 w=1u
M5 net6 net6 net4 VSS NMOS l=150n m=1 nf=1 w=1u
M6 net7 Vin net3 VSS NMOS l=150n m=1 nf=1 w=1u
M7 Vo_meas Vo_meas net3 VSS NMOS l=150n m=1 nf=1 w=1u
M8 VDD net7 net7 VSS NMOS l=150n m=1 nf=1 w=1u
M9 VDD net7 Vo_meas VSS NMOS l=150n m=1 nf=1 w=1u
R1 net2 VSS 1k
R2 net0 net5 1k
* @RNL(author="analog-canvas") {
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #M1 @SET-SYMBOL $NMOS => @PLACE(9, -37) => @ORIENT("MY");
*   #M2 @SET-SYMBOL $NMOS => @PLACE(18, -37) => @ORIENT("R0");
*   #R1 @SET-SYMBOL $RESISTOR => @PLACE(9, -43) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(9, -45) => @ORIENT("R0") => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(18, -41) => @ORIENT("R0") => %gnd2;
*   #M3 @SET-SYMBOL $PMOS => @PLACE(18, -27) => @ORIENT("R0");
*   #M4 @SET-SYMBOL $PMOS => @PLACE(9, -27) => @ORIENT("MY");
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(9, -24) => @ORIENT("R0") => %vdd1;
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(18, -24) => @ORIENT("R0") => %vdd2;
*   #M5 @SET-SYMBOL $NMOS => @PLACE(14, -32) => @ORIENT("R0");
*   #M6 @SET-SYMBOL $NMOS => @PLACE(54, -37) => @ORIENT("R0");
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(54, -24) => @ORIENT("R0") => %vdd3;
*   #M7 @SET-SYMBOL $NMOS => @PLACE(62, -37) => @ORIENT("MY");
*   #M8 @SET-SYMBOL $NMOS => @PLACE(54, -27) => @ORIENT("MY");
*   #M9 @SET-SYMBOL $NMOS => @PLACE(62, -27) => @ORIENT("R0");
*   #M10 @SET-SYMBOL $NMOS => @PLACE(58, -43) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(58, -45) => @ORIENT("R0") => %gnd3;
*   $IO_PORT @ATTACH &Vin(p) => @SET-SYMBOL $CANVAS_PORT_FILLED => @PLACE(51, -37) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &Vo_meas(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(67, -33) => @ORIENT("R180") => %port2;
*   #M11 @SET-SYMBOL $NMOS => @PLACE(33, -37) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(33, -41) => @ORIENT("R0") => %gnd4;
*   #M12 @SET-SYMBOL $PMOS => @PLACE(33, -27) => @ORIENT("R0");
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(33, -24) => @ORIENT("R0") => %vdd4;
*   #M13 @SET-SYMBOL $NMOS => @PLACE(29, -33) => @ORIENT("R270");
*   $IO_PORT @ATTACH &Vctrl(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(28, -30) => @ORIENT("R0") => %port3;
*   $IO_PORT @ATTACH &Vbp(p) => @SET-SYMBOL $CANVAS_PORT_FILLED => @PLACE(29, -27) => @ORIENT("R0") => %port4;
*   #M14 @SET-SYMBOL $NMOS => @PLACE(41, -37) => @ORIENT("R0");
*   #M16 @SET-SYMBOL $NMOS => @PLACE(41, -27) => @ORIENT("R0");
*   #R2 @SET-SYMBOL $RESISTOR => @PLACE(33, -47) => @ORIENT("R270");
*   #C1 @SET-SYMBOL $CAPACITOR => @PLACE(37, -47) => @ORIENT("R270");
*   #L1 @SET-SYMBOL $INDUCTOR => @PLACE(41, -47) => @ORIENT("R270");
*   #C2 @SET-SYMBOL $CAPACITOR => @PLACE(29, -49) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(29, -51) => @ORIENT("R0") => %gnd5;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(45, -51) => @ORIENT("R0") => %gnd6;
*   #C3 @SET-SYMBOL $CAPACITOR => @PLACE(45, -49) => @ORIENT("R0");
*   #C4 @SET-SYMBOL $CAPACITOR => @PLACE(66, -40) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(66, -42) => @ORIENT("R0") => %gnd7;
*   $IO_PORT @ATTACH &Vbn(p) => @SET-SYMBOL $CANVAS_PORT_FILLED => @PLACE(55, -43) => @ORIENT("R0") => %port5;
*   %j1 = (9, -23);
*   %j2 = (18, -23);
*   %j3 = (9, -34);
*   %j4 = (18, -30);
*   %j5 = (14, -27);
