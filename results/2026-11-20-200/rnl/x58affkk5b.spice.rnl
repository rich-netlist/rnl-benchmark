*   $CANVAS_NAME @ATTACH(name="M3") #XM3(part);
*   #XM4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(50, -53) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M4") #XM4(part);
*   #XM5 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(44, -41) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M5") #XM5(part);
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(44, -39) => @ORIENT("R0") => %vdd1;
*   $IO_PORT @ATTACH &Vip(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(35, -47) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &Vin(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(53, -47) => @ORIENT("MY") => %port2;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(44, -58) => @ORIENT("R0") => %gnd1;
*   $IO_PORT @ATTACH &VB(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(41, -41) => @ORIENT("R0") => %port3;
*   %j1 = (38, -50);
*   %j2 = (50, -50);
*   %j3 = (44, -44);
*   %j4 = (44, -56);
*   &net0 @WIRE(mode="straight") {#XM3:1 %j1};
*   &net0 @WIRE(mode="straight") {%j1 #XM1:1};
*   &net1 @WIRE(mode="straight") {#XM2:1 %j2};
*   &net1 @WIRE(mode="straight") {%j2 #XM4:1};
*   &VSS @WIRE(mode="straight") {#XM3:3 (38, -56) %j4};
*   &VSS @WIRE(mode="straight") {%j4 (50, -56) #XM4:3};
*   &net0 @WIRE(mode="straight") {#XM3:2 (42, -53) (42, -50) %j1};
*   &net1 @WIRE(mode="straight") {#XM4:2 (46, -53) (46, -50) %j2};
*   &net2 @WIRE(mode="straight") {#XM1:3 (38, -44) %j3};
*   &net2 @WIRE(mode="straight") {#XM5:1 %j3};
*   &net2 @WIRE(mode="straight") {%j3 (50, -44) #XM2:3};
*   &VSS @WIRE(mode="straight") {%gnd1::pin %j4};
*   &VDD @WIRE(mode="straight") {#XM5:3 %vdd1::pin};
*   &Vip @WIRE(mode="straight") {#XM1:2 %port1::pin};
*   &Vin @WIRE(mode="straight") {#XM2:2 %port2::pin};
*   &VB @WIRE(mode="straight") {#XM5:2 %port3::pin};
*   $JUNCTION @ATTACH %j4(p) => @PLACE(44, -56) => %dot1;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(38, -50) => %dot2;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(50, -50) => %dot3;
*   $JUNCTION @ATTACH %j3(p) => @PLACE(44, -44) => %dot4;
*   #XM1
*       @TEXT("\textbf{\textit{M}}_{\textbf{1}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM1::name(label);
*   #XM2
*       @TEXT("\textbf{\textit{M}}_{\textbf{2}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM2::name(label);
*   #XM3
*       @TEXT("\textbf{\textit{M}}_{\textbf{3}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM3::name(label);
*   #XM4
*       @TEXT("\textbf{\textit{M}}_{\textbf{4}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM4::name(label);
*   #XM5
*       @TEXT("\textbf{\textit{M}}_{\textbf{5}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM5::name(label);
*   %vdd1 @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", dx=2, dy=1, size=1.5116, bold=false) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   %port1
*       @TEXT("\textbf{\textit{V}}_{\textbf{ip}}", key="netname", dx=-1.5, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{V}}_{\textbf{in}}", key="netname", dx=1.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %port3
*       @TEXT("\textbf{\textit{V}}_{\textbf{B}}", key="netname", dx=-2, dy=-1, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
*   %vdd1 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends dut
