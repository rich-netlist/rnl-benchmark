subckt StrongARM_16um (VIP VIN CLK OP OM VDD VSS)
M1 (net1 VIP S VSS) DRAW_NMOS l=30n m=1 w=8u
M2 (net0 VIN S VSS) DRAW_NMOS l=30n m=1 w=8u
M3 (OM OP net1 VSS) DRAW_NMOS l=30n m=1 w=3.4u
M4 (OP OM net0 VSS) DRAW_NMOS l=30n m=1 w=3.4u
M5 (OM OP VDD VDD) DRAW_PMOS l=30n m=1 w=2u
M6 (OP OM VDD VDD) DRAW_PMOS l=30n m=1 w=2u
M7 (S CLK VSS VSS) DRAW_NMOS l=30n m=1 w=2u
MS1 (net1 CLK VDD VDD) DRAW_PMOS l=30n m=1 w=1u
MS2 (net0 CLK VDD VDD) DRAW_PMOS l=30n m=1 w=1u
MS3 (OM CLK VDD VDD) DRAW_PMOS l=30n m=1 w=1u
MS4 (OP CLK VDD VDD) DRAW_PMOS l=30n m=1 w=1u
