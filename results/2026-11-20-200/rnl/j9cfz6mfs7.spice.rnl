*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @USE-PACKAGE(name="rnl-std-functional", version="0.4");
*   @DEVICE(model="sky130_fd_pr__pfet_01v8", terminals=["d", "g", "s", "b"], type="pmos");
*   @DEVICE(model="sky130_fd_pr__nfet_01v8", terminals=["d", "g", "s", "b"], type="nmos")
* }
.subckt ideal_chopper INP INN OUTP OUTN CK
S1 INP OUTP CK 0 chopper_straight
S2 INN OUTN CK 0 chopper_straight
S3 INP OUTN 0 CK chopper_crossed
S4 INN OUTP 0 CK chopper_crossed
.model chopper_straight SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
.model chopper_crossed SW(RON=1 ROFF=1e12 VT=-0.5 VH=0)
.ends ideal_chopper

