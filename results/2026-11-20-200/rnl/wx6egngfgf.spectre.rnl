simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt voltage_amplifier (VIN VOUT VDD VSS)
parameters gain=1
ECORE (VOUT 0 VIN 0) vcvs gain=gain
ends voltage_amplifier

subckt Main (Vin Vout)
CC1 (net1 Vout) capacitor c=1p
CC2 (net1 net0) capacitor c=1p
X1 (Vin net1 0 0) voltage_amplifier
X2 (net1 net0 0 0) voltage_amplifier
X3 (net0 Vout 0 0) voltage_amplifier
