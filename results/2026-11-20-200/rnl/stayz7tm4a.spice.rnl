*   $CANVAS_TYPESETTING @ATTACH #(level);
*   #X1 @SET-SYMBOL(terminals=[[1, "a"], [2, "b"], [3, "y"]]) $XOR_2INPUT => @PLACE(-11, -6) => @ORIENT("R0");
*   $IO_PORT @ATTACH &Vin(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-16, -5) => @ORIENT("R0") => %port1;
*   #R1 @SET-SYMBOL $RESISTOR => @PLACE(-4, -6) => @ORIENT("R270");
*   #L1 @SET-SYMBOL $CANVAS_INDUCTOR_LARGE => @PLACE(22, 6) => @ORIENT("R0");
