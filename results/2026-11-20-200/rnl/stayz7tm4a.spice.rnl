*   #XM1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(8, -2) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M1") #XM1(part);
*   #XM2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(22, -2) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M2") #XM2(part);
*   #D1 @SET-SYMBOL $DIODE => @PLACE(26, -2) => @ORIENT("R180");
*   #D2 @SET-SYMBOL $DIODE => @PLACE(4, -2) => @ORIENT("R180");
*   #I1 @SET-SYMBOL $CURRENT_SOURCE => @PLACE(15, -8) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(15, -10) => @ORIENT("R0") => %gnd1;
*   #C1 @SET-SYMBOL $CAPACITOR => @PLACE(0, -9) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(0, -10) => @ORIENT("R0") => %gnd2;
*   $IO_PORT @ATTACH &Voutp(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(11, 3) => @ORIENT("R270") => %port2;
*   $IO_PORT @ATTACH &Voutn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(19, 3) => @ORIENT("R270") => %port3;
*   %j1 = (15, -4);
*   %j2 = (4, -6);
*   %j3 = (8, 1);
*   %j4 = (22, 1);
*   %j5 = (0, -6);
*   %j6 = (8, 10);
*   %j7 = (22, 10);
*   %j8 = (11, 1);
*   %j9 = (19, 1);
*   %j10 = (26, 1);
*   %j11 = (6, 10);
*   %j12 = (26, 10);
*   %j13 = (11, 3);
*   %j14 = (19, 3);
