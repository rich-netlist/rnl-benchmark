
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @USE-PACKAGE(name="rnl-std-logic", version="0.4");
*   @DEVICE(model="sky130_fd_pr__nfet_01v8", terminals=["d", "g", "s", "b"], type="nmos")
* }
* Ideal xor-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt xor_gate A B Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
BhB hB 0 V={0.5*(1+tanh((V(B,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(V(hA)+V(hB)-2*V(hA)*V(hB))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends xor_gate

.subckt Main VDD VSS Vin Voutp Voutn
.model DIODE D(IS=1e-14 N=1)
C1 net1 VSS 1p
D1 net1 Voutn DIODE
D2 net1 Voutp DIODE
I1 net2 VSS DC 100u
L1 VDD Voutn 1n
L2 VDD Voutp 1n
XM1 Voutp Voutn net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 Voutn Voutp net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 net1 net0 1k
X1 Vin Voutn net0 VDD VSS xor_gate
