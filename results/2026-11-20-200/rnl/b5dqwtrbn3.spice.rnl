*   #XM4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(49, -28) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M4") #XM4(part);
*   #XM5 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(49, -35) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M5") #XM5(part);
*   #D1 @SET-SYMBOL $DIODE => @PLACE(34, -35) => @ORIENT("R180");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(34, -37) => @ORIENT("R0") => %gnd1;
*   $IO_PORT @ATTACH &DCG(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(38, -25) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &RST(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(38, -21) => @ORIENT("R0") => %port2;
*   $IO_PORT @ATTACH &TX(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(31, -30) => @ORIENT("R0") => %port3;
*   $IO_PORT @ATTACH &SEL(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(46, -35) => @ORIENT("R0") => %port4;
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(49, -18) => @ORIENT("R0") => %vdd1;
*   #I1 @SET-SYMBOL $CURRENT_SOURCE => @PLACE(54, -41) => @ORIENT("R0");
*   $CANVAS_PARAMETER @ATTACH(name="amplitude", text="1m") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="damping", text="0") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="delay", text="0") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="fall", text="1ps") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="frequency", text="1k") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="high", text="1m") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="low", text="0") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="offset", text="0") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="period", text="10ns") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="phase", text="0") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="rise", text="1ps") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="waveform", text="dc") #I1(part);
*   $CANVAS_PARAMETER @ATTACH(name="width", text="5ns") #I1(part);
*   $IO_PORT @ATTACH &BIAS(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(54, -44) => @ORIENT("R90") => %port5;
*   %j1 = (41, -28);
*   %j2 = (54, -39);
*   %j3 = (49, -19);
*   %j4 = (49, -18);
*   &net4 @WIRE(mode="straight") {#XM1:1 %j1};
*   &net4 @WIRE(mode="straight") {%j1 #XM4:2};
*   &net4 @WIRE(mode="straight") {#XM2:3 %j1};
*   &net2 @WIRE(mode="straight") {#XM4:3 #XM5:1};
*   &VDD @WIRE(mode="straight") {#XM3:1 %j3};
*   &VDD @WIRE(mode="straight") {%j4 %j3};
*   &VDD @WIRE(mode="straight") {%j3 #XM4:1};
*   &net1 @WIRE(mode="straight") {#XM5:3 (54, -37) %j2};
*   &BIAS @WIRE(mode="straight") {#I1:2 %port5::pin};
*   &net0 @WIRE(mode="straight") {#XM1:3 #D1:2};
*   &VSS @WIRE(mode="straight") {#D1:1 %gnd1::pin};
*   &VDD @WIRE(mode="straight") {%j4 %vdd1::pin};
*   $JUNCTION @ATTACH %j3(p) => @PLACE(49, -19) => %dot1;
*   &net1 @WIRE(mode="straight") {%j2 #I1:1};
*   &RST @WIRE(mode="straight") {#XM3:2 %port2::pin};
*   &DCG @WIRE(mode="straight") {#XM2:2 %port1::pin};
*   &SEL @WIRE(mode="straight") {#XM5:2 %port4::pin};
*   &TX @WIRE(mode="straight") {#XM1:2 %port3::pin};
*   &net3 @WIRE(mode="straight") {#XM2:1 #XM3:3};
*   $JUNCTION @ATTACH %j1(p) => @PLACE(41, -28) => %dot2;
*   #XM1
*       @TEXT("\textbf{\textit{M}}_{\textbf{1}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM1::name(label);
*   #XM2
*       @TEXT("\textbf{\textit{M}}_{\textbf{2}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM2::name(label);
*   #XM3
*       @TEXT("\textbf{\textit{M}}_{\textbf{3}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM3::name(label);
*   #XM4
*       @TEXT("\textbf{\textit{M}}_{\textbf{4}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM4::name(label);
*   #XM5
*       @TEXT("\textbf{\textit{M}}_{\textbf{5}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM5::name(label);
*   #D1
*       @TEXT("\textbf{\textit{D}}_{\textbf{1}}", key="name", dx=1.1, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #D1::name(label);
*   %port1
*       @TEXT("\textbf{\textit{DCG}}", key="netname", dx=-2, dy=-1, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{RST}}", key="netname", dx=-2, dy=-1, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %port3
*       @TEXT("\textbf{\textit{TX}}", key="netname", dx=-2, dy=-1, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
*   %port4
*       @TEXT("\textbf{\textit{SEL}}", key="netname", dx=-2, dy=-1, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::netname(label);
*   %vdd1 @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", dx=2, dy=1, size=1.5116, bold=false) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   #I1
*       @TEXT("\textbf{\textit{I}}_{\textbf{1}}", key="name", dx=1.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #I1::name(label);
*   %port5
*       @TEXT("\textbf{\textit{BIAS}}", key="netname", dx=0, dy=-3, halign="middle", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port5::netname(label);
*   %vdd1 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends Main
