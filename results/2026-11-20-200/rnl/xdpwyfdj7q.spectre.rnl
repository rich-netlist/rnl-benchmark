subckt bootstrap_track_hold_cell (vdd VSS clk_inverted vin gate_boost)
CBOOTSTRAP (net2 net0) capacitor c=950f
MBOOT_CAP_DISCHARGE (net0 clk_inverted VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
MBOOTSTRAP_CLAMP (vdd gate_boost net2 net2) sky130_fd_pr__pfet_01v8 l=0.15 w=32 nf=16 m=1
MBOOTSTRAP_GATE_TRANSFER (gate_boost net1 net2 net2) sky130_fd_pr__pfet_01v8 l=0.15 w=32 nf=16 m=1
MBOOTSTRAP_OFF_CLAMP (gate_boost vdd clk_internal VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
MBOOTSTRAP_PRECHARGE (vdd clk_internal gate_boost VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
MCLK_INV_N (clk_internal clk_inverted VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
MCLK_INV_P (clk_internal clk_inverted vdd vdd) sky130_fd_pr__pfet_01v8 l=0.15 w=32 nf=16 m=1
MGATE_CONTROL_PRECHARGE (net1 clk_internal vdd vdd) sky130_fd_pr__pfet_01v8 l=0.15 w=16 nf=8 m=1
MGATE_CONTROL_TRACK (net1 clk_internal net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
MINPUT_TRACK (net0 gate_boost vin VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=32 nf=16 m=1
