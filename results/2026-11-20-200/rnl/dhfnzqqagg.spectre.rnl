subckt Bottem_plate_Ctrl (VDD VSS Valid Dout CLKB5 CLKB4 CLKB3 CLKB2 CLKB1 CLKB0 CLKS CLK0)
X1 (CLK5 net0 VDD VSS) delay_cell tpd=5n vt=10m
X10 (CLK2 net3 VDD VSS) delay_cell tpd=5n vt=10m
X11 (CLK1 net4 VDD VSS) delay_cell tpd=5n vt=10m
X12 (VDD VSS Dout CLK5 D5 NC0001) d_flip_flop td=10p vt=10m
X13 (VDD VSS Dout CLK4 D4 NC0002) d_flip_flop td=10p vt=10m
X14 (VDD VSS Dout CLK3 D3 NC0003) d_flip_flop td=10p vt=10m
X15 (VDD VSS Dout CLK2 D2 NC0004) d_flip_flop td=10p vt=10m
X16 (VDD VSS Dout CLK1 D1 NC0005) d_flip_flop td=10p vt=10m
X17 (VDD VSS Dout CLK0 D0 NC0006) d_flip_flop td=10p vt=10m
X18 (net0 D5 CLKB5 VDD VSS) and_gate td=10p vt=10m
X19 (net1 D4 CLKB4 VDD VSS) and_gate td=10p vt=10m
X2 (CLK4 net1 VDD VSS) delay_cell tpd=5n vt=10m
X20 (net2 D3 CLKB3 VDD VSS) and_gate td=10p vt=10m
X21 (net3 D2 CLKB2 VDD VSS) and_gate td=10p vt=10m
X22 (net4 D1 CLKB1 VDD VSS) and_gate td=10p vt=10m
X23 (net5 D0 CLKB0 VDD VSS) and_gate td=10p vt=10m
X24 (CLK0 net5 VDD VSS) delay_cell tpd=5n vt=10m
X3 (VDD VSS VDD Valid CLKS CLK5 NC0007) d_flip_flop_reset td=500p vt=10m
X4 (VDD VSS CLK5 Valid CLKS CLK4 NC0008) d_flip_flop_reset td=500p vt=10m
X5 (VDD VSS CLK4 Valid CLKS CLK3 NC0009) d_flip_flop_reset td=500p vt=10m
X6 (VDD VSS CLK3 Valid CLKS CLK2 NC0010) d_flip_flop_reset td=500p vt=10m
X7 (VDD VSS CLK2 Valid CLKS CLK1 NC0011) d_flip_flop_reset td=500p vt=10m
X8 (VDD VSS CLK1 Valid CLKS CLK0 NC0012) d_flip_flop_reset td=500p vt=10m
X9 (CLK3 net2 VDD VSS) delay_cell tpd=5n vt=10m
