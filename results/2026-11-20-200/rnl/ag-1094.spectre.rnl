subckt DDA (inn1 inp1 inn2 inp2 outp outn)
// @RNL(author="analog-canvas") {
//   %DDA_SYMBOL = @DEFINE-SYMBOL(box=[-6, -7, 6, 7]) {
//     (-6, 4) @PIN(terminal="inn1", label="\textbf{\textit{inn1}}", direction="left");
//     (-6, 2) @PIN(terminal="inp1", label="\textbf{\textit{inp1}}", direction="left");
//     (-6, -2) @PIN(terminal="inn2", label="\textbf{\textit{inn2}}", direction="left");
//     (-6, -4) @PIN(terminal="inp2", label="\textbf{\textit{inp2}}", direction="left");
//     (6, 2) @PIN(terminal="outp", label="\textbf{\textit{outp}}", direction="right");
//     (6, -2) @PIN(terminal="outn", label="\textbf{\textit{outn}}", direction="right");
//     (0, 0) @RECTANGLE(width=10, height=12);
//     @LINE {(-6, 4) (-5, 4)};
//     @LINE {(-6, 2) (-5, 2)};
//     @LINE {(-6, -2) (-5, -2)};
//     @LINE {(-6, -4) (-5, -4)};
//     @LINE {(6, 2) (5, 2)};
//     @LINE {(6, -2) (5, -2)}
//   };
//   # @SET-SYMBOL %DDA_SYMBOL;
//   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
//   $IO_PORT @ATTACH &inn1(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-6, 4) => @ORIENT("R0") => %port1;
//   $IO_PORT @ATTACH &inp1(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-6, 2) => @ORIENT("R0") => %port2;
//   $IO_PORT @ATTACH &inn2(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-6, -2) => @ORIENT("R0") => %port3;
//   $IO_PORT @ATTACH &inp2(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-6, -4) => @ORIENT("R0") => %port4;
//   $IO_PORT @ATTACH &outp(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(6, 2) => @ORIENT("MY") => %port5;
//   $IO_PORT @ATTACH &outn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(6, -2) => @ORIENT("MY") => %port6;
//   %port1
//       @TEXT("\textbf{\textit{inn1}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
//       textvisible=true);
//   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
//   %port2
//       @TEXT("\textbf{\textit{inp1}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
//       textvisible=true);
//   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
//   %port3
//       @TEXT("\textbf{\textit{inn2}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
//       textvisible=true);
//   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
//   %port4
//       @TEXT("\textbf{\textit{inp2}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
//       textvisible=true);
//   $CANVAS_LABEL @ATTACH(bind="port") %port4::netname(label);
//   %port5
//       @TEXT("\textbf{\textit{outp}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
//       textvisible=true);
//   $CANVAS_LABEL @ATTACH(bind="port") %port5::netname(label);
//   %port6
//       @TEXT("\textbf{\textit{outn}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
//       textvisible=true);
//   $CANVAS_LABEL @ATTACH(bind="port") %port6::netname(label)
// }
ends DDA

subckt dut (VDD VSS RFin lo loc Vb1 Vb2 Vb3 Vb4 BBoutp BBoutn)
C1 (net11 net6) capacitor c=1p
C10 (net10 BBoutn) capacitor c=1p
C2 (net5 net9) capacitor c=1p
C3 (lo net7) capacitor c=1p
C4 (net8 lo) capacitor c=1p
C5 (net17 loc) capacitor c=1p
C6 (loc net12) capacitor c=1p
C7 (VDD Vmp) capacitor c=1p
C8 (Vmn VDD) capacitor c=1p
C9 (net13 BBoutp) capacitor c=1p
I1 (VDD net4) isource dc=1m
I2 (net4 Vmp) isource dc=1m
I3 (net4 net18) isource dc=1m
I4 (net15 Vmn) isource dc=1m
I5 (net15 net16) isource dc=1m
I6 (VSS net15) isource dc=1m
L1 (RFin net2) inductor l=1n
L2 (net3 VSS) inductor l=1n
L3 (VDD net11) inductor l=1n
M1 (net14 net2 net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (net11 VDD net14 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net5 net6 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (Vmp net7 net9 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (Vmp net17 net9 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M7 (Vmn net12 net9 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M8 (Vmn net8 net9 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (Vb1 net7) resistor r=1k
R10 (net10 BBoutn) resistor r=1k
R11 (Vmp net18) resistor r=1k
R12 (net18 net1) resistor r=1k
R13 (Vmn net16) resistor r=1k
R14 (net16 net0) resistor r=1k
R2 (Vb2 net17) resistor r=1k
R3 (Vb3 net12) resistor r=1k
R4 (Vb4 net8) resistor r=1k
R5 (VDD Vmp) resistor r=1k
R6 (Vmn VDD) resistor r=1k
R7 (VDD net13) resistor r=1k
R8 (net13 BBoutp) resistor r=1k
R9 (net10 VSS) resistor r=1k
RBUF (VDD net5) resistor r=1k
X1 (net13 net1 net0 net10 BBoutp BBoutn) DDA
