*   %vdd3 @TEXT("${p}", key="netname", textvisible=false);
*   %vdd4 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends dut

* Project model: applied version 3
* Behavioral VCO, no transistor-level phase noise model
.subckt CPPLL_VCO CTRL OUT VDD VSS params: f0=500k kvco=750k
Bfreq freq VSS V={max(100k,min(2Meg,f0+kvco*V(CTRL,VSS)))}
Bphase VSS phase I={1n*V(freq,VSS)}
Cphase phase VSS 1n IC=0
Rphase phase VSS 1T
Bout OUT VSS V={0.5*V(VDD,VSS)*(1+tanh(sin(6.283185307179586*V(phase,VSS))/0.02))}
.ends CPPLL_VCO
* @RNL(author="analog-canvas") {
*   $CPPLL_VCO_SYMBOL = @DEFINE-SYMBOL(box=[-5.5, -3.5, 5.5, 3.5]) {
*     (-5, 0) @PIN(terminal=1, label="CTRL", direction="left");
*     (5, 0) @PIN(terminal=2, label="OUT", direction="right");
*     (0, 3) @PIN(terminal=3, label="VDD", direction="up");
*     (0, -3) @PIN(terminal=4, label="VSS", direction="down");
*     @LINE {(-4, 2) (4, 2) (4, -2) (-4, -2) (-4, 2)};
*     @LINE {(-5, 0) (-4, 0)};
*     @LINE {(5, 0) (4, 0)};
*     @LINE {(0, 3) (0, 2)};
*     @LINE {(0, -3) (0, -2)}
*   }
* }
