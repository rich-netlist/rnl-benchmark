
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt dut VDD VSS VOP VON S1 S2 S3 S4 S5
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
C1 net0 net1 1p
CON VON VSS 1p
COP VOP VSS 1p
L net0 net2 1n
S1 VDD net0 S1 VSS ideal_switch
S2 net1 VSS S2 VSS ideal_switch
S3 net1 VON S3 VSS ideal_switch
S4 net2 VSS S4 VSS ideal_switch
S5 net2 VOP S5 VSS ideal_switch
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-5, -5, 5, 5]) {
*     (0, 5) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (5, 0) @PIN(terminal="VOP", label="\textbf{\textit{V}}_{\textbf{OP}}", direction="right");
*     (5, -2) @PIN(terminal="VON", label="\textbf{\textit{V}}_{\textbf{ON}}", direction="right");
*     (0, 0) @RECTANGLE(width=8, height=8);
*     @LINE {(0, 5) (0, 4)};
*     @LINE {(5, 0) (4, 0)};
*     @LINE {(5, -2) (4, -2)}
*   };
*   # @SET-SYMBOL %dut_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #S1 @SET-SYMBOL $SWITCH => @PLACE(26, -15) => @ORIENT("R270");
*   #S2 @SET-SYMBOL $SWITCH => @PLACE(26, -35) => @ORIENT("R270");
*   #S3 @SET-SYMBOL $SWITCH => @PLACE(38, -31) => @ORIENT("R0");
*   #S4 @SET-SYMBOL $SWITCH => @PLACE(38, -23) => @ORIENT("R270");
*   #S5 @SET-SYMBOL $SWITCH => @PLACE(42, -19) => @ORIENT("R0");
*   #L @SET-SYMBOL $CANVAS_INDUCTOR_LARGE => @PLACE(32, -19) => @ORIENT("R90");
*   #C1 @SET-SYMBOL $CAPACITOR => @PLACE(26, -25) => @ORIENT("R0");
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(26, -13) => @ORIENT("R0") => %vdd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(38, -26) => @ORIENT("R0") => %gnd1;
*   #COP @SET-SYMBOL $CAPACITOR => @PLACE(46, -23) => @ORIENT("R0");
*   #CON @SET-SYMBOL $CAPACITOR => @PLACE(46, -35) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(26, -38) => @ORIENT("R0") => %gnd2;
*   $IO_PORT @ATTACH &VOP(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(50, -19) => @ORIENT("R180") => %port1;
*   $IO_PORT @ATTACH &VON(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(50, -31) => @ORIENT("R180") => %port2;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(46, -26) => @ORIENT("R0") => %gnd3;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(46, -38) => @ORIENT("R0") => %gnd4;
*   %j1 = (26, -31);
*   %j2 = (26, -19);
*   %j3 = (38, -19);
*   %j4 = (46, -19);
*   %j5 = (46, -31);
*   &net0 @WIRE(mode="straight") {#S1:2 %j2};
*   &net0 @WIRE(mode="straight") {%j2 #C1:1};
*   &net1 @WIRE(mode="straight") {#C1:2 %j1};
*   &net1 @WIRE(mode="straight") {%j1 #S2:1};
*   &net1 @WIRE(mode="straight") {#S3:1 %j1};
*   &net0 @WIRE(mode="straight") {#L:1 %j2};
*   &net2 @WIRE(mode="straight") {#L:2 %j3};
*   &net2 @WIRE(mode="straight") {%j3 #S4:1};
*   &net2 @WIRE(mode="straight") {%j3 #S5:1};
*   &VOP @WIRE(mode="straight") {#S5:2 %j4};
*   &VOP @WIRE(mode="straight") {%j4 #COP:1};
*   &VON @WIRE(mode="straight") {#S3:2 %j5};
*   &VON @WIRE(mode="straight") {%j5 #CON:1};
*   &VOP @WIRE(mode="straight") {%j4 %port1::pin};
*   &VON @WIRE(mode="straight") {%port2::pin %j5};
*   &VSS @WIRE(mode="straight") {%gnd2::pin #S2:2};
*   &VSS @WIRE(mode="straight") {#CON:2 %gnd4::pin};
*   &VSS @WIRE(mode="straight") {%gnd1::pin #S4:2};
*   &VSS @WIRE(mode="straight") {%gnd3::pin #COP:2};
*   $JUNCTION @ATTACH %j4(p) => @PLACE(46, -19) => %dot1;
*   $JUNCTION @ATTACH %j5(p) => @PLACE(46, -31) => %dot2;
*   &VDD @WIRE(mode="straight") {#S1:1 %vdd1::pin};
*   $JUNCTION @ATTACH %j2(p) => @PLACE(26, -19) => %dot3;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(26, -31) => %dot4;
*   $JUNCTION @ATTACH %j3(p) => @PLACE(38, -19) => %dot5;
*   #S1
*       @TEXT("\textbf{\textit{S}}_{\textbf{1}}", key="name", dx=-0.7, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #S1::name(label);
*   #S2
*       @TEXT("\textbf{\textit{S}}_{\textbf{2}}", key="name", dx=-0.7, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #S2::name(label);
*   #S3
*       @TEXT("\textbf{\textit{S}}_{\textbf{3}}", key="name", dx=0, dy=-1.8, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #S3::name(label);
*   #S4
*       @TEXT("\textbf{\textit{S}}_{\textbf{4}}", key="name", dx=-0.7, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #S4::name(label);
*   #S5
*       @TEXT("\textbf{\textit{S}}_{\textbf{5}}", key="name", dx=0, dy=-1.8, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #S5::name(label);
*   #L
*       @TEXT("\textbf{\textit{L}}", key="name", dx=0, dy=2.1, halign="middle", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #L::name(label);
*   #C1
*       @TEXT("\textbf{\textit{C}}_{\textbf{FLY}}", key="name", dx=1.2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   %vdd1 @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", dx=2, dy=1, size=1.5116, bold=false) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   #COP
*       @TEXT("\textbf{\textit{C}}_{\textbf{OP}}", key="name", dx=1.2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #COP::name(label);
*   #CON
*       @TEXT("\textbf{\textit{C}}_{\textbf{ON}}", key="name", dx=1.2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #CON::name(label);
*   %port1
*       @TEXT("\textbf{\textit{V}}_{\textbf{OP}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{V}}_{\textbf{ON}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %vdd1 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends dut
