.subckt dut Vdd VSS Vref Vp Vm ref_sel_0_ refsel_bar_0_ ref_sel_1_ refsel_bar_1_ ref_sel_N-1_
+ refsel_bar_N-1_
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
C1 Vhf VSS 1p
I1 net4 VSS DC 1m
I2 net0 VSS DC 1m
I3 net2 VSS DC 1m
XM1 Vp net3 net4 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 Vm Vdd net4 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 Vp net1 net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 Vm Vdd net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 Vp net5 net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 Vm Vdd net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 Vdd Vhf 1k
S1 Vref net3 ref_sel_0_ VSS ideal_switch
S2 Vhf net3 refsel_bar_0_ VSS ideal_switch
S3 Vref net1 ref_sel_1_ VSS ideal_switch
S4 Vhf net1 refsel_bar_1_ VSS ideal_switch
S5 Vref net5 ref_sel_N-1_ VSS ideal_switch
S6 Vhf net5 refsel_bar_N-1_ VSS ideal_switch
