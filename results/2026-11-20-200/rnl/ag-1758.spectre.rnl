M2 (Vout VG VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net0 VG VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (Z VG VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
