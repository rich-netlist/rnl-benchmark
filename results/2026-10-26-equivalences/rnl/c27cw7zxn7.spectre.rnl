M29 (net18 EN net19 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net17 EN_bar net11 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M30 (net19 VSS VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M31 (net18 EN VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
