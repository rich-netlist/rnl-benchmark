M8 (VSS VSS net20 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M9 (net4 EN VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (net0 VSS) resistor r=1k
X1 (VDD VSS VDD net21 net1 noConn VinB) d_flip_flop_reset td=10p vt=10m
X2 (Vg net1 VDD VSS) inverter td=10p vt=10m
X3 (Vg net2 VDD VSS) inverter td=10p vt=10m
X4 (VinB net2 EN VDD VSS) nand_gate td=10p vt=10m
X5 (EN EN_bar VDD VSS) inverter td=10p vt=10m
