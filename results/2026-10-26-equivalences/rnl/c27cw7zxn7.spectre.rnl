M37 (net23 EN_bar VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (VSS Vb net17 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (net5 Vb VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (net13 EN_bar net5 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
