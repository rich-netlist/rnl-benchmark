C5 (vinn vin) capacitor c=800f
C6 (vip voutn) capacitor c=100f
C7 (voutp vin) capacitor c=100f
L0 (vip vinp) inductor l=1G
L1 (vinn vin) inductor l=1G
MNM0 (von1 vip net0 VSS) sky130_fd_pr__nfet_01v8 l=0.6 w=50 nf=2 m=1
MNM1 (vop1 vin net0 VSS) sky130_fd_pr__nfet_01v8 l=0.6 w=50 nf=2 m=1
MNM10 (voutn net10 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.8 w=1 nf=1 m=1
MNM11 (bp2 bn1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.4 w=1 nf=1 m=1
MNM12 (net1 net1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.2 w=40 nf=1 m=1
MNM13a (bn2 bn2 net1 VSS) sky130_fd_pr__nfet_01v8 l=0.2 w=10 nf=1 m=1
MNM13b (bn2 bn2 net1 VSS) sky130_fd_pr__nfet_01v8 l=0.2 w=10 nf=1 m=1
MNM14 (net0 net4 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.4 w=5 nf=1 m=1
MNM15 (vgp3 bn2 vgn3 VSS) sky130_fd_pr__nfet_01v8 l=0.2 w=20 nf=1 m=1
MNM2 (net0 net3 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.4 w=5 nf=4 m=1
MNM3 (net0 bn1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.4 w=5 nf=5 m=1
MNM4 (bn1 bn1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.4 w=5 nf=1 m=1
MNM5 (vgn3 net7 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.4 w=5 nf=2 m=1
MNM7 (voutp vgn3 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.8 w=1 nf=1 m=1
MNM8 (net10 net13 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.4 w=5 nf=2 m=1
MNM9 (net8 bn2 net10 VSS) sky130_fd_pr__nfet_01v8 l=0.4 w=5 nf=1 m=1
MPM0 (von1 ibias VDD VDD) sky130_fd_pr__pfet_01v8 l=0.4 w=20 nf=5 m=1
MPM1 (vgp3 net5 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.4 w=20 nf=2 m=1
MPM10 (net2 net2 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.2 w=40 nf=1 m=1
MPM11 (bp2 bp2 net2 VDD) sky130_fd_pr__pfet_01v8 l=0.2 w=20 nf=4 m=1
MPM12 (bn2 ibias VDD VDD) sky130_fd_pr__pfet_01v8 l=0.4 w=4 nf=1 m=1
MPM13 (vgn3 bp2 vgp3 VDD) sky130_fd_pr__pfet_01v8 l=0.2 w=20 nf=4 m=1
MPM3 (vop1 ibias VDD VDD) sky130_fd_pr__pfet_01v8 l=0.4 w=20 nf=5 m=1
MPM4 (ibias ibias VDD VDD) sky130_fd_pr__pfet_01v8 l=0.4 w=20 nf=1 m=1
MPM5 (bn1 ibias VDD VDD) sky130_fd_pr__pfet_01v8 l=0.4 w=20 nf=1 m=1
MPM6 (voutp vgp3 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.8 w=1 nf=1 m=1
MPM7 (net10 bp2 net8 VDD) sky130_fd_pr__pfet_01v8 l=0.4 w=20 nf=1 m=1
MPM8 (net8 net11 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.4 w=20 nf=2 m=1
MPM9 (voutn net8 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.8 w=1 nf=1 m=1
R1 (net3 von1) resistor r=1M
R3 (vop1 net3) resistor r=1M
