.subckt Main VDD VSS ZRE Vout PBIAS_IREF DL S1
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
I1 DL VSS DC 100u
XM10 net1 PBIAS_IREF net0 VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 net1 Vout VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 Vout net1 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 net0 Vout VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM7 Vout net0 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM8 net1 ZRE VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM9 net0 Vout VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
S1 net1 DL S1 VSS ideal_switch
* @RNL(author="analog-canvas") {
