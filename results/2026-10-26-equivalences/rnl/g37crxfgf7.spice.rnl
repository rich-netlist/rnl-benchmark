*   &VDD @WIRE(mode="straight", linestyle="bold") {%j9 %j3};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j3 %j1};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j1 %j2};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j2 %j10};
*   &VSS @WIRE(mode="straight") {%gnd2:p %gnd1:p};
*   $JUNCTION @ATTACH (50, -11)(p) => %dot1;
*   &VSS @WIRE(mode="straight") {%j6 #XM5:3};
*   &VSS @WIRE(mode="straight") {%gnd3:p #I1:2};
*   &ZRE @WIRE(mode="straight") {#XM8:2 %port1:p};
*   &PBIAS_IREF @WIRE(mode="straight") {#XM10:2 %port3:p};
*   &DL @WIRE(mode="straight") {#I1:1 %port4:p #S1:2};
*   $JUNCTION @ATTACH (30, -9)(p) => %dot2;
*   &VDD @WIRE(mode="straight") {#XM9:3 #XM6:3};
*   &net0 @WIRE(mode="straight") {#XM9:1 #XM6:1};
*   $JUNCTION @ATTACH (44, 2)(p) => %dot3;
*   $JUNCTION @ATTACH (44, -5)(p) => %dot4;
*   &Vout @WIRE(mode="straight") {#XM9:2 #XM6:2};
*   $JUNCTION @ATTACH (56, 2)(p) => %dot5;
*   $JUNCTION @ATTACH (56, -5)(p) => %dot6;
*   #XM4 @TEXT("\textbf{\textit{M}}_{\textbf{4}}", key="name", dx=-1, dy=-1, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM4::name(label);
*   #XM5 @TEXT("\textbf{\textit{M}}_{\textbf{5}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM5::name(label);
*   #XM6 @TEXT("\textbf{\textit{M}}_{\textbf{6}}", key="name", dx=-1, dy=-1, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM6::name(label);
*   #XM7 @TEXT("\textbf{\textit{M}}_{\textbf{7}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM7::name(label);
*   #XM8 @TEXT("\textbf{\textit{M}}_{\textbf{8}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM8::name(label);
*   %port1 @TEXT("\textbf{\textit{ZRE}}", key="name", dx=-2, dy=-1, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::name(label);
*   %port2 @TEXT("\textbf{\textit{V}}_{\textbf{out}}", key="name", dx=1.5, dy=0, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::name(label);
*   #XM10 @TEXT("\textbf{\textit{M}}_{\textbf{10}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM10::name(label);
*   %port3 @TEXT("\textbf{PBIAS\_IREF}", key="name", dx=0, dy=1, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::name(label);
*   #S1 @TEXT("\textbf{\textit{S}}_{\textbf{1}}", key="name", dx=-1, dy=0, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #S1::name(label);
*   %port4 @TEXT("\textbf{DL}", key="name", dx=-2, dy=-1, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::name(label);
*   #I1 @TEXT("\textbf{Ibitcell}", key="name", dx=2, dy=-1, halign="start", valign="baseline", size=1.5116);
*   &VDD @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", size=1.5116) => @PLACE(60, 6) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label)
* }
.ends Main
