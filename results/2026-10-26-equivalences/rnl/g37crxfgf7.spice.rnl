*   $IO_PORT @ATTACH &Vout(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(67, 1) => @ORIENT("R180") => %port2;
*   #XM9 @SET-SYMBOL $PMOS => @PLACE(44, 4) => @ORIENT("MY");
