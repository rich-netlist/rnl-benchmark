*   $CANVAS_NAME @ATTACH(name="M10") #XM10(part);
*   $IO_PORT @ATTACH &PBIAS_IREF(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(41, -1) => @ORIENT("R0") => %port3;
*   #S1 @SET-SYMBOL $CANVAS_SIMPLE_SWITCH => @PLACE(30, -7) => @ORIENT("R270");
*   $IO_PORT @ATTACH &DL(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(30, -9) => @ORIENT("R0") => %port4;
*   #I1 @SET-SYMBOL $CURRENT_SOURCE => @PLACE(30, -11) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(50, -11) => @ORIENT("R0") => %gnd2;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(30, -13) => @ORIENT("R0") => %gnd3;
*   &VDD @REMOVE-FROM $PORT_FILL_SET;
*   &VSS @REMOVE-FROM $PORT_FILL_SET;
*   &S1 @REMOVE-FROM $PORT_FILL_SET;
*   %j1 = (44, 7);
*   $JUNCTION @ATTACH %j1;
*   %j2 = (56, 7);
*   $JUNCTION @ATTACH %j2;
*   %j3 = (30, 7);
*   $JUNCTION @ATTACH %j3;
*   %j4 = (46, -7);
*   %j5 = (56, 1);
*   $JUNCTION @ATTACH %j5;
*   %j6 = (56, -9);
*   %j7 = (44, -4);
*   $JUNCTION @ATTACH %j7;
*   %j8 = (30, -4);
*   $JUNCTION @ATTACH %j8;
*   %j9 = (27, 7);
*   %j10 = (59, 7);
*   &VDD @WIRE(mode="straight") {#XM6:3 %j1};
*   &VDD @WIRE(mode="straight") {#XM7:3 %j2};
*   &VDD @WIRE(mode="straight") {#XM8:3 %j3};
*   &Vout @WIRE(mode="straight") {%j4 #XM4:2};
*   &Vout @WIRE(mode="straight") {#XM6:2 (49, 4) (51, 2) #XM7:1};
*   &Vout @WIRE(mode="straight") {#XM4:2 (49, -7) (51, -5) #XM5:1};
*   &Vout @WIRE(mode="straight") {#XM7:1 %j5};
*   &Vout @WIRE(mode="straight") {%j5 #XM5:1};
*   &Vout @WIRE(mode="straight") {%j5 %port2:p};
*   &VSS @WIRE(mode="straight") {#XM4:3 (44, -11) %gnd1:p};
*   &VSS @WIRE(mode="straight") {%gnd1:p (56, -11) %j6};
*   &net0 @WIRE(mode="straight") {#XM10:3 #XM6:1};
*   &net0 @WIRE(mode="straight") {#XM6:1 (49, 2) (51, 4) #XM7:2};
*   &net1 @WIRE(mode="straight") {#XM8:1 %j8};
*   &net1 @WIRE(mode="straight") {%j8 #S1:1};
*   &net1 @WIRE(mode="straight") {%j8 %j7};
*   &net1 @WIRE(mode="straight") {#XM10:1 %j7};
*   &net1 @WIRE(mode="straight") {%j7 #XM4:1};
