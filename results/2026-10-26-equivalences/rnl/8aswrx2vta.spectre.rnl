//   #XB3 @SET-SYMBOL $CANVAS_CALL_INVERTER__0_0_1_2 => @PLACE(30, -20) => @ORIENT("R0");
//   #XFB2 @SET-SYMBOL $CANVAS_CALL_INVERTER__0_0_1_2 => @PLACE(40, -20) => @ORIENT("R0");
