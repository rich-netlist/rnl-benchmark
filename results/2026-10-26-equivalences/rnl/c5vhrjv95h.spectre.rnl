simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="rnl-std", version="0.3");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.3");
//   @USE-PACKAGE(name="rnl-std-functional", version="0.3")
// }

subckt icm_opamp_vdd_vss (VIP VIN VDD VSS VOUT)
parameters gain=1e6
Blin (nlin 0) bsource v=gain*(v(VIP)-v(VIN))
Bcore (VOUT 0) bsource v=0.5*(v(VDD)+(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12)))-sqrt((v(VDD)-(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))))*(v(VDD)-(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))
ends icm_opamp_vdd_vss

subckt bias_core (VDD VSS in1 in2 in3 in4 out1 out2 out3 out4 test1 test2 test3 test4 test5)
C1 (test2 net17) capacitor c=1p
M1 (test1 test1 net4 VDD) sky130_fd_pr__pfet_01v8 l=1 w=2 nf=1 m=1
M10 (out2 mj_g net5 VDD) sky130_fd_pr__pfet_01v8 l=0.5 w=1 nf=1 m=1
M11 (out2 mk_g net3 VDD) sky130_fd_pr__pfet_01v8 l=0.5 w=1 nf=1 m=1
M12 (out2 in2 net10 VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=1 nf=1 m=1
M13 (out3 in3 net7 VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=2 nf=1 m=1
M14 (net19 mn_g net7 net7) sky130_fd_pr__nfet_01v8 l=0.5 w=1 nf=1 m=1
M15 (in1 in1 VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=2 nf=1 m=1
M16 (test1 in1 VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=2 nf=1 m=1
M17 (net16 net16 VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=2 nf=1 m=1
M18 (in4 net16 VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=2 nf=1 m=1
M19 (in4 in4 VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=2 nf=1 m=1
M2 (test1 mb_g mb_s VDD) sky130_fd_pr__pfet_01v8 l=1 w=1 nf=1 m=1
M20 (in4 mr_g VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=1 nf=1 m=1
M21 (vbp in4 VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=2 nf=1 m=1
M3 (test3 test1 net8 VDD) sky130_fd_pr__pfet_01v8 l=1 w=2 nf=1 m=1
M4 (test2 test1 net20 VDD) sky130_fd_pr__pfet_01v8 l=1 w=2 nf=1 m=1
M5 (net16 test1 net18 VDD) sky130_fd_pr__pfet_01v8 l=1 w=2 nf=1 m=1
M6 (net6 mg_g VDD VDD) sky130_fd_pr__pfet_01v8 l=1 w=1 nf=1 m=1
M7 (net6 test2 out1 out1) sky130_fd_pr__nfet_01v8 l=1 w=2 nf=1 m=1
M8 (test3 test3 net17 net17) sky130_fd_pr__nfet_01v8 l=1 w=2 nf=1 m=1
M9 (test2 test3 net2 net2) sky130_fd_pr__nfet_01v8 l=1 w=2 nf=1 m=1
Q1 (net4 net4 net9) sky130_fd_pr__pnp_05v5_W0p68L0p68 m=1
Q10 (out2 out3 out3 VSS) sky130_fd_pr__npn_05v5_W1p00L1p00 m=1
Q2 (net8 vbp net12) sky130_fd_pr__pnp_05v5_W0p68L0p68 m=1
Q3 (net20 vbp net11) sky130_fd_pr__pnp_05v5_W0p68L0p68 m=1
Q4 (net18 vbp net13) sky130_fd_pr__pnp_05v5_W0p68L0p68 m=1
Q5 (net17 out1 test4 VSS) sky130_fd_pr__npn_05v5_W1p00L1p00 m=1
Q6 (net2 out1 test5 VSS) sky130_fd_pr__npn_05v5_W1p00L1p00 m=1
Q7 (net2 out1 out1 VSS) sky130_fd_pr__npn_05v5_W1p00L1p00 m=1
Q8 (net15 net15 VSS VSS) sky130_fd_pr__npn_05v5_W1p00L1p00 m=1
Q9 (out2 out2 out3 VSS) sky130_fd_pr__npn_05v5_W1p00L1p00 m=1
R1 (VDD net9) resistor r=10k
R10 (net3 rf_b) resistor r=10k
R11 (rd_top net0) resistor r=10k
R12 (net0 net10) resistor r=10k
R13 (net10 rd_bot) resistor r=10k
R14 (net14 net7) resistor r=10k
R15 (net19 net14) resistor r=10k
R16 (out4 net19) resistor r=10k
R17 (test5 vr1_b) resistor r=10k
R18 (net7 vr2_b) resistor r=10k
R2 (VDD net12) resistor r=10k
R3 (VDD net11) resistor r=10k
R4 (VDD net13) resistor r=10k
R5 (test4 net1) resistor r=10k
R6 (net1 test5) resistor r=10k
R7 (out1 net5) resistor r=10k
R8 (out1 net15) resistor r=10k
R9 (net5 net3) resistor r=10k
X1 (test3 test2 VDD VSS vbp) icm_opamp_vdd_vss gain=1e6
