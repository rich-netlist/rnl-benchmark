//   @USE-PACKAGE(name="rnl-std-functional", version="0.3");
//   @USE-PACKAGE(name="rnl-std-logic", version="0.3")
// }

// Ideal and-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
subckt and_gate (A B Y VDD VSS)
parameters vt=10m td=10p
BhA (hA 0) bsource v=0.5*(1+tanh((v(A,VSS)-0.5*v(VDD,VSS))/vt))
BhB (hB 0) bsource v=0.5*(1+tanh((v(B,VSS)-0.5*v(VDD,VSS))/vt))
Bf (nfn VSS) bsource v=v(VDD,VSS)*(v(hA)*v(hB))
Rd (nfn ndl) resistor r=1k
Cd (ndl VSS) capacitor c=td/1000
BY (Y VSS) bsource v=v(ndl,VSS)
ends and_gate

subckt voltage_amplifier (VIN VOUT VDD VSS)
parameters gain=1
ECORE (VOUT 0 VIN 0) vcvs gain=gain
ends voltage_amplifier

subckt pfd_charge_pump (VDD VSS ref fb vctrl)
subckt ideal_switch (p n cp cn)
parameters ron=1 roff=1e12 vt=0.5
core (p n) bsource i=v(p,n)/(v(cp,cn)>vt ? ron : roff)
ends ideal_switch
C1 (net3 VSS) capacitor c=100p
C2 (vctrl VSS) capacitor c=10p
IDN (net0 VSS) isource dc=50u
IUP (VDD net1) isource dc=50u
R1 (vctrl net3) resistor r=10k
S1 (net1 vctrl up VSS) ideal_switch
S2 (vctrl net0 dn VSS) ideal_switch
S3 (vrep net1 upb VSS) ideal_switch
S4 (net0 vrep dnb VSS) ideal_switch
X1 (VDD VSS VDD ref net2 up upb) d_flip_flop_reset td=10p vt=10m
X2 (VDD VSS VDD fb net2 dn dnb) d_flip_flop_reset td=10p vt=10m
X3 (up dn net2 VDD VSS) and_gate td=10p vt=10m
X4 (vctrl vrep VDD VSS) voltage_amplifier gain=1
