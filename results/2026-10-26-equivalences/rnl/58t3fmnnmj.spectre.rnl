MINVN_P (CLKN CLK VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=8 nf=4 m=1
MINVP_N (CLKP CLKN VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=4 m=1
MINVP_P (CLKP CLKN VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=8 nf=4 m=1
MLIM (VDD VG net0 net0) sky130_fd_pr__pfet_01v8 l=0.15 w=8 nf=4 m=1
MPCHG (CG CLKP VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=8 nf=4 m=1
MPRE (VDD CLK VG VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
MPVIN (CBB VG VIN VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=8 m=1
