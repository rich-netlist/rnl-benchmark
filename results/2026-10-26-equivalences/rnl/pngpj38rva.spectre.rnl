simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="rnl-std", version="0.3");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.3");
//   @USE-PACKAGE(name="rnl-std-functional", version="0.3")
// }

subckt icm_opamp_vdd_vss (VIP VIN VDD VSS VOUT)
parameters gain=1e6
Blin (nlin 0) bsource v=gain*(v(VIP)-v(VIN))
Bcore (VOUT 0) bsource v=0.5*(v(VDD)+(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12)))-sqrt((v(VDD)-(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))))*(v(VDD)-(0.5*(v(VSS)+v(nlin)+sqrt((v(nlin)-v(VSS))*(v(nlin)-v(VSS))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))))+(1e-4*(v(VDD)-v(VSS)))*(1e-4*(v(VDD)-v(VSS)))+1e-12))
ends icm_opamp_vdd_vss

subckt dut (VDD VSS VB Vinp Vinn Vocref VB2 Vop2 Von2 VB1)
subckt ideal_switch (p n cp cn)
parameters ron=1 roff=1e12 vt=0.5
core (p n) bsource i=v(p,n)/(v(cp,cn)>vt ? ron : roff)
ends ideal_switch
C1 (net8 net3) capacitor c=0.1p
C2 (net7 net3) capacitor c=0.1p
C3 (Vop2 net2) capacitor c=0.2p
C4 (Von2 net2) capacitor c=0.2p
CDRV (net1 VSS) capacitor c=10p
CF (net0 net4) capacitor c=20p
I1 (VDD VB1) isource dc=25u
ITAIL (VDD net5) isource dc=60u
M1 (Von VB VDD VDD) sky130_fd_pr__pfet_01v8 l=0.5 w=20 nf=1 m=1
M10 (Vop2 VB2 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M11 (VB1 VB1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=15 nf=1 m=1
M12 (Vop2 Vop VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (Vop VB VDD VDD) sky130_fd_pr__pfet_01v8 l=0.5 w=20 nf=1 m=1
M3 (Von Vinp net6 VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=10 nf=1 m=1
M4 (Vop Vinn net6 VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=10 nf=1 m=1
M5 (net6 net5 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=4 nf=1 m=4
M6 (net6 net1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=15 nf=1 m=1
M7 (net5 net5 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=4 nf=1 m=5
M8 (Von2 Von VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M9 (Von2 VB2 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (net2 net0) resistor r=1k
RDRV (net4 net1) resistor r=20k
S1 (net7 Vocref phi1 VSS) ideal_switch
S2 (Vocref net8 phi1 VSS) ideal_switch
S3 (net8 Vop2 phi2 VSS) ideal_switch
S4 (net7 Von2 phi2 VSS) ideal_switch
S5 (VB1 net3 phi1 VSS) ideal_switch
S6 (net3 net2 phi2 VSS) ideal_switch
SRESET (net0 net4 phi3 VSS) ideal_switch
V1 (phi1 VSS) vsource type=pulse val0=0 val1=1.8 delay=1n rise=100p fall=100p width=44n period=100n dc=0
V2 (phi2 VSS) vsource type=pulse val0=0 val1=1.8 delay=51n rise=100p fall=100p width=44n period=100n dc=0
VRST (phi3 VSS) vsource type=pulse val0=1.8 val1=0 delay=200n rise=100p fall=100p width=100u period=200u dc=1.8
X1 (VB1 net0 VDD VSS net4) icm_opamp_vdd_vss gain=1e6
