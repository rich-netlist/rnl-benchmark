*   #M13 @TEXT("\textbf{\textit{M}}_{\textbf{13}}", key="name", dx=1.5, dy=3, halign="middle", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #M13::name(label);
*   #M14 @TEXT("\textbf{\textit{M}}_{\textbf{14}}", key="name", dx=-1.5, dy=3, halign="middle", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #M14::name(label);
*   #M15 @TEXT("\textbf{\textit{M}}_{\textbf{15}}", key="name", dx=3.5, dy=2.5, halign="middle", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #M15::name(label);
*   %port7 @TEXT("\textbf{\textit{a}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port7::name(label);
*   %port8 @TEXT("\textbf{\textit{Outn}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port8::name(label);
*   @LINE(linestyle="dashed") {(45.5, -20) (60, -6)} => @LAYER("top");
