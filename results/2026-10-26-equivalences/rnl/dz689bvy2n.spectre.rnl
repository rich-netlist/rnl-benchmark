subckt sar4_bootstrap_switch (VDD VSS clks vin vout)
C0 (net1 net3) capacitor c=1p
M0 (net3 clksb VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=2 m=1
M1 (net3 gate vin VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=4 m=1
M10 (clksb clks VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M11 (clksb clks VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=3 nf=1 m=1
M2 (vin gate vout VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=4 m=1
M3 (gate VDD net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=2 m=1
M4 (net0 clksb VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=2 m=1
M5 (VDD gate net1 net1) sky130_fd_pr__pfet_01v8 l=0.15 w=6 nf=2 m=1
M6 (gate net4 net1 net1) sky130_fd_pr__pfet_01v8 l=0.15 w=3 nf=1 m=1
M7 (net4 clks VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=3 nf=1 m=1
M8 (net4 gate net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M9 (net4 clks net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
