subckt sar6_cdac_half_6bit (VDD vrefn VSS clks vin vtop vrefp dctrl1 dctrl2 dctrl3 dctrl4 dctrl5)
C0 (vtop vbot5) capacitor c=329.25f
C1 (vtop vbot4) capacitor c=164.625f
C2 (vtop vbot3) capacitor c=82.3125f
C3 (vtop vbot2) capacitor c=41.15625f
C4 (vtop vbot1) capacitor c=20.578125f
C5 (vtop VSS) capacitor c=2.078125f
MN1 (vbot1 dctrl1 vrefn VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MN2 (vbot2 dctrl2 vrefn VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=2 m=1
MN3 (vbot3 dctrl3 vrefn VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=4 m=1
MN4 (vbot4 dctrl4 vrefn VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=8 m=1
MN5 (vbot5 dctrl5 vrefn VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=16 m=1
MP1 (vbot1 dctrl1 vrefp VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=3 nf=1 m=1
