simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.3");
//   @USE-PACKAGE(name="rnl-std", version="0.3");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.3")
// }

subckt ideal_chopper (INP INN OUTP OUTN CK)
parameters ron=1 roff=1e12 vt=0.5
s1 (INP OUTP) bsource i=v(INP,OUTP)/(v(CK)>vt ? ron : roff)
s2 (INN OUTN) bsource i=v(INN,OUTN)/(v(CK)>vt ? ron : roff)
s3 (INP OUTN) bsource i=v(INP,OUTN)/(v(CK)>vt ? roff : ron)
s4 (INN OUTP) bsource i=v(INN,OUTP)/(v(CK)>vt ? roff : ron)
ends ideal_chopper

subckt dut (VDD VSS Vbp1 Vbp2 Vin\+ Vin\- Voutn Voutp PHIch)
C1 (Voutp net5) capacitor c=1p
C2 (Voutn net6) capacitor c=1p
CH1 (net1 net0 net3 net2 PHIch) ideal_chopper
CH2 (net11 net10 net13 net12 PHIch) ideal_chopper
I1 (VDD net17) isource dc=1m
I2 (VDD net16) isource dc=1m
M1 (net4 Vbp1 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M10 (net6 Vbp2 net3 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M11 (net7 Vbp2 net5 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M12 (net8 Vbp2 net6 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M13 (net7 Vbn2 net10 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M14 (net8 Vbn2 net11 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M15 (net12 Vbn1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M16 (net13 Vbn1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M17 (net14 Vbp1 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M18 (net15 Vbp2 net14 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M19 (Voutn net8 net15 net15) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (net9 Vbp2 net4 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M20 (Voutp net7 net15 net15) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M21 (Voutp vcmbf2 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M22 (Voutn vcmbf2 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M23 (net12 net18 net17 net17) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M24 (net17 net18 net16 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M25 (net16 net18 net17 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M26 (net13 net18 net16 net16) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
