*   %div2_tg_SYMBOL = @DEFINE-SYMBOL(box=[-5, -5, 5, 5]) {
*     (-5, 0) @PIN(terminal="a", label="\textbf{\textit{a}}", direction="left");
*     (5, 0) @PIN(terminal="y", label="\textbf{\textit{y}}", direction="right");
*     (2, 5) @PIN(terminal="g", label="\textbf{\textit{g}}", direction="up");
*     (-2, 5) @PIN(terminal="gb", label="\textbf{\textit{gb}}", direction="up");
*     (0, 0) @RECTANGLE(width=8, height=8);
*     @LINE {(-5, 0) (-4, 0)};
*     @LINE {(5, 0) (4, 0)};
*     @LINE {(2, 5) (2, 4)};
*     @LINE {(-2, 5) (-2, 4)}
*   };
*   # @SET-SYMBOL %div2_tg_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XMN @SET-SYMBOL $NMOS => @PLACE(0, -3) => @ORIENT("R90");
*   $CANVAS_NAME @ATTACH(name="MN") #XMN(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMN(part);
*   #XMP @SET-SYMBOL $PMOS => @PLACE(0, 3) => @ORIENT("R270");
*   $CANVAS_NAME @ATTACH(name="MP") #XMP(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMP(part);
*   $IO_PORT @ATTACH &a(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-6, 0) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &y(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(6, 0) => @ORIENT("MY") => %port2;
*   $IO_PORT @ATTACH &g(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-6, -8) => @ORIENT("R0") => %port3;
*   $IO_PORT @ATTACH &gb(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-6, 8) => @ORIENT("R0") => %port4;
*   &VDD @REMOVE-FROM $PORT_FILL_SET;
*   &VSS @REMOVE-FROM $PORT_FILL_SET;
*   %j1 = (-2, 0);
*   $JUNCTION @ATTACH %j1;
*   %j2 = (2, 0);
*   $JUNCTION @ATTACH %j2;
*   &a @WIRE(mode="straight") {#XMP:1 %j1};
*   &a @WIRE(mode="straight") {%j1 #XMN:1};
*   &y @WIRE(mode="straight") {#XMP:3 %j2};
*   &y @WIRE(mode="straight") {%j2 #XMN:3};
*   &a @WIRE(mode="straight") {%port1:p %j1};
*   &y @WIRE(mode="straight") {%port2:p %j2};
