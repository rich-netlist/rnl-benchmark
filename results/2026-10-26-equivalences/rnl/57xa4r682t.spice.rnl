*   %cmfb_amp_SYMBOL = @DEFINE-SYMBOL(box=[-8, -7, 8, 7]) {
*     (-8, 2) @PIN(terminal="vsense", label="\textbf{\textit{v}}_{\textbf{sense}}", direction="left");
