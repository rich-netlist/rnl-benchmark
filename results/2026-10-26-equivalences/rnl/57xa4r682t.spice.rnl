
* @RNL(type="header") {
*   @VERSION("0.3");
*   @USE-PACKAGE(name="rnl-std", version="0.3");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.3");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.3")
* }
.subckt cmfb_amp_bp vdd VSS vsense vocm vbn vctrl
CCM vdd vctrl 100fF
XMC1 net2 vsense net1 VSS sky130_fd_pr__nfet_01v8_lvt l=0.5 w=24 nf=4 m=1
XMC2 vctrl vocm net0 VSS sky130_fd_pr__nfet_01v8_lvt l=0.5 w=24 nf=4 m=1
XMCL1 net2 net2 vdd vdd sky130_fd_pr__pfet_01v8 l=1 w=40 nf=5 m=1
XMCL2 vctrl vctrl vdd vdd sky130_fd_pr__pfet_01v8 l=1 w=40 nf=5 m=1
XMCTA net1 vbn VSS VSS sky130_fd_pr__nfet_01v8 l=1 w=8 nf=2 m=1
XMCTB net0 vbn VSS VSS sky130_fd_pr__nfet_01v8 l=1 w=8 nf=2 m=1
RCM net0 net1 5kΩ
* @RNL(author="analog-canvas") {
*   %cmfb_amp_bp_SYMBOL = @DEFINE-SYMBOL(box=[-8, -7, 8, 7]) {
*     (-8, 2) @PIN(terminal="vsense", label="\textbf{\textit{v}}_{\textbf{sense}}", direction="left");
*     (-8, -2) @PIN(terminal="vocm", label="\textbf{\textit{v}}_{\textbf{ocm}}", direction="left");
*     (8, 0) @PIN(terminal="vctrl", label="\textbf{\textit{v}}_{\textbf{ctrl}}", direction="right");
*     (-2, 7) @PIN(terminal="vdd", label="\textbf{\textit{v}}_{\textbf{dd}}", direction="up");
*     (0, 0) @RECTANGLE(width=14, height=12);
*     @LINE {(-8, 2) (-7, 2)};
*     @LINE {(-8, -2) (-7, -2)};
*     @LINE {(2, 7) (2, 6)};
*     @LINE {(8, 0) (7, 0)};
*     @LINE {(-2, 7) (-2, 6)}
*   };
*   # @SET-SYMBOL %cmfb_amp_bp_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XMCTA @SET-SYMBOL $NMOS => @PLACE(-10, -2) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MCTA") #XMCTA(part);
*   #XMCTB @SET-SYMBOL $NMOS => @PLACE(10, -2) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MCTB") #XMCTB(part);
*   #XMC1 @SET-SYMBOL $NMOS => @PLACE(-10, 6) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MC1") #XMC1(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.5u") #XMC1(part);
*   #XMC2 @SET-SYMBOL $NMOS => @PLACE(10, 6) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MC2") #XMC2(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.5u") #XMC2(part);
*   #XMCL1 @SET-SYMBOL $PMOS => @PLACE(-10, 14) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MCL1") #XMCL1(part);
*   #XMCL2 @SET-SYMBOL $PMOS => @PLACE(10, 14) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MCL2") #XMCL2(part);
*   #RCM @SET-SYMBOL $RESISTOR => @PLACE(0, 2) => @ORIENT("R270");
*   #CCM @SET-SYMBOL $CAPACITOR => @PLACE(16, 14) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(-10, -4) => @ORIENT("R0") => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(10, -4) => @ORIENT("R0") => %gnd2;
*   $IO_PORT @ATTACH &vsense(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-13, 6) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &vocm(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(13, 6) => @ORIENT("MY") => %port2;
*   $IO_PORT @ATTACH &vbn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-13, -2) => @ORIENT("R0") => %port3;
*   $IO_PORT @ATTACH &vbn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(13, -2) => @ORIENT("MY") => %port4;
*   $IO_PORT @ATTACH &vctrl(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(20, 10) => @ORIENT("MY") => %port5;
*   &vdd @REMOVE-FROM $PORT_FILL_SET;
*   &VSS @REMOVE-FROM $PORT_FILL_SET;
*   %j1 = (-10, 2);
*   $JUNCTION @ATTACH %j1;
*   %j2 = (10, 2);
*   $JUNCTION @ATTACH %j2;
*   %j3 = (-10, 11);
*   $JUNCTION @ATTACH %j3;
*   %j4 = (10, 11);
*   $JUNCTION @ATTACH %j4;
*   %j5 = (10, 10);
*   $JUNCTION @ATTACH %j5;
*   %j6 = (16, 10);
*   $JUNCTION @ATTACH %j6;
*   %j7 = (-10, 18);
*   $JUNCTION @ATTACH %j7;
*   %j8 = (10, 18);
*   $JUNCTION @ATTACH %j8;
*   %j9 = (16, 18);
*   $JUNCTION @ATTACH %j9;
*   %j10 = (-12, 18);
*   %j11 = (18, 18);
*   &net1 @WIRE(mode="straight") {#XMC1:3 %j1};
*   &net1 @WIRE(mode="straight") {%j1 #XMCTA:1};
*   &net0 @WIRE(mode="straight") {#XMC2:3 %j2};
*   &net0 @WIRE(mode="straight") {%j2 #XMCTB:1};
*   &net1 @WIRE(mode="straight") {#RCM:2 %j1};
*   &net0 @WIRE(mode="straight") {#RCM:1 %j2};
*   &net2 @WIRE(mode="straight") {#XMCL1:1 %j3};
*   &net2 @WIRE(mode="straight") {%j3 #XMC1:1};
*   &vctrl @WIRE(mode="straight") {#XMCL2:1 %j4};
*   &vctrl @WIRE(mode="straight") {%j4 %j5};
*   &vctrl @WIRE(mode="straight") {%j5 #XMC2:1};
*   &net2 @WIRE(mode="straight") {#XMCL1:2 (-5, 14) (-5, 11) %j3};
*   &vctrl @WIRE(mode="straight") {#XMCL2:2 (5, 14) (5, 11) %j4};
*   &vctrl @WIRE(mode="straight") {#CCM:2 %j6};
*   &vctrl @WIRE(mode="straight") {%j6 %j5};
*   &vctrl @WIRE(mode="straight") {%port5:p %j6};
*   &vdd @WIRE(mode="straight") {#XMCL1:3 %j7};
*   &vdd @WIRE(mode="straight") {#XMCL2:3 %j8};
*   &vdd @WIRE(mode="straight") {#CCM:1 %j9};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j10 %j7};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j7 %j8};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j8 %j9};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j9 %j11};
*   &vbn @WIRE(mode="straight") {#XMCTB:2 %port4:p};
*   &vbn @WIRE(mode="straight") {#XMCTA:2 %port3:p};
*   &vsense @WIRE(mode="straight") {#XMC1:2 %port1:p};
*   &vocm @WIRE(mode="straight") {#XMC2:2 %port2:p};
*   &VSS @WIRE(mode="straight") {%gnd1:p #XMCTA:3};
*   &VSS @WIRE(mode="straight") {%gnd2:p #XMCTB:3};
*   #XMCTA @TEXT("\textbf{\textit{M}}_{\textbf{CTA}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMCTA::name(label);
*   #XMCTB @TEXT("\textbf{\textit{M}}_{\textbf{CTB}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMCTB::name(label);
*   #XMC1 @TEXT("\textbf{\textit{M}}_{\textbf{C1}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMC1::name(label);
*   #XMC2 @TEXT("\textbf{\textit{M}}_{\textbf{C2}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMC2::name(label);
*   #XMCL1 @TEXT("\textbf{\textit{M}}_{\textbf{CL1}}", key="name", dx=-0.4, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMCL1::name(label);
*   #XMCL2 @TEXT("\textbf{\textit{M}}_{\textbf{CL2}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMCL2::name(label);
*   #RCM @TEXT("\textbf{\textit{R}}_{\textbf{CM}}", key="name", dx=0, dy=-2, halign="middle", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #RCM::name(label);
*   #RCM @TEXT("\textbf{5kΩ}", key="value", dx=0, dy=-4, halign="middle", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="value") #RCM::value(label);
*   #CCM @TEXT("\textbf{\textit{C}}_{\textbf{CM}}", key="name", dx=1.2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #CCM::name(label);
*   #CCM @TEXT("\textbf{100fF}", key="value", dx=1.2, dy=-2.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="value") #CCM::value(label);
*   %port1 @TEXT("\textbf{\textit{v}}_{\textbf{sense}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::name(label);
*   %port2 @TEXT("\textbf{\textit{v}}_{\textbf{ocm}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::name(label);
*   %port3 @TEXT("\textbf{\textit{v}}_{\textbf{bn}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::name(label);
*   %port4 @TEXT("\textbf{\textit{v}}_{\textbf{bn}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::name(label);
*   %port5 @TEXT("\textbf{\textit{v}}_{\textbf{ctrl}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port5::name(label);
*   &vdd @TEXT("\textbf{\textit{v}}_{\textbf{dd}}", size=1.5116) => @PLACE(19, 17) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label)
* }
.ends cmfb_amp_bp

