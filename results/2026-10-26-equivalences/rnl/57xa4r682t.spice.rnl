.subckt gmc_core_bp vdd VSS inp inn vbn outn outp vctrl
XMA outn inp net1 VSS sky130_fd_pr__nfet_01v8_lvt l=0.5 w=96 nf=8 m=1
XMB outp inn net0 VSS sky130_fd_pr__nfet_01v8_lvt l=0.5 w=96 nf=8 m=1
XMLA outn vctrl vdd vdd sky130_fd_pr__pfet_01v8 l=1 w=124 nf=10 m=1
XMLB outp vctrl vdd vdd sky130_fd_pr__pfet_01v8 l=1 w=124 nf=10 m=1
XMTA net1 vbn VSS VSS sky130_fd_pr__nfet_01v8 l=1 w=16 nf=2 m=1
XMTB net0 vbn VSS VSS sky130_fd_pr__nfet_01v8 l=1 w=16 nf=2 m=1
RDEG net0 net1 19.1kΩ
* @RNL(author="analog-canvas") {
*   %gmc_core_bp_SYMBOL = @DEFINE-SYMBOL(box=[-7, -7, 7, 7]) {
*     (-7, 2) @PIN(terminal="inp", label="\textbf{\textit{inp}}", direction="left");
*     (-7, -2) @PIN(terminal="inn", label="\textbf{\textit{inn}}", direction="left");
*     (7, -2) @PIN(terminal="outn", label="\textbf{\textit{outn}}", direction="right");
*     (7, 2) @PIN(terminal="outp", label="\textbf{\textit{outp}}", direction="right");
*     (0, 7) @PIN(terminal="vctrl", label="\textbf{\textit{v}}_{\textbf{ctrl}}", direction="up");
*     (-4, 7) @PIN(terminal="vdd", label="\textbf{\textit{v}}_{\textbf{dd}}", direction="up");
*     (0, 0) @RECTANGLE(width=12, height=12);
*     @LINE {(-7, 2) (-6, 2)};
*     @LINE {(-7, -2) (-6, -2)};
*     @LINE {(4, 7) (4, 6)};
*     @LINE {(7, -2) (6, -2)};
*     @LINE {(7, 2) (6, 2)};
*     @LINE {(0, 7) (0, 6)};
*     @LINE {(-4, 7) (-4, 6)}
*   };
*   # @SET-SYMBOL %gmc_core_bp_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XMTA @SET-SYMBOL $NMOS => @PLACE(-10, -2) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MTA") #XMTA(part);
*   #XMTB @SET-SYMBOL $NMOS => @PLACE(10, -2) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MTB") #XMTB(part);
*   #XMA @SET-SYMBOL $NMOS => @PLACE(-10, 6) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MA") #XMA(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.5u") #XMA(part);
*   #XMB @SET-SYMBOL $NMOS => @PLACE(10, 6) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MB") #XMB(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.5u") #XMB(part);
*   #RDEG @SET-SYMBOL $RESISTOR => @PLACE(0, 2) => @ORIENT("R270");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(-10, -4) => @ORIENT("R0") => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(10, -4) => @ORIENT("R0") => %gnd2;
*   $IO_PORT @ATTACH &inp(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-13, 6) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &inn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(13, 6) => @ORIENT("MY") => %port2;
*   $IO_PORT @ATTACH &vbn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-13, -2) => @ORIENT("R0") => %port3;
*   $IO_PORT @ATTACH &vbn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(13, -2) => @ORIENT("MY") => %port4;
*   $IO_PORT @ATTACH &outn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-16, 10) => @ORIENT("R0") => %port5;
*   $IO_PORT @ATTACH &outp(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(16, 10) => @ORIENT("MY") => %port6;
*   #XMLA @SET-SYMBOL $PMOS => @PLACE(-10, 14) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MLA") #XMLA(part);
*   #XMLB @SET-SYMBOL $PMOS => @PLACE(10, 14) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MLB") #XMLB(part);
*   $IO_PORT @ATTACH &vctrl(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-13, 14) => @ORIENT("R0") => %port7;
*   $IO_PORT @ATTACH &vctrl(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(13, 14) => @ORIENT("MY") => %port8;
*   &vdd @REMOVE-FROM $PORT_FILL_SET;
*   &VSS @REMOVE-FROM $PORT_FILL_SET;
*   %j1 = (-10, 2);
*   $JUNCTION @ATTACH %j1;
*   %j2 = (10, 2);
*   $JUNCTION @ATTACH %j2;
*   %j3 = (-10, 10);
*   $JUNCTION @ATTACH %j3;
*   %j4 = (10, 10);
*   $JUNCTION @ATTACH %j4;
*   %j5 = (-10, 18);
*   $JUNCTION @ATTACH %j5;
*   %j6 = (10, 18);
*   $JUNCTION @ATTACH %j6;
*   %j7 = (-12, 18);
*   %j8 = (12, 18);
*   &net1 @WIRE(mode="straight") {#XMA:3 %j1};
*   &net1 @WIRE(mode="straight") {%j1 #XMTA:1};
*   &net0 @WIRE(mode="straight") {#XMB:3 %j2};
*   &net0 @WIRE(mode="straight") {%j2 #XMTB:1};
*   &net1 @WIRE(mode="straight") {#RDEG:2 %j1};
*   &net0 @WIRE(mode="straight") {#RDEG:1 %j2};
*   &outn @WIRE(mode="straight") {#XMLA:1 %j3};
*   &outn @WIRE(mode="straight") {%j3 #XMA:1};
*   &outp @WIRE(mode="straight") {#XMLB:1 %j4};
*   &outp @WIRE(mode="straight") {%j4 #XMB:1};
*   &outn @WIRE(mode="straight") {%port5:p %j3};
*   &outp @WIRE(mode="straight") {%port6:p %j4};
*   &vdd @WIRE(mode="straight") {#XMLA:3 %j5};
*   &vdd @WIRE(mode="straight") {#XMLB:3 %j6};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j7 %j5};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j5 %j6};
*   &vdd @WIRE(mode="straight", linestyle="bold") {%j6 %j8};
*   &vbn @WIRE(mode="straight") {#XMTB:2 %port4:p};
*   &vbn @WIRE(mode="straight") {#XMTA:2 %port3:p};
*   &vctrl @WIRE(mode="straight") {#XMLA:2 %port7:p};
*   &vctrl @WIRE(mode="straight") {#XMLB:2 %port8:p};
*   &inp @WIRE(mode="straight") {#XMA:2 %port1:p};
*   &inn @WIRE(mode="straight") {#XMB:2 %port2:p};
*   &VSS @WIRE(mode="straight") {%gnd1:p #XMTA:3};
*   &VSS @WIRE(mode="straight") {%gnd2:p #XMTB:3};
*   #XMTA @TEXT("\textbf{\textit{M}}_{\textbf{TA}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMTA::name(label);
*   #XMTB @TEXT("\textbf{\textit{M}}_{\textbf{TB}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMTB::name(label);
*   #XMA @TEXT("\textbf{\textit{M}}_{\textbf{A}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMA::name(label);
*   #XMB @TEXT("\textbf{\textit{M}}_{\textbf{B}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMB::name(label);
*   #RDEG @TEXT("\textbf{\textit{R}}_{\textbf{DEG}}", key="name", dx=0, dy=-2, halign="middle", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #RDEG::name(label);
*   #RDEG @TEXT("\textbf{19.1kΩ}", key="value", dx=0, dy=-4, halign="middle", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="value") #RDEG::value(label);
*   %port1 @TEXT("\textbf{\textit{inp}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::name(label);
*   %port2 @TEXT("\textbf{\textit{inn}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::name(label);
*   %port3 @TEXT("\textbf{\textit{v}}_{\textbf{bn}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::name(label);
*   %port4 @TEXT("\textbf{\textit{v}}_{\textbf{bn}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::name(label);
*   %port5 @TEXT("\textbf{\textit{outn}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port5::name(label);
*   %port6 @TEXT("\textbf{\textit{outp}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port6::name(label);
*   #XMLA @TEXT("\textbf{\textit{M}}_{\textbf{LA}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMLA::name(label);
*   #XMLB @TEXT("\textbf{\textit{M}}_{\textbf{LB}}", key="name", dx=-0.4, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMLB::name(label);
*   %port7 @TEXT("\textbf{\textit{v}}_{\textbf{ctrl}}", key="name", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port7::name(label);
*   %port8 @TEXT("\textbf{\textit{v}}_{\textbf{ctrl}}", key="name", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116);
*   $CANVAS_LABEL @ATTACH(bind="port") %port8::name(label);
*   &vdd @TEXT("\textbf{\textit{v}}_{\textbf{dd}}", size=1.5116) => @PLACE(13, 17) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label)
* }
.ends gmc_core_bp

.subckt gmc_core vdd VSS inp inn vbn outn outp vctrl
