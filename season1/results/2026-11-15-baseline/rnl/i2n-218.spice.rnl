
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @USE-PACKAGE(name="rnl-std-functional", version="0.4")
* }
.subckt opamp VIP VIN VDD VSS VOUT params: gain=1e6 vhigh=5 vlow=-5
Blin nlin 0 V={gain*(V(VIP)-V(VIN))}
Bcore VOUT 0 V={0.5*(vhigh+(0.5*(vlow+V(nlin)+sqrt((V(nlin)-vlow)*(V(nlin)-vlow)+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12)))-sqrt((vhigh-(0.5*(vlow+V(nlin)+sqrt((V(nlin)-vlow)*(V(nlin)-vlow)+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12))))*(vhigh-(0.5*(vlow+V(nlin)+sqrt((V(nlin)-vlow)*(V(nlin)-vlow)+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12))))+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12))}
.ends opamp

.subckt opamp_differential VIP VIN VOP VON VDD VSS params: gain=1e6 vocm=0
VCM ncm 0 DC {vocm}
EPLUS VOP ncm VIP VIN {gain/2}
EMINUS VON ncm VIN VIP {gain/2}
.ends opamp_differential

.subckt dut VSS vin vout vin+ vout+ vin- vout- phi1d phi2 phi2d phi1
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
C1 net4 net3 1p
C2 net6 net10 1p
C3 net9 vout+ 1p
C4 net0 net5 1p
C5 net7 net11 1p
C6 net2 vout- 1p
C7 net8 net1 1p
S1 vin net4 phi1d VSS ideal_switch
S10 net0 net9 phi2 VSS ideal_switch
S11 net5 vout- phi1d VSS ideal_switch
S12 vin- net7 phi1d VSS ideal_switch
S13 net7 VSS phi2d VSS ideal_switch
S14 net11 VSS phi1 VSS ideal_switch
S15 net11 net2 phi2 VSS ideal_switch
S16 VSS net8 phi1 VSS ideal_switch
S17 net1 VSS phi2d VSS ideal_switch
S18 net8 net2 phi2 VSS ideal_switch
S19 net1 vout+ phi1d VSS ideal_switch
S2 net4 vout phi2 VSS ideal_switch
S3 net3 vout phi1 VSS ideal_switch
S4 vin+ net6 phi1d VSS ideal_switch
S5 net6 VSS phi2d VSS ideal_switch
S6 net10 VSS phi1 VSS ideal_switch
S7 net10 net9 phi2 VSS ideal_switch
S8 VSS net0 phi1 VSS ideal_switch
S9 net5 VSS phi2d VSS ideal_switch
X1 VSS net3 0 VSS vout opamp gain=1e6
X2 net2 net9 vout+ vout- 0 VSS opamp_differential gain=1e6 vocm=0
