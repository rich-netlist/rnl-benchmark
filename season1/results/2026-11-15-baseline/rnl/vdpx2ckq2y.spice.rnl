.subckt bootstrap_gate_driver VDD VIN VSS hinb hin sw linb
Cbs bst sw 1nF
XMB bst VDD VDD VSS sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=20 nf=1 m=1
XMC1 sw sw net0 sw sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=1 nf=1 m=1
XMC2 sw sw b sw sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=1 nf=1 m=1
XMH VIN net2 sw sw sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=20 nf=1 m=10
XML sw net1 VSS VSS sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=20 nf=1 m=10
XMN1 net0 hinb VSS VSS sky130_fd_pr__nfet_g5v0d10v5 l=10 w=1 nf=1 m=1
XMN2 b hin VSS VSS sky130_fd_pr__nfet_g5v0d10v5 l=10 w=1 nf=1 m=1
XMNH net2 b sw sw sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=4 nf=1 m=1
XMNL net1 linb VSS VSS sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=4 nf=1 m=1
XMP1 net0 b bst bst sky130_fd_pr__pfet_g5v0d10v5 l=10 w=1 nf=1 m=1
XMP2 b net0 bst bst sky130_fd_pr__pfet_g5v0d10v5 l=10 w=1 nf=1 m=1
XMPH net2 b bst bst sky130_fd_pr__pfet_g5v0d10v5 l=0.5 w=8 nf=1 m=1
