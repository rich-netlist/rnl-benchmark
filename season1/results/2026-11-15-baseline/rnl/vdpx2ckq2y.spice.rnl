*     (6, 1) @PIN(terminal="sw", label="\textbf{\textit{sw}}", direction="right");
*     (6, -1) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="right");
*     (6, -3) @PIN(terminal="linb", label="\textbf{\textit{linb}}", direction="right");
*     (0, 6) @PIN(terminal="VIN", label="\textbf{\textit{V}}_{\textbf{IN}}", direction="up");
*     (0, 0) @RECTANGLE(width=10, height=10);
*     @LINE {(-6, 0) (-5, 0)};
*     @LINE {(-6, -2) (-5, -2)};
*     @LINE {(6, 1) (5, 1)};
*     @LINE {(6, -1) (5, -1)};
*     @LINE {(6, -3) (5, -3)};
*     @LINE {(0, 6) (0, 5)}
