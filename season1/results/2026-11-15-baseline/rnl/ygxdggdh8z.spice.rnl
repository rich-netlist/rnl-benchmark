
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt dut VDD VSS CKB1 CKB2 CK1 CK2 Voutn Voutp
C1 net0 VSS 1p
C2 net1 VSS 1p
XM1 Voutp CKB2 VDD VDD sg13_lv_pmos w=1u l=150n ng=1 m=1
XM2 Voutn CKB1 VDD VDD sg13_lv_pmos w=1u l=150n ng=1 m=1
XM3 Voutp Voutn net1 VSS sg13_lv_nmos w=1u l=150n ng=1 m=1
XM4 Voutn Voutp net0 VSS sg13_lv_nmos w=1u l=150n ng=1 m=1
XM5 net0 CK1 VSS VSS sg13_lv_nmos w=1u l=150n ng=1 m=1
XM6 net1 CK2 VSS VSS sg13_lv_nmos w=1u l=150n ng=1 m=1
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-7, -6, 7, 6]) {
*     (0, 6) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (-7, 1) @PIN(terminal="CKB1", label="\textbf{\textit{CKB}}_{\textbf{1}}", direction="left");
*     (7, 1) @PIN(terminal="CKB2", label="\textbf{\textit{CKB}}_{\textbf{2}}", direction="right");
*     (-7, -3) @PIN(terminal="CK1", label="\textbf{\textit{CK}}_{\textbf{1}}", direction="left");
*     (7, -3) @PIN(terminal="CK2", label="\textbf{\textit{CK}}_{\textbf{2}}", direction="right");
*     (-7, -1) @PIN(terminal="Voutn", label="\textbf{\textit{V}}_{\textbf{outn}}", direction="left");
*     (7, -1) @PIN(terminal="Voutp", label="\textbf{\textit{V}}_{\textbf{outp}}", direction="right");
*     (0, 0) @RECTANGLE(width=12, height=10);
*     @LINE {(0, 6) (0, 5)};
*     @LINE {(-7, 1) (-6, 1)};
*     @LINE {(7, 1) (6, 1)};
*     @LINE {(-7, -3) (-6, -3)};
*     @LINE {(7, -3) (6, -3)};
*     @LINE {(-7, -1) (-6, -1)};
*     @LINE {(7, -1) (6, -1)}
*   };
*   # @SET-SYMBOL %dut_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XM2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(20, -13) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M2") #XM2(part);
*   #XM3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(35, -21) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M3") #XM3(part);
*   #XM4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(20, -21) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M4") #XM4(part);
*   #XM5 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(20, -28) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M5") #XM5(part);
*   #XM6 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(35, -28) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M6") #XM6(part);
*   #C1 @SET-SYMBOL $VARIABLE_CAPACITOR => @PLACE(11, -28) => @ORIENT("R0");
*   #C2 @SET-SYMBOL $VARIABLE_CAPACITOR => @PLACE(42, -28) => @ORIENT("R0");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(20, -30) => @ORIENT("R0") => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(35, -30) => @ORIENT("R0") => %gnd2;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(42, -30) => @ORIENT("R0") => %gnd3;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(11, -30) => @ORIENT("R0") => %gnd4;
*   #XM1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(35, -13) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M1") #XM1(part);
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(20, -11) => @ORIENT("R0") => %vdd1;
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(35, -11) => @ORIENT("R0") => %vdd2;
*   $IO_PORT @ATTACH &CKB1(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(23, -13) => @ORIENT("MY") => %port1;
*   $IO_PORT @ATTACH &CKB2(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(32, -13) => @ORIENT("R0") => %port2;
*   $IO_PORT @ATTACH &CK1(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(23, -28) => @ORIENT("MY") => %port3;
*   $IO_PORT @ATTACH &CK2(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(32, -28) => @ORIENT("R0") => %port4;
*   $IO_PORT @ATTACH &Voutn(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(18, -17) => @ORIENT("R0") => %port5;
*   $IO_PORT @ATTACH &Voutp(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(37, -17) => @ORIENT("MY") => %port6;
*   %j1 = (20, -17);
*   %j2 = (35, -17);
*   &net0 @WIRE(mode="straight") {#C1:1 #XM5:1};
*   &net0 @WIRE(mode="straight") {#XM5:1 #XM4:3};
*   &net1 @WIRE(mode="straight") {#XM3:3 #XM6:1};
*   &net1 @WIRE(mode="straight") {#C2:1 #XM6:1};
*   &Voutp @WIRE(mode="straight") {#XM4:2 (26, -21) (29, -17) %j2};
*   &Voutp @WIRE(mode="straight") {%j2 #XM3:1};
*   &Voutn @WIRE(mode="straight") {#XM3:2 (29, -21) (25, -17) %j1};
*   &Voutn @WIRE(mode="straight") {%j1 #XM2:1};
*   &Voutn @WIRE(mode="straight") {%j1 #XM4:1};
*   &Voutp @WIRE(mode="straight") {#XM1:1 %j2};
*   &Voutp @WIRE(mode="straight") {%port6::pin %j2};
*   &Voutn @WIRE(mode="straight") {%j1 %port5::pin};
*   $JUNCTION @ATTACH %j1(p) => @PLACE(20, -17) => %dot1;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(35, -17) => %dot2;
*   &VSS @WIRE(mode="straight") {%gnd1::pin #XM5:3};
*   &VSS @WIRE(mode="straight") {%gnd2::pin #XM6:3};
*   &VSS @WIRE(mode="straight") {#C2:2 %gnd3::pin};
*   &VSS @WIRE(mode="straight") {#C1:2 %gnd4::pin};
*   &CKB1 @WIRE(mode="straight") {#XM2:2 %port1::pin};
*   &CK1 @WIRE(mode="straight") {#XM5:2 %port3::pin};
*   &CKB2 @WIRE(mode="straight") {#XM1:2 %port2::pin};
*   &CK2 @WIRE(mode="straight") {#XM6:2 %port4::pin};
*   &VDD @WIRE(mode="straight") {#XM2:3 %vdd1::pin};
*   &VDD @WIRE(mode="straight") {#XM1:3 %vdd2::pin};
*   $JUNCTION @ATTACH (20, -26)(p) => @PLACE(20, -26) => %dot3;
*   $JUNCTION @ATTACH (35, -26)(p) => @PLACE(35, -26) => %dot4;
*   #XM2
*       @TEXT("\textbf{\textit{M}}_{\textbf{2}}", key="name", dx=-0.4, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM2::name(label);
*   #XM3
*       @TEXT("\textbf{\textit{M}}_{\textbf{3}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM3::name(label);
*   #XM4
*       @TEXT("\textbf{\textit{M}}_{\textbf{4}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM4::name(label);
*   #XM5
*       @TEXT("\textbf{\textit{M}}_{\textbf{5}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM5::name(label);
*   #XM6
*       @TEXT("\textbf{\textit{M}}_{\textbf{6}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM6::name(label);
*   #C1
*       @TEXT("\textbf{\textit{C}}_{\textbf{1}}", key="name", dx=1.6, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #C1::name(label);
*   #C2
*       @TEXT("\textbf{\textit{C}}_{\textbf{2}}", key="name", dx=1.6, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #C2::name(label);
*   #XM1
*       @TEXT("\textbf{\textit{M}}_{\textbf{1}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM1::name(label);
*   %vdd1 @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", dx=-1.5, dy=3, size=1.5116, bold=false) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   %vdd2 @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", dx=-1.5, dy=3, size=1.5116, bold=false) => %power2;
*   $CANVAS_LABEL @ATTACH(bind="port") %power2(label);
*   %port1
*       @TEXT("\textbf{\textit{CKB}}_{\textbf{1}}", key="netname", dx=-0.5, dy=1, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{CKB}}_{\textbf{2}}", key="netname", dx=0, dy=1, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %port3
*       @TEXT("\textbf{\textit{CK}}_{\textbf{1}}", key="netname", dx=-0.5, dy=1, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
*   %port4
*       @TEXT("\textbf{\textit{CK}}_{\textbf{2}}", key="netname", dx=0, dy=1, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::netname(label);
*   %port5
*       @TEXT("\textbf{\textit{V}}_{\textbf{outn}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port5::netname(label);
*   %port6
*       @TEXT("\textbf{\textit{V}}_{\textbf{outp}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port6::netname(label);
*   %vdd1 @TEXT("${p}", key="netname", textvisible=false);
*   %vdd2 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends dut
