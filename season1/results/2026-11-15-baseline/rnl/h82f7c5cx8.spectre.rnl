subckt banba_bandgap (VDD VSS vbn vref)
M1 (net3 net4 VDD VDD) sky130_fd_pr__pfet_01v8_lvt l=2 w=4 nf=1 m=1
M2 (net6 net4 VDD VDD) sky130_fd_pr__pfet_01v8_lvt l=2 w=4 nf=1 m=1
M3 (vref net4 VDD VDD) sky130_fd_pr__pfet_01v8_lvt l=2 w=4 nf=1 m=1
M4 (net1 net6 net5 VSS) sky130_fd_pr__nfet_01v8_lvt l=1 w=4 nf=1 m=1
M5 (net4 net3 net5 VSS) sky130_fd_pr__nfet_01v8_lvt l=1 w=4 nf=1 m=1
M6 (net1 net1 VDD VDD) sky130_fd_pr__pfet_01v8_lvt l=2 w=2 nf=1 m=1
M7 (net4 net1 VDD VDD) sky130_fd_pr__pfet_01v8_lvt l=2 w=2 nf=1 m=1
M8 (net5 vbn VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=2 nf=1 m=1
MS1 (net4 net2 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MS2 (net2 vref VSS VSS) sky130_fd_pr__nfet_01v8_lvt l=0.5 w=4 nf=1 m=4
MS3 (net2 VSS VDD VDD) sky130_fd_pr__pfet_01v8 l=8 w=0.5 nf=1 m=1
Q1 (VSS VSS net3) sky130_fd_pr__pnp_05v5_W0p68L0p68 m=1
Q2 (VSS VSS net0) sky130_fd_pr__pnp_05v5_W0p68L0p68 m=8
R1 (net6 net0) resistor r=17k
R2a (net3 VSS) resistor r=120k
R2b (net6 VSS) resistor r=120k
R3 (vref VSS) resistor r=56k
