
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt dut VDD VSS VI+ VI- S1 S10 S11 S12 S2 S3 S4 S5 S6 S7 S8 S9
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
C1 net1 VSS 1p
C2 Vo- VSS 1p
C3 net6 net7 1p
C5 Vo+ VSS 1p
C6 net5 VSS 1p
Cpai net2 VSS 1p
Cpair net4 VSS 1p
XM1 net1 VI+ net0 VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 net2 VI- net0 VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 Vo- VCM net1 VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 Vo- VCM net4 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 net4 VI+ net3 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 Vo+ VCM net2 VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM7 Vo+ VCM net5 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM8 net5 VI- net3 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
S1 net1 VCM S1 VSS ideal_switch
S10 VDD net6 S10 VSS ideal_switch
S11 net3 net7 S11 VSS ideal_switch
S12 VSS net7 S12 VSS ideal_switch
S2 net0 VCM S2 VSS ideal_switch
S3 Vo- VCM S3 VSS ideal_switch
S4 net4 VCM S4 VSS ideal_switch
S5 VCM net3 S5 VSS ideal_switch
S6 net0 net6 S6 VSS ideal_switch
S7 net2 VCM S7 VSS ideal_switch
S8 Vo+ VCM S8 VSS ideal_switch
S9 net5 VCM S9 VSS ideal_switch
