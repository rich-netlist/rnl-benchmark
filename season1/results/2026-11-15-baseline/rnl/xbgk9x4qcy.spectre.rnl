simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt limiting_amp_oc (VDD VSS vinp vinn voutp voutn)
Cf1 (net3 VSS) capacitor c=20p
Cf2 (net4 VSS) capacitor c=20p
IREF (VDD net1) isource dc=50u
M1a (x1 vinp net7 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=1
M1b (y1 vinn net7 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=1
M2a (x2 y1 net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=1
M2b (net6 x1 net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=1
M3a (voutn net6 net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=1
M3b (voutp x2 net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=1
MB (net1 net1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=2 nf=1 m=1
Mo1 (y1 net3 net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=1 m=1
Mo2 (x1 net4 net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=1 m=1
MT1 (net7 net1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=8 nf=1 m=1
MT2 (net5 net1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=8 nf=1 m=1
MT3 (net2 net1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=8 nf=1 m=1
MTo (net0 net1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=4 nf=1 m=1
R1a (VDD x1) resistor r=2k
R1b (VDD y1) resistor r=2k
R2a (VDD x2) resistor r=2k
R2b (VDD net6) resistor r=2k
R3a (VDD voutn) resistor r=2k
R3b (VDD voutp) resistor r=2k
Rf1 (voutp net3) resistor r=200k
Rf2 (voutn net4) resistor r=200k
