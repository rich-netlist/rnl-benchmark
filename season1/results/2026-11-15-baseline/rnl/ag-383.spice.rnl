*   $CANVAS_LABEL @ATTACH(bind="name") #RS::name(label);
*   #XM5
*       @TEXT("\textbf{\textit{M}}_{\textbf{5}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM5::name(label);
*   #Ra
*       @TEXT("\textbf{\textit{R}}_{\textbf{a}}", key="name", dx=-0.9, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #Ra::name(label);
*   #Rb
*       @TEXT("\textbf{\textit{R}}_{\textbf{b}}", key="name", dx=-0.9, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #Rb::name(label);
