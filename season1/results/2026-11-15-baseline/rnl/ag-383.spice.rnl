*   $JUNCTION @ATTACH %j11(p) => @PLACE(22, -3) => %dot1;
*   $JUNCTION @ATTACH %j6(p) => @PLACE(5, 0) => %dot2;
*   $JUNCTION @ATTACH %j7(p) => @PLACE(9, -4) => %dot3;
*   $JUNCTION @ATTACH %j10(p) => @PLACE(9, -6) => %dot4;
*   $JUNCTION @ATTACH %j12(p) => @PLACE(22, -10) => %dot5;
*   $JUNCTION @ATTACH %j8(p) => @PLACE(-1, -6) => %dot6;
*   $JUNCTION @ATTACH %j9(p) => @PLACE(3, -10) => %dot7;
*   $JUNCTION @ATTACH %j3(p) => @PLACE(-1, 4) => %dot8;
*   $JUNCTION @ATTACH %j4(p) => @PLACE(9, 4) => %dot9;
*   $JUNCTION @ATTACH %j5(p) => @PLACE(22, 4) => %dot10;
*   &VSS @WIRE(mode="straight") {%gnd1::pin #XM1:3};
*   &VSS @WIRE(mode="straight") {%gnd2::pin #RS:2};
*   &VSS @WIRE(mode="straight") {%gnd3::pin #XM5:3};
