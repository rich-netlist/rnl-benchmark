simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt lvds_driver (VDD VSS dn dp outp outn vref ibias)
CC1 (net4 outp) capacitor c=1p
CC2 (net4 outn) capacitor c=1p
M1 (outp dn net0 VDD) sky130_fd_pr__pfet_g5v0d10v5 l=0.5 w=5 nf=1 m=48
M10 (net4 net3 VSS VSS) sky130_fd_pr__nfet_g5v0d10v5 l=1 w=5 nf=1 m=1
M11 (net1 ibias VDD VDD) sky130_fd_pr__pfet_g5v0d10v5 l=1 w=5 nf=1 m=1
M2 (outn dp net0 VDD) sky130_fd_pr__pfet_g5v0d10v5 l=0.5 w=5 nf=1 m=48
M3 (outp dn net2 VSS) sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=5 nf=1 m=12
M4 (outn dp net2 VSS) sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=5 nf=1 m=12
M5 (net0 ibias VDD VDD) sky130_fd_pr__pfet_g5v0d10v5 l=1 w=5 nf=1 m=70
M6 (net2 net4 VSS VSS) sky130_fd_pr__nfet_g5v0d10v5 l=1 w=5 nf=1 m=40
M7 (net3 vcm net1 VDD) sky130_fd_pr__pfet_g5v0d10v5 l=1 w=5 nf=1 m=2
M8 (net4 vref net1 VDD) sky130_fd_pr__pfet_g5v0d10v5 l=1 w=5 nf=1 m=2
M9 (net3 net3 VSS VSS) sky130_fd_pr__nfet_g5v0d10v5 l=1 w=5 nf=1 m=1
MB (ibias ibias VDD VDD) sky130_fd_pr__pfet_g5v0d10v5 l=1 w=5 nf=1 m=2
R1 (vcm outp) resistor r=10k
R2 (outn vcm) resistor r=10k
RT (outn outp) resistor r=100
