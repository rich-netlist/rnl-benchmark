*     (7, 0) @PIN(terminal="voutn", label="\textbf{\textit{v}}_{\textbf{outn}}", direction="right");
*     (-7, -3) @PIN(terminal="vrfp", label="\textbf{\textit{v}}_{\textbf{rfp}}", direction="left");
*     (7, -2) @PIN(terminal="vrfn", label="\textbf{\textit{v}}_{\textbf{rfn}}", direction="right");
