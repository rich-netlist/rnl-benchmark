*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt cc_common_gate_lna VDD VSS vb vbn voutp voutn vrfp vrfn
Cc1 net6 net4 2pF
Cc2 net9 net8 2pF
CD1 VDD net0 0.58pF
CD2 VDD net1 0.58pF
Cin1 net4 vrfp 5pF
Cin2 vrfn net8 5pF
L1 VDD net7 7nH
L2 VDD net5 7nH
Ls1 net4 net2 10nH
Ls2 net8 net3 10nH
XM1 net0 net9 net4 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=30 nf=6 m=1
XM2 net1 net6 net8 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=30 nf=6 m=1
XM3 VDD net0 voutp VSS sky130_fd_pr__nfet_01v8 l=0.15 w=20 nf=4 m=1
XM4 VDD net1 voutn VSS sky130_fd_pr__nfet_01v8 l=0.15 w=20 nf=4 m=1
XM5 voutp vbn VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=20 nf=4 m=1
XM6 voutn vbn VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=20 nf=4 m=1
Rb1 vb net9 10kΩ
Rb2 vb net6 10kΩ
RL1 net7 net0 10.8Ω
RL2 net5 net1 10.8Ω
RLS1 net2 VSS 15.4Ω
RLS2 net3 VSS 15.4Ω
* @RNL(author="analog-canvas") {
