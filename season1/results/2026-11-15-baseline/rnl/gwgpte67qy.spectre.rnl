simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt dut (VDD VSS VB2 Vip Voutp Voutn Vin VB1 VB3 CKS)
subckt ideal_switch (p n cp cn)
parameters ron=1 roff=1e12 vt=0.5
core (p n) bsource i=v(p,n)/(v(cp,cn)>vt ? ron : roff)
ends ideal_switch
C1 (net1 Vip) capacitor c=1p
C2 (Voutp VSS) capacitor c=1p
C3 (Voutn VSS) capacitor c=1p
C4 (net2 Vin) capacitor c=1p
C5 (net11 net8) capacitor c=1p
M1 (VDD net1 net3 net3) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M10 (net0 net10 VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M11 (net7 VB1 VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M12 (net11 VB3 net7 net7) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M13 (net10 Vin net11 net11) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M14 (net10 net10 VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M2 (net3 Vip net5 net5) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M3 (net5 net9 VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M4 (net6 VB1 VDD VDD) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M5 (net8 VB3 net6 net6) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M6 (net9 Vip net8 net8) pch_ulvt_mac l=150n m=1 nf=1 w=1u
M7 (net9 net9 VSS VSS) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M8 (VDD net2 net4 net4) nch_ulvt_mac l=150n m=1 nf=1 w=1u
M9 (net4 Vin net0 net0) nch_ulvt_mac l=150n m=1 nf=1 w=1u
R1 (net1 VB2) resistor r=1k
R2 (net2 VB2) resistor r=1k
S1 (net5 Voutp CKS VSS) ideal_switch
S2 (net0 Voutn CKS VSS) ideal_switch
