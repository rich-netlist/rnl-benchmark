
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt dut VDD VSS VREF VBN V_DDREG
C1 VDD V_DDREG 1p
XM1 V_DDREG VGATE VDD VDD sg13_lv_pmos w=1u l=150n ng=1 m=1
XM2 VGATE VREFSF V_DDREG VDD sg13_lv_pmos w=1u l=150n ng=1 m=1
XM3 V_DDREG VREF VREFSF VSS sg13_lv_nmos w=1u l=150n ng=1 m=1
XM4 VREFSF VBN VSS VSS sg13_lv_nmos w=1u l=150n ng=1 m=1
XM5 VGATE VBN VSS VSS sg13_lv_nmos w=1u l=150n ng=1 m=1
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-6, -6, 6, 6]) {
*     (0, 6) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (6, -1) @PIN(terminal="VREF", label="\textbf{\textit{V}}_{\textbf{REF}}", direction="right");
*     (6, -3) @PIN(terminal="VBN", label="\textbf{\textit{V}}_{\textbf{BN}}", direction="right");
*     (6, 1) @PIN(terminal="V_DDREG", label="\textbf{\textit{V}}_{\textbf{DDREG}}", direction="right");
*     (0, 0) @RECTANGLE(width=10, height=10);
*     @LINE {(0, 6) (0, 5)};
*     @LINE {(6, -1) (5, -1)};
*     @LINE {(6, -3) (5, -3)};
*     @LINE {(6, 1) (5, 1)}
*   };
*   # @SET-SYMBOL %dut_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XM1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(26, -3) => @ORIENT("R90");
*   $CANVAS_NAME @ATTACH(name="M1") #XM1(part);
*   #C1 @SET-SYMBOL $CAPACITOR => @PLACE(26, 2) => @ORIENT("R90");
*   #XM2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(35, -10) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M2") #XM2(part);
*   #XM3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(44, -6) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M3") #XM3(part);
*   #XM4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(44, -16) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M4") #XM4(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(35, -22) => @ORIENT("R0") => %gnd1;
*   #XM5 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(35, -16) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M5") #XM5(part);
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(16, -3) => @ORIENT("R0") => %vdd1;
*   $IO_PORT @ATTACH &VREF(p) => @SET-SYMBOL $CANVAS_PORT_FILLED => @PLACE(47, -6) => @ORIENT("MY") => %port1;
*   $IO_PORT @ATTACH &VBN(p) => @SET-SYMBOL $CANVAS_PORT_FILLED => @PLACE(47, -16) => @ORIENT("MY") => %port2;
*   $IO_PORT @ATTACH &V_DDREG(p) => @SET-SYMBOL $CANVAS_PORT_FILLED => @PLACE(50, -3) => @ORIENT("MY") => %port3;
*   %j1 = (50, -3);
*   %j2 = (44, -3);
*   %j3 = (35, -13);
*   %j4 = (35, -3);
*   %j5 = (44, -10);
*   %j6 = (35, -20);
*   &VSS @WIRE(mode="straight") {%gnd1::pin %j6};
*   &VSS @WIRE(mode="straight") {%j6 (44, -20) #XM4:3};
*   &V_DDREG @WIRE(mode="straight") {#XM1:1 %j4};
*   &V_DDREG @WIRE(mode="straight") {%j4 %j2};
*   &V_DDREG @WIRE(mode="straight") {%j2 %j1};
*   &V_DDREG @WIRE(mode="straight") {#XM3:1 %j2};
*   &V_DDREG @WIRE(mode="straight") {#C1:2 #XM1:1};
*   &VDD @WIRE(mode="straight") {%vdd1::pin #XM1:3};
*   &VDD @WIRE(mode="straight") {#C1:1 #XM1:3};
*   &VGATE @WIRE(mode="straight") {#XM1:2 (26, -13) %j3} => %wire1;
*   &VGATE @WIRE(mode="straight") {#XM2:1 %j3};
*   &VGATE @WIRE(mode="straight") {%j3 #XM5:1};
*   &V_DDREG @WIRE(mode="straight") {#XM2:3 %j4};
*   &VREFSF @WIRE(mode="straight") {#XM3:3 %j5};
*   &VREFSF @WIRE(mode="straight") {%j5 #XM4:1};
*   &VREFSF @WIRE(mode="straight") {#XM2:2 %j5} => %wire2;
*   &VBN @WIRE(mode="straight") {#XM4:2 #XM5:2};
*   &VSS @WIRE(mode="straight") {#XM5:3 %j6};
*   $JUNCTION @ATTACH %j3(p) => @PLACE(35, -13) => %dot1;
*   &VREF @WIRE(mode="straight") {#XM3:2 %port1::pin};
*   $JUNCTION @ATTACH %j6(p) => @PLACE(35, -20) => %dot2;
*   $JUNCTION @ATTACH (28, -3)(p) => @PLACE(28, -3) => %dot3;
*   $JUNCTION @ATTACH %j4(p) => @PLACE(35, -3) => %dot4;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(44, -3) => %dot5;
*   &V_DDREG @WIRE(mode="straight") {%j1 %port3::pin};
*   $JUNCTION @ATTACH (24, -3)(p) => @PLACE(24, -3) => %dot6;
*   $JUNCTION @ATTACH %j5(p) => @PLACE(44, -10) => %dot7;
*   &VBN @WIRE(mode="straight") {#XM4:2 %port2::pin};
*   #XM1
*       @TEXT("\textbf{\textit{M}}_{\textbf{1}}", key="name", dx=0, dy=0.9, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM1::name(label);
*   #C1
*       @TEXT("\textbf{\textit{C}}_{\textbf{1}}", key="name", dx=0, dy=1.7, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #C1::name(label);
*   #XM2
*       @TEXT("\textbf{\textit{M}}_{\textbf{2}}", key="name", dx=-0.4, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM2::name(label);
*   #XM3
*       @TEXT("\textbf{\textit{M}}_{\textbf{3}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM3::name(label);
*   #XM4
*       @TEXT("\textbf{\textit{M}}_{\textbf{4}}", key="name", dx=3, dy=2, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM4::name(label);
*   #XM5
*       @TEXT("\textbf{\textit{M}}_{\textbf{5}}", key="name", dx=-0.5, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM5::name(label);
*   %vdd1 @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", dx=-1.5, dy=3, size=1.5116, bold=false) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   %port1
*       @TEXT("\textbf{\textit{V}}_{\textbf{REF}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{V}}_{\textbf{BN}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %port3
*       @TEXT("\textbf{\textit{V}}_{\textbf{DDREG}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
*   %wire2 @TEXT("\textbf{\textit{V}}_{\textbf{REFSF}}", size=1.5116, bold=false) => @PLACE(38.2853, -9) => %label1;
*   $CANVAS_LABEL @ATTACH(bind="net") %label1(label);
*   %wire1 @TEXT("\textbf{\textit{V}}_{\textbf{GATE}}", size=1.5116, bold=false) => @PLACE(27.206696, -12) => %label2;
*   $CANVAS_LABEL @ATTACH(bind="net") %label2(label);
*   %vdd1 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends dut
