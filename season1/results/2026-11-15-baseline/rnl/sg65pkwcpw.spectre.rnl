simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt ffe3_cml_driver (VDD VSS txn txp den dep vcas vpre dp dn vmain dln dlp vpost)
M1 (txn den net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=16
M2 (txp dep net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=16
M3 (txn dp net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=48
M4 (txp dn net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=48
M5 (txn dln net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=16
M6 (txp dlp net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=16
MC1 (net5 vcas net1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1 m=32
MC2 (net0 vcas net4 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1 m=96
MC3 (net2 vcas net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1 m=32
MT1 (net1 vpre VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=2 nf=1 m=32
MT2 (net4 vmain VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=2 nf=1 m=96
MT3 (net3 vpost VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=2 nf=1 m=32
RL1 (VDD txn) resistor r=50
RL2 (VDD txp) resistor r=50
