simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
//   @USE-PACKAGE(name="rnl-std-functional", version="0.4")
// }

subckt ideal_chopper (INP INN OUTP OUTN CK)
parameters ron=1 roff=1e12 vt=0.5
s1 (INP OUTP) bsource i=v(INP,OUTP)/(v(CK)>vt ? ron : roff)
s2 (INN OUTN) bsource i=v(INN,OUTN)/(v(CK)>vt ? ron : roff)
s3 (INP OUTN) bsource i=v(INP,OUTN)/(v(CK)>vt ? roff : ron)
s4 (INN OUTP) bsource i=v(INN,OUTP)/(v(CK)>vt ? roff : ron)
ends ideal_chopper

subckt dut (VDD VSS Vin\+ Vin\- Vbn PHIch)
C1 (Vo net10) capacitor c=1p
CH1 (Vin\+ Vin\- net7 net11 PHIch) ideal_chopper
CH2 (net0 net13 net2 net1 PHIch) ideal_chopper
CH3 (net6 net5 net9 net8 PHIch) ideal_chopper
M1 (net4 Vbp VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M10 (net8 V1 net10 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M11 (net9 V1 net10 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M12 (net3 net3 net12 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M13 (net3 Vbn net10 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (net12 Vbp VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net4 net4 net10 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (net13 net7 net12 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (net0 net11 net12 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (V1 net3 net1 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M7 (Vo net3 net2 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M8 (V1 net4 net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M9 (Vo net4 net6 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
