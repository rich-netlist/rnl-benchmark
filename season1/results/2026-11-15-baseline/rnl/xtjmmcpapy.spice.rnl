XM15 net7 ENc2 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM16 VSC phi2 VOUT VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM17 VSC phi1n VOUT VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
