simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
//   @USE-PACKAGE(name="rnl-std-logic", version="0.4")
// }

// Ideal inverter: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
subckt inverter (A Y VDD VSS)
parameters vt=10m td=10p
BhA (hA 0) bsource v=0.5*(1+tanh((v(A,VSS)-0.5*v(VDD,VSS))/vt))
Bf (nfn VSS) bsource v=v(VDD,VSS)*(1-v(hA))
Rd (nfn ndl) resistor r=1k
Cd (ndl VSS) capacitor c=td/1000
BY (Y VSS) bsource v=v(ndl,VSS)
ends inverter

// Ideal nand-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
subckt nand_gate (A B Y VDD VSS)
parameters vt=10m td=10p
BhA (hA 0) bsource v=0.5*(1+tanh((v(A,VSS)-0.5*v(VDD,VSS))/vt))
BhB (hB 0) bsource v=0.5*(1+tanh((v(B,VSS)-0.5*v(VDD,VSS))/vt))
Bf (nfn VSS) bsource v=v(VDD,VSS)*(1-v(hA)*v(hB))
Rd (nfn ndl) resistor r=1k
Cd (ndl VSS) capacitor c=td/1000
BY (Y VSS) bsource v=v(ndl,VSS)
ends nand_gate

subckt dut (VDD VSS ENsc ENscn ENc1 ENc2 VOUT ENpos CLK_IN)
C1 (VSC net8) capacitor c=1p
C2 (VSC net7) capacitor c=1p
C3 (VSC VSS) capacitor c=1p
M1 (net4 ENsc VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M10 (V1 net5 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M11 (VSS VOUT V1 V1) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M12 (V1 phi1 VSC VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M13 (V1 phi1n VSC VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M14 (net8 ENc1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M15 (net7 ENc2 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M16 (VSC phi2 VOUT VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M17 (VSC phi1n VOUT VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (net4 ENpos VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net5 ENscn VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (net5 ENpos VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (net6 ENsc net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (net4 net4 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M7 (V1 net4 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M8 (VDD VOUT V1 V1) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M9 (net5 net5 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (net4 net6) resistor r=1k
X1 (CLK_IN ENsc net9 VDD VSS) nand_gate td=10p vt=10m
X10 (phi1 phi1n VDD VSS) inverter td=10p vt=10m
X11 (phi1n net0 VDD VSS) inverter td=10p vt=10m
X12 (net0 net11 VDD VSS) inverter td=10p vt=10m
X2 (net9 net11 net2 VDD VSS) nand_gate td=10p vt=10m
X3 (net2 phi2 VDD VSS) inverter td=10p vt=10m
X4 (phi2 phi1n VDD VSS) inverter td=10p vt=10m
X5 (phi1n net3 VDD VSS) inverter td=10p vt=10m
X6 (net3 net12 VDD VSS) inverter td=10p vt=10m
X7 (net9 net10 VDD VSS) inverter td=10p vt=10m
X8 (net12 net10 net1 VDD VSS) nand_gate td=10p vt=10m
X9 (net1 phi1 VDD VSS) inverter td=10p vt=10m
