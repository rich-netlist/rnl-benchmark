simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt bootstrap_gate_driver (VDD VIN VSS hinb hin sw linb)
Cbs (bst sw) capacitor c=1n
MB (bst VDD VDD VSS) sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=20 nf=1 m=1
MC1 (sw sw net0 sw) sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=1 nf=1 m=1
MC2 (sw sw b sw) sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=1 nf=1 m=1
MH (VIN net2 sw sw) sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=20 nf=1 m=10
ML (sw net1 VSS VSS) sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=20 nf=1 m=10
MN1 (net0 hinb VSS VSS) sky130_fd_pr__nfet_g5v0d10v5 l=10 w=1 nf=1 m=1
MN2 (b hin VSS VSS) sky130_fd_pr__nfet_g5v0d10v5 l=10 w=1 nf=1 m=1
MNH (net2 b sw sw) sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=4 nf=1 m=1
MNL (net1 linb VSS VSS) sky130_fd_pr__nfet_g5v0d10v5 l=0.5 w=4 nf=1 m=1
MP1 (net0 b bst bst) sky130_fd_pr__pfet_g5v0d10v5 l=10 w=1 nf=1 m=1
MP2 (b net0 bst bst) sky130_fd_pr__pfet_g5v0d10v5 l=10 w=1 nf=1 m=1
MPH (net2 b bst bst) sky130_fd_pr__pfet_g5v0d10v5 l=0.5 w=8 nf=1 m=1
MPL (net1 linb VDD VDD) sky130_fd_pr__pfet_g5v0d10v5 l=0.5 w=8 nf=1 m=1
