*     (-6, 2) @PIN(terminal="lop", label="\textbf{\textit{lop}}", direction="left");
*     (-6, -2) @PIN(terminal="lon", label="\textbf{\textit{lon}}", direction="left");
*     (0, 0) @RECTANGLE(width=10, height=12);
*     @LINE {(-6, 4) (-5, 4)};
*     @LINE {(-6, 0) (-5, 0)};
*     @LINE {(6, 1) (5, 1)};
*     @LINE {(-6, -4) (-5, -4)};
*     @LINE {(6, -1) (5, -1)};
*     @LINE {(-6, 2) (-5, 2)};
*     @LINE {(-6, -2) (-5, -2)}
