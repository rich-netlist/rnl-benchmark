* @RNL(author="analog-canvas") {
*   %passive_mixer_tia_SYMBOL = @DEFINE-SYMBOL(box=[-6, -7, 6, 7]) {
*     (-6, 4) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="left");
*     (-6, 0) @PIN(terminal="rfp", label="\textbf{\textit{rfp}}", direction="left");
*     (6, 1) @PIN(terminal="voutp", label="\textbf{\textit{v}}_{\textbf{outp}}", direction="right");
*     (-6, -4) @PIN(terminal="rfn", label="\textbf{\textit{rfn}}", direction="left");
