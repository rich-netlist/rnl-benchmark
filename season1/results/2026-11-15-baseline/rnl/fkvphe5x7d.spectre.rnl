simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt vector_modulator (VDD VSS vip vin vqn vqp vcip vcin vcqp vcqn vb outp outn)
M1 (outp vcip net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
M10 (outp vcqn net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
M11 (outn vcqp net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
M12 (net4 vqp net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=1 m=1
M13 (net5 vqn net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=1 m=1
M14 (net0 vb VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=8 nf=1 m=1
M2 (outn vcin net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
M3 (outp vcin net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
M4 (outn vcip net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
M5 (net2 vip net1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=1 m=1
M6 (net3 vin net1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=1 m=1
M7 (net1 vb VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=8 nf=1 m=1
M8 (outp vcqp net4 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
M9 (outn vcqn net4 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
RL1 (VDD outp) resistor r=1k
RL2 (VDD outn) resistor r=1k
