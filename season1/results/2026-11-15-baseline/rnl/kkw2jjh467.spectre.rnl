I1 (net4 VSS) isource dc=1m
I2 (net5 VSS) isource dc=1m
M1 (net3 Vinp net6 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M10 (Dout Vinn net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
