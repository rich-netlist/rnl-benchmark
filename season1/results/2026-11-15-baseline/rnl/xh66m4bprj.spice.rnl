*     (0, 0) @RECTANGLE(width=16, height=16);
*     @LINE {(-9, 2) (-8, 2)};
*     @LINE {(-9, 0) (-8, 0)};
*     @LINE {(-9, -4) (-8, -4)};
*     @LINE {(0, 9) (0, 8)};
