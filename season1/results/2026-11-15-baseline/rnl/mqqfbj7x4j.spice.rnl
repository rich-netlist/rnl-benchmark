
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @USE-PACKAGE(name="rnl-std-logic", version="0.4")
* }
* Ideal inverter: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt inverter A Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(1-V(hA))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends inverter

.subckt dut VDD VSS EN EN_bar VIN VBH VBL VCM VOUT
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
XM1 VOUTPS1 VIN VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM10 VOUT VCTRLp VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM11 VCTRLp net4 VCM VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM12 VCM net2 VCTRLm VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM13 net4 EN_bar VOUT VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM14 VOUTPS1 net6 VOUTmS1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM15 VOUTmS1 net1 VOUTPS1 VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM16 net4 EN_bar VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM17 net2 EN VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM18 net2 EN VOUT VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM19 VOUT VCTRLm VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 VOUTmS1 VIN VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM20 VCTRLm net3 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 VCTRLp net5 VCTRLm VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 VCTRLm net0 VCTRLp VBH sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 VCTRLp VOUTmS1 VDD VBH sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 VCTRLm VOUTPS1 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM7 VOUTmS1 EN VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM8 VOUTPS1 net3 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM9 VCTRLp EN VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
S1 VBH net5 EN VSS ideal_switch
S2 VSS net5 EN_bar VSS ideal_switch
S3 net0 VDD EN_bar VSS ideal_switch
S4 net0 VBL EN VSS ideal_switch
S5 VDD net6 EN VSS ideal_switch
S6 VSS net6 EN_bar VSS ideal_switch
S7 net1 VDD EN_bar VSS ideal_switch
S8 net1 VSS EN VSS ideal_switch
X1 EN net3 VDD VSS inverter td=10p vt=10m
