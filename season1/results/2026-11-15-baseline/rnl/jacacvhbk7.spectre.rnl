subckt dut (VDD VSS Vref VB Vinp Vinn)
C1 (Vop Voc) capacitor c=1p
C2 (Voc Von) capacitor c=1p
I2 (VDD net1) isource dc=1u
ITAIL (VDD net0) isource dc=80u
M1 (Von VB VDD VDD) sky130_fd_pr__pfet_01v8 l=0.5 w=20 nf=1 m=1
M10 (net2 net2 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=1 nf=1 m=1
M11 (net4 net4 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=1 nf=1 m=1
M2 (Vop VB VDD VDD) sky130_fd_pr__pfet_01v8 l=0.5 w=20 nf=1 m=1
M3 (Von Vinp net3 VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=10 nf=1 m=1
M4 (Vop Vinn net3 VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=10 nf=1 m=1
M5 (net3 net0 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=4 nf=1 m=4
M6 (net3 net4 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=15 nf=1 m=1
M7 (net0 net0 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.5 w=4 nf=1 m=5
M8 (net2 Voc net1 VDD) sky130_fd_pr__pfet_01v8 l=0.5 w=80 nf=1 m=1
M9 (net4 Vref net1 VDD) sky130_fd_pr__pfet_01v8 l=0.5 w=80 nf=1 m=1
R1 (Vop Voc) resistor r=200k
R2 (Voc Von) resistor r=200k
