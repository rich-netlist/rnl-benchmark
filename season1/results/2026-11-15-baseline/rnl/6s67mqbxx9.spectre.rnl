M1 (Vout1 VLO VRF\+ VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (Vout2 VLOB VRF\+ VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (Vout1 VLOB VRF\- VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (Vout2 VLO VRF\- VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
RL1 (VSS Vout1) resistor r=1k
RL2 (Vout2 VSS) resistor r=1k
