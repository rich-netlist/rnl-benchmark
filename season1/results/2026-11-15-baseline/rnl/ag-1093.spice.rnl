
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt dut Vdd VSS Vrf Vrf_bar Vrfdcn Vrfdcp Vlo Vlodc Vlo_bar Vout Vout_bar
Cd1 net1 Vrf 1p
Cd2 net0 Vrf_bar 1p
Cf Vout Vout_bar 1p
XM1 V1 Vrf VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 V1p Vrf_bar VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 V1 net1 Vdd Vdd sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 V1p net0 Vdd Vdd sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 Vout Vlo_bar V1p VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 Vout Vlo V1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM7 Vout_bar Vlo_bar V1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM8 Vout_bar Vlo V1p VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 Vdd Vout 1k
R2 Vout_bar Vdd 1k
R3 net1 Vrfdcp 1MegΩ
R4 Vrfdcp net0 1MegΩ
R5 Vrf Vrfdcn 1MegΩ
R6 Vrfdcn Vrf_bar 1MegΩ
R7 Vlo Vlodc 1MegΩ
R8 Vlodc Vlo_bar 1MegΩ
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-10, -8, 10, 8]) {
*     (0, 8) @PIN(terminal="Vdd", label="\textbf{\textit{V}}_{\textbf{dd}}", direction="up");
*     (-10, 1) @PIN(terminal="Vrf", label="\textbf{\textit{V}}_{\textbf{rf}}", direction="left");
*     (-10, -3) @PIN(terminal="Vrf_bar", label="\overline{\textbf{\textit{V}}}_{\overline{\textbf{rf}}}", direction="left");
*     (-10, -1) @PIN(terminal="Vrfdcn", label="\textbf{\textit{V}}_{\textbf{rfdcn}}", direction="left");
*     (-10, 3) @PIN(terminal="Vrfdcp", label="\textbf{\textit{V}}_{\textbf{rfdcp}}", direction="left");
*     (-10, -5) @PIN(terminal="Vlo", label="\textbf{\textit{V}}_{\textbf{lo}}", direction="left");
*     (10, -2) @PIN(terminal="Vlodc", label="\textbf{\textit{V}}_{\textbf{lodc}}", direction="right");
*     (10, -4) @PIN(terminal="Vlo_bar", label="\overline{\textbf{\textit{V}}}_{\overline{\textbf{lo}}}", direction="right");
*     (10, 2) @PIN(terminal="Vout", label="\textbf{\textit{V}}_{\textbf{out}}", direction="right");
*     (10, 0) @PIN(terminal="Vout_bar", label="\overline{\textbf{\textit{V}}}_{\overline{\textbf{out}}}", direction="right");
*     (0, 0) @RECTANGLE(width=18, height=14);
*     @LINE {(0, 8) (0, 7)};
*     @LINE {(-10, 1) (-9, 1)};
*     @LINE {(-10, -3) (-9, -3)};
*     @LINE {(-10, -1) (-9, -1)};
*     @LINE {(-10, 3) (-9, 3)};
*     @LINE {(-10, -5) (-9, -5)};
*     @LINE {(10, -2) (9, -2)};
*     @LINE {(10, -4) (9, -4)};
*     @LINE {(10, 2) (9, 2)};
*     @LINE {(10, 0) (9, 0)}
