
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt GCPW A B
* @RNL(author="analog-canvas") {
*   %GCPW_SYMBOL = @DEFINE-SYMBOL(box=[-5, -3, 5, 3]) {
*     (-5, 0) @PIN(terminal="A", label="\textbf{\textit{A}}", direction="left");
*     (5, 0) @PIN(terminal="B", label="\textbf{\textit{B}}", direction="right");
*     (0, 0) @RECTANGLE(width=8, height=4);
*     @LINE {(-5, 0) (-4, 0)};
*     @LINE {(5, 0) (4, 0)}
*   };
*   # @SET-SYMBOL %GCPW_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   $IO_PORT @ATTACH &A(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(0, 0) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &B(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(10, 0) => @ORIENT("MY") => %port2;
*   %port1
*       @TEXT("\textbf{\textit{A}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{B}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label)
* }
.ends GCPW

.subckt dut VDD VSS Vt1 VO2 VO1 SW1
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
CDC1 net0 net4 1p
CDC2 net1 net8 1p
CPAD1 net6 VSS 1p
CPAD2 net7 VSS 1p
CV1A net5 Vt1 1p
CV1B net2 Vt1 1p
Ib1 VDD net9 DC 1m
Ib2 VDD VT DC 1m
L1 net9 net5 1n
L2 net9 net2 1n
L3 VT VO1 1n
L4 VT VO2 1n
L5 VDD net4 1n
L6 VDD net8 1n
XM1 net5 net2 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 net2 net5 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 VO1 net5 net3 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 VO2 net2 net3 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM7 net4 VO1 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM8 net8 VO2 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 net6 VSS 50Ω
R2 net7 VSS 50Ω
SW1 net3 VSS SW1 VSS ideal_switch
X1 net6 net0 GCPW
X2 net7 net1 GCPW
