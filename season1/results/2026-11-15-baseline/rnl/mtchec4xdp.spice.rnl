.subckt dut PVDD VDD VSS
I1 PVDD net1 DC 6.1u
I2 VDD net1 DC 10u
I3 net0 VSS DC 10u
IB1 VDD VB2 DC 10u
IB2 VB1 VSS DC 10u
XM1 VO net1 VDD PVDD sky130_fd_pr__pfet_01v8 l=0.15 w=120 nf=1 m=1
XM2 VO net0 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=40 nf=1 m=1
XM3 net1 VB2 net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=1
XM4 net0 VB1 net1 PVDD sky130_fd_pr__pfet_01v8 l=0.15 w=30 nf=1 m=1
XM5 net2 net2 VDD PVDD sky130_fd_pr__pfet_01v8 l=0.15 w=30 nf=1 m=1
XM6 VB1 VB1 net2 PVDD sky130_fd_pr__pfet_01v8 l=0.15 w=30 nf=1 m=1
XM7 VB2 VB2 net3 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=1
XM8 net3 net3 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=1
Ro net0 VSS 100k
* @RNL(author="analog-canvas") {
