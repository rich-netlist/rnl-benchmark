subckt Main (VDD VSS Vin Vo_meas Vctrl Vbp Vbn)
C1 (net1 net0) capacitor c=1p
C2 (net3 VSS) capacitor c=1p
C3 (VSS VSS) capacitor c=1p
C4 (Vo_meas VSS) capacitor c=1p
L1 (VSS net1) inductor l=1n
M1 (VSS Vctrl net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M10 (VSS VSS VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M12 (VDD Vbp VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (net4 Vin net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (VSS net3 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (VSS Vbp VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (net4 net4 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (Vo_meas Vo_meas net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M7 (Vo_meas net4 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M9 (net2 Vbn VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (net0 net3) resistor r=1k
