.global VDD

.subckt Oguey_All_MOS_Current_Reference VSS
CSTART VDD SU 10p
XMN1 B B VSS VSS sky130_fd_pr__nfet_01v8 l=6 w=60 nf=1 m=1 ad=18 as=18 pd=120.6 ps=120.6
XMN2 A B S VSS sky130_fd_pr__nfet_01v8 l=6 w=720 nf=1 m=1 ad=216 as=216 pd=1440.6 ps=1440.6
XMN3 X X VSS VSS sky130_fd_pr__nfet_01v8 l=8 w=0.42 nf=1 m=1 ad=0.126 as=0.126 pd=1.44 ps=1.44
XMN4 S X VSS VSS sky130_fd_pr__nfet_01v8 l=8 w=0.42 nf=1 m=1 ad=0.126 as=0.126 pd=1.44 ps=1.44
XMN5 A SU VSS VSS sky130_fd_pr__nfet_01v8 l=8 w=0.42 nf=1 m=1 ad=0.126 as=0.126 pd=1.44 ps=1.44
XMP1 B A VDD VDD sky130_fd_pr__pfet_01v8 l=4 w=224 nf=1 m=1 ad=67.2 as=67.2 pd=448.6 ps=448.6
XMP2 A A VDD VDD sky130_fd_pr__pfet_01v8 l=4 w=224 nf=1 m=1 ad=67.2 as=67.2 pd=448.6 ps=448.6
XMP3 X A VDD VDD sky130_fd_pr__pfet_01v8 l=4 w=672 nf=1 m=1 ad=201.6 as=201.6 pd=1344.6 ps=1344.6
RSTART SU VSS 50meg
* @RNL(author="analog-canvas") {
*   $CANVAS_TYPESETTING @ATTACH #(level);
*   #XMP3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(6, 0) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MP3") #XMP3(part);
*   #XMP2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(16, 0) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MP2") #XMP2(part);
*   #XMP1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(26, 0) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP1") #XMP1(part);
*   #XMN2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(16, -6.4) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MN2") #XMN2(part);
*   #XMN1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(26, -6.4) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MN1") #XMN1(part);
*   #XMN3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(6, -12.8) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MN3") #XMN3(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="w", text="0.42u") #XMN3(part);
*   #XMN4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(16, -12.8) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MN4") #XMN4(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="w", text="0.42u") #XMN4(part);
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(16, 4.5) => @ORIENT("R0") => %vdd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(26, -9.7) => @ORIENT("R0") => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(6, -16.1) => @ORIENT("R0") => %gnd2;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(16, -16.1) => @ORIENT("R0") => %gnd3;
*   #CSTART @SET-SYMBOL $CAPACITOR => @PLACE(0.8, 0) => @ORIENT("R0");
*   #RSTART @SET-SYMBOL $RESISTOR => @PLACE(0.8, -6.4) => @ORIENT("R0");
*   #XMN5 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(-6.2, -2.8) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MN5") #XMN5(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="w", text="0.42u") #XMN5(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(-6.2, -6.1) => @ORIENT("R0") => %gnd4;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(0.8, -9.7) => @ORIENT("R0") => %gnd5;
*   %j1 = (6, 4);
*   %j2 = (16, 4);
*   %j3 = (26, 4);
*   %j4 = (16, -2.8);
*   %j5 = (21, 0);
*   %j6 = (26, -3.6);
*   %j7 = (21, -6.4);
*   %j8 = (6, -10);
*   %j9 = (11, -12.8);
*   %j10 = (16, -9.6);
*   %j11 = (0.8, -2.8);
*   &VDD @WIRE(mode="straight") {%vdd1::pin %j2};
*   &VDD @WIRE(mode="straight") {%j1 %j2};
*   &VDD @WIRE(mode="straight") {%j2 %j3} => %wire1;
*   &VDD @WIRE(mode="straight") {%j1 #XMP3:3};
*   &VDD @WIRE(mode="straight") {%j2 #XMP2:3};
*   &VDD @WIRE(mode="straight") {%j3 #XMP1:3};
*   &A @WIRE(mode="straight") {#XMP2:1 %j4} => %wire2;
*   &A @WIRE(mode="straight") {%j4 #XMN2:1};
*   &A @WIRE(mode="straight") {%j4 (21, -2.8) %j5};
*   &A @WIRE(mode="straight") {#XMP3:2 #XMP2:2};
*   &A @WIRE(mode="straight") {#XMP2:2 %j5};
*   &A @WIRE(mode="straight") {%j5 #XMP1:2};
*   &B @WIRE(mode="straight") {#XMP1:1 %j6} => %wire3;
*   &B @WIRE(mode="straight") {%j6 #XMN1:1};
*   &B @WIRE(mode="straight") {%j6 (21, -3.6) %j7};
*   &B @WIRE(mode="straight") {#XMN2:2 %j7};
*   &B @WIRE(mode="straight") {%j7 #XMN1:2};
*   &X @WIRE(mode="straight") {#XMP3:1 %j8} => %wire4;
*   &X @WIRE(mode="straight") {%j8 #XMN3:1};
*   &X @WIRE(mode="straight") {%j8 (11, -10) %j9};
*   &X @WIRE(mode="straight") {#XMN3:2 %j9};
*   &X @WIRE(mode="straight") {%j9 #XMN4:2};
*   &S @WIRE(mode="straight") {#XMN2:3 %j10} => %wire5;
*   &S @WIRE(mode="straight") {%j10 #XMN4:1};
*   &VSS @WIRE(mode="straight") {#XMN1:3 %gnd1::pin};
*   &VSS @WIRE(mode="straight") {#XMN3:3 %gnd2::pin};
*   &VSS @WIRE(mode="straight") {#XMN4:3 %gnd3::pin};
*   &VDD @WIRE(mode="straight") {%j1 (0.8, 4) #CSTART:1};
*   &SU @WIRE(mode="straight") {#CSTART:2 %j11};
*   &SU @WIRE(mode="straight") {%j11 #RSTART:1};
*   &SU @WIRE(mode="straight") {%j11 #XMN5:2};
*   &VSS @WIRE(mode="straight") {#RSTART:2 %gnd5::pin};
*   &VSS @WIRE(mode="straight") {#XMN5:3 %gnd4::pin};
*   $JUNCTION @ATTACH %j4(p) => @PLACE(16, -2.8) => %dot1;
*   $JUNCTION @ATTACH %j5(p) => @PLACE(21, 0) => %dot2;
*   $JUNCTION @ATTACH %j7(p) => @PLACE(21, -6.4) => %dot3;
*   $JUNCTION @ATTACH %j6(p) => @PLACE(26, -3.6) => %dot4;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(6, 4) => %dot5;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(16, 4) => %dot6;
*   $JUNCTION @ATTACH %j11(p) => @PLACE(0.8, -2.8) => %dot7;
*   $JUNCTION @ATTACH %j8(p) => @PLACE(6, -10) => %dot8;
*   $JUNCTION @ATTACH %j9(p) => @PLACE(11, -12.8) => %dot9;
*   #XMP3
*       @TEXT("\textbf{\textit{M}}_{\textbf{P3}}", key="name", dx=-0.7, dy=0, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMP3::name(label);
*   #XMP2
*       @TEXT("\textbf{\textit{M}}_{\textbf{P2}}", key="name", dx=-0.7, dy=2, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMP2::name(label);
*   #XMP1
*       @TEXT("\textbf{\textit{M}}_{\textbf{P1}}", key="name", dx=0.7, dy=2, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMP1::name(label);
*   #XMN2
*       @TEXT("\textbf{\textit{M}}_{\textbf{N2}}", key="name", dx=-0.8, dy=-2, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN2::name(label);
*   #XMN1
*       @TEXT("\textbf{\textit{M}}_{\textbf{N1}}", key="name", dx=0.8, dy=0, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN1::name(label);
*   #XMN3
*       @TEXT("\textbf{\textit{M}}_{\textbf{N3}}", key="name", dx=-0.8, dy=0, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN3::name(label);
*   #XMN4
*       @TEXT("\textbf{\textit{M}}_{\textbf{N4}}", key="name", dx=0.8, dy=0, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN4::name(label);
*   #CSTART
*       @TEXT("\textbf{\textit{C}}_{\textbf{START}}", key="name", dx=-1.4, dy=2, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #CSTART::name(label);
*   #RSTART
*       @TEXT("\textbf{\textit{R}}_{\textbf{START}}", key="name", dx=-1.4, dy=0.3, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #RSTART::name(label);
*   #XMN5
*       @TEXT("\textbf{\textit{M}}_{\textbf{N5}}", key="name", dx=-0.8, dy=0, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XMN5::name(label);
*   #XMN5 @TEXT("\textbf{\textit{A}}", dx=0, dy=2.9, halign="middle", size=1.5116, bold=false) => %label1;
*   $CANVAS_LABEL @ATTACH(bind="net") %label1(label);
*   &SU @TEXT("\textbf{SU}", halign="end", size=1.5116, bold=false) => @PLACE(0, -2) => %label2;
*   $CANVAS_LABEL @ATTACH(bind="net") %label2(label);
*   %wire2 @TEXT("\textbf{\textit{A}}", halign="end", size=1.5116, bold=false) => @PLACE(14.8, -2.3) => %label3;
*   $CANVAS_LABEL @ATTACH(bind="net") %label3(label);
*   %wire3 @TEXT("\textbf{\textit{B}}", size=1.5116, bold=false) => @PLACE(27.4, -3.6) => %label4;
*   $CANVAS_LABEL @ATTACH(bind="net") %label4(label);
*   %wire5 @TEXT("\textbf{\textit{S}}", size=1.5116, bold=false) => @PLACE(17.4, -9.6) => %label5;
*   $CANVAS_LABEL @ATTACH(bind="net") %label5(label);
*   %wire1 @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", size=1.5116, bold=false) => @PLACE(21.9, 5) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="net") %power1(label);
*   %wire4 @TEXT("\textbf{\textit{X}}", halign="end", size=1.5116, bold=false) => @PLACE(4.8, -10) => %label6;
*   $CANVAS_LABEL @ATTACH(bind="net") %label6(label);
*   %vdd1 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends Oguey_All_MOS_Current_Reference
