simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt opamp_differential (VIP VIN VOP VON VDD VSS)
parameters gain=1e6 vocm=0
VCM (ncm 0) vsource dc=vocm
EPLUS (VOP ncm VIP VIN) vcvs gain=gain/2
EMINUS (VON ncm VIN VIP) vcvs gain=gain/2
ends opamp_differential

subckt dut (VDD VSS Vout Vinn)
M1 (net13 net4 net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M10 (net9 net6 net15 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M11 (net11 net7 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M12 (net16 net7 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M13 (net12 net6 net11 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M14 (net17 net6 net16 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M15 (net12 net12 net14 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M16 (net0 net12 net1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (net6 net3 net13 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net18 net4 net8 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (net4 net3 net18 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (net7 net6 net19 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (net19 net7 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M7 (net3 net6 net20 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M8 (net20 net7 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M9 (net15 net7 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
Q1 (VSS net10 net5) sky130_fd_pr__pnp_05v5_W0p68L0p68 m=1
Q2 (VSS net14 net8) sky130_fd_pr__pnp_05v5_W0p68L0p68 m=1
Q3 (VSS VSS net10) sky130_fd_pr__pnp_05v5_W0p68L0p68 m=1
Q4 (VSS VSS net14) sky130_fd_pr__pnp_05v5_W0p68L0p68 m=1
R1 (net7 net6) resistor r=1k
R2 (net3 net4) resistor r=1k
R3 (net2 net5) resistor r=1k
R4 (net9 net10) resistor r=1k
R5 (net1 VSS) resistor r=1k
R6 (Vout net17) resistor r=1k
R7 (Vinn net0) resistor r=1k
X1 (net17 net0 Vinn Vout VDD VSS) opamp_differential gain=1e6
