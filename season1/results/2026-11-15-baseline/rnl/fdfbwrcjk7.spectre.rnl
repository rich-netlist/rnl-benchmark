subckt dut (VDD VSS RF\+ RF\-)
C1 (net0 RF\-) capacitor c=1p
C2 (net2 RF\+) capacitor c=1p
C3 (VDD VSS) capacitor c=1p
C4 (net2 RF\+) capacitor c=1p
C5 (net0 RF\-) capacitor c=1p
M1 (VSS net0 net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (VSS net2 net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (VDD net0 net2 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (VDD net2 net0 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (net0 net1 VDD VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (VDD net1 net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M7 (VDD VDD net1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M8 (net1 VDD VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
