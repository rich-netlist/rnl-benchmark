simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt buck_deadtime (VDD VSS pwm vout)
C1 (vout VSS) capacitor c=0.22u
L1 (vout vsw) inductor l=0.47u
MA1 (net4 pwm VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=4 nf=1 m=1
MA2 (net4 net0 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1 m=1
MA3 (net4 pwm net7 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
MA4 (net7 net0 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
MB1 (net6 net4 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=32 nf=8 m=1
MB2 (net6 net4 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=4 m=1
MB3 (gp net6 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=32 nf=8 m=4
MB4 (gp net6 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=32 nf=8 m=4
MC1 (net1 net5 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=16 nf=4 m=1
MC2 (net1 net5 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=32 nf=8 m=1
MC3 (gn net1 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=40 nf=8 m=4
MC4 (gn net1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=40 nf=8 m=16
MD1 (net3 pwm VDD VDD) sky130_fd_pr__pfet_01v8 l=1 w=2 nf=1 m=1
MD2 (net3 pwm VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=1 nf=1 m=1
MD3 (net0 net3 VDD VDD) sky130_fd_pr__pfet_01v8 l=1 w=2 nf=1 m=1
MD4 (net0 net3 VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=1 nf=1 m=1
MN (vsw gn VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=50 nf=8 m=50
MO1 (net2 pwm VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=8 nf=2 m=1
MO2 (net5 net0 net2 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=8 nf=2 m=1
MO3 (net5 pwm VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=2 m=1
MO4 (net5 net0 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MP (vsw gp VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=50 nf=8 m=40
RL (vout VSS) resistor r=10
