simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
//   @USE-PACKAGE(name="rnl-std-functional", version="0.4")
// }

subckt opamp (VIP VIN VDD VSS VOUT)
parameters gain=1e6 vhigh=5 vlow=-5
Blin (nlin 0) bsource v=gain*(v(VIP)-v(VIN))
Bcore (VOUT 0) bsource v=0.5*(vhigh+(0.5*(vlow+v(nlin)+sqrt((v(nlin)-vlow)*(v(nlin)-vlow)+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12)))-sqrt((vhigh-(0.5*(vlow+v(nlin)+sqrt((v(nlin)-vlow)*(v(nlin)-vlow)+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12))))*(vhigh-(0.5*(vlow+v(nlin)+sqrt((v(nlin)-vlow)*(v(nlin)-vlow)+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12))))+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12))
ends opamp

subckt dut (VSS IN0 IN1 IN2 INN U_Fk S1 e o)
subckt ideal_switch (p n cp cn)
parameters ron=1 roff=1e12 vt=0.5
core (p n) bsource i=v(p,n)/(v(cp,cn)>vt ? ron : roff)
ends ideal_switch
C0 (net6 net4) capacitor c=1p
C1 (net2 net4) capacitor c=1p
C2 (net5 net4) capacitor c=1p
CN (net0 net4) capacitor c=1p
Co (net4 net1) capacitor c=1p
Co2 (net7 net3) capacitor c=1p
S1 (net1 VSS S1 VSS) ideal_switch
Se0 (net6 VSS e VSS) ideal_switch
Se1 (net2 VSS e VSS) ideal_switch
Se2 (net5 VSS e VSS) ideal_switch
Se4 (net4 \-Fk e VSS) ideal_switch
Se5 (net7 VSS e VSS) ideal_switch
Se6 (net3 U_Fk e VSS) ideal_switch
SeN (net0 VSS e VSS) ideal_switch
So0 (IN0 net6 o VSS) ideal_switch
So1 (IN1 net2 o VSS) ideal_switch
So2 (IN2 net5 o VSS) ideal_switch
So4 (net1 \-Fk o VSS) ideal_switch
So5 (\-Fk net7 o VSS) ideal_switch
SoN (INN net0 o VSS) ideal_switch
X1 (VSS net4 0 VSS \-Fk) opamp gain=1e6
X2 (VSS net3 0 VSS U_Fk) opamp gain=1e6
