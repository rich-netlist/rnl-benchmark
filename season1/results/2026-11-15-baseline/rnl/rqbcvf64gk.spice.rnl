.subckt dut VDD VSS VB1 Vin Vinn S1 S2 S3 S4 S5
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
C1 net2 net1 1p
C2 net3 net2 1p
IREF VDD net4 DC 1m
XM1 net0 VB1 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 net5 VB1 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 net0 Vin net6 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 net5 Vinn net6 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 net6 net2 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 net4 net4 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
S1 net0 net1 S1 VSS ideal_switch
S2 net3 net5 S2 VSS ideal_switch
S3 net0 net1 S3 VSS ideal_switch
S4 net3 net5 S4 VSS ideal_switch
S5 net2 net4 S5 VSS ideal_switch
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-6, -5, 6, 5]) {
*     (6, -1) @PIN(terminal="VB1", label="\textbf{\textit{V}}_{\textbf{B1}}", direction="right");
*     (-6, 0) @PIN(terminal="Vin", label="\textbf{\textit{V}}_{\textbf{in}}", direction="left");
*     (-6, -2) @PIN(terminal="Vinn", label="\textbf{\textit{Vinn}}", direction="left");
*     (0, 5) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (0, 0) @RECTANGLE(width=10, height=8);
*     @LINE {(6, -1) (5, -1)};
*     @LINE {(-6, 0) (-5, 0)};
*     @LINE {(-6, -2) (-5, -2)};
*     @LINE {(0, 5) (0, 4)}
*   };
*   # @SET-SYMBOL %dut_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XM1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(33, -11) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M1") #XM1(part);
*   #XM2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(59, -11) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M2") #XM2(part);
*   #XM3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(33, -27) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M3") #XM3(part);
*   #XM4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(59, -27) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M4") #XM4(part);
*   #S1 @SET-SYMBOL $CLOSED_SWITCH => @PLACE(36, -17) => @ORIENT("R0");
*   #S2 @SET-SYMBOL $CLOSED_SWITCH => @PLACE(56, -17) => @ORIENT("R0");
*   #S3 @SET-SYMBOL $SWITCH => @PLACE(36, -20) => @ORIENT("R0");
*   #S4 @SET-SYMBOL $SWITCH => @PLACE(56, -20) => @ORIENT("R0");
