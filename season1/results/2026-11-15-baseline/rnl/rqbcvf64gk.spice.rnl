*   &net1 @WIRE(mode="straight") {#S3:2 (39, -20) %j8};
*   &net1 @WIRE(mode="straight") {%j8 #C1:2};
*   &net1 @WIRE(mode="straight") {#S1:2 %j8};
*   &net0 @WIRE(mode="straight") {#XM1:1 %j7};
*   &net0 @WIRE(mode="straight") {%j7 %j9};
*   &net0 @WIRE(mode="straight") {%j7 #S1:1};
*   &net0 @WIRE(mode="straight") {%j9 #XM3:1};
*   &net0 @WIRE(mode="straight") {%j9 #S3:1};
*   &VDD @WIRE(mode="straight") {#IREF:1 %vdd1::pin};
*   &net4 @WIRE(mode="straight") {#S5:2 %j10};
*   &net4 @WIRE(mode="straight") {%j10 #XM6:2};
*   &net4 @WIRE(mode="straight") {%j10 (70, -30) %j11};
*   &net4 @WIRE(mode="straight") {#IREF:2 %j11};
*   &net4 @WIRE(mode="straight") {%j11 #XM6:1};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j12 %j14};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j14 %j15};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j15 %j13};
*   &VDD @WIRE(mode="straight") {#XM1:3 %j14};
*   &VDD @WIRE(mode="straight") {#XM2:3 %j15};
*   &VSS @WIRE(mode="straight") {%gnd1::pin #XM5:3};
*   &VSS @WIRE(mode="straight") {%gnd2::pin #XM6:3};
*   &Vin @WIRE(mode="straight") {#XM3:2 %port2::pin};
*   $JUNCTION @ATTACH %j14(p) => @PLACE(33, -8) => %dot1;
*   $JUNCTION @ATTACH %j15(p) => @PLACE(59, -8) => %dot2;
*   $JUNCTION @ATTACH %j7(p) => @PLACE(33, -17) => %dot3;
