*   $CANVAS_LABEL @ATTACH(bind="name") #XMREF::name(label);
*   #RDEG
*       @TEXT("\textbf{\textit{R}}_{\textbf{DEG}}", key="name", dx=0, dy=-2, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #RDEG::name(label);
*   #RDEG
*       @TEXT("\textbf{650Ω}", key="value", dx=0, dy=-4, halign="middle", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="value") #RDEG::value(label);
*   #RLP
*       @TEXT("\textbf{\textit{R}}_{\textbf{LP}}", key="name", dx=0.9, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #RLP::name(label);
