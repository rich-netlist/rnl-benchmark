
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @USE-PACKAGE(name="rnl-std-logic", version="0.4")
* }
* Ideal inverter: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt inverter A Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(1-V(hA))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends inverter

.subckt dut VDD VSS VINB VINA VOUTA
C1 VSS VX 1p
CX VSS VX 1p
I1 net2 VSS DC 1m
I2 net3 VSS DC 1m
XM1 VX VINA net4 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 VX VINA net5 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 net0 VINB VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 net4 net6 net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 VX VINA net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 VX VINA VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM7 net5 net7 net3 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM8 net1 VINB VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM9 VX VINA net1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMRA VX VINA VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
X1 VINB net6 VDD VSS inverter td=10p vt=10m
X2 VX VOUTA VDD VSS inverter td=10p vt=10m
X3 VINB net7 VDD VSS inverter td=10p vt=10m
X4 VX VOUTA VDD VSS inverter td=10p vt=10m
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-5, -6, 5, 6]) {
*     (-5, -3) @PIN(terminal="VINB", label="\textbf{\textit{V}}_{\textbf{\textit{INB}}}", direction="left");
*     (-5, -1) @PIN(terminal="VINA", label="\textbf{\textit{V}}_{\textbf{\textit{INA}}}", direction="left");
*     (0, 6) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (-5, 1) @PIN(terminal="VOUTA", label="\textbf{\textit{V}}_{\textbf{\textit{OUTA}}}", direction="left");
*     (0, 0) @RECTANGLE(width=8, height=10);
*     @LINE {(-5, -3) (-4, -3)};
*     @LINE {(-5, -1) (-4, -1)};
*     @LINE {(0, 6) (0, 5)};
*     @LINE {(-5, 1) (-4, 1)}
*   };
*   # @SET-SYMBOL %dut_SYMBOL;
