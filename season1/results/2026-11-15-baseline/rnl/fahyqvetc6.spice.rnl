.subckt nmos_pass_ldo VDD VSS vref ibias loop_out pass_gate vout
XCCOMP vout VSS sky130_fd_pr__cap_mim_m3_1 w=4 l=4 mf=30
XMGATECAP VSS loop_out VSS VSS sky130_fd_pr__nfet_01v8 l=10 w=10 nf=1 m=1600
XMPASS VDD pass_gate vout VSS sky130_fd_pr__nfet_01v8_lvt l=0.15 w=10 nf=1 m=400
XAMP VDD VSS ibias vout vref loop_out ldo_error_amplifier
* @RNL(author="analog-canvas") {
*   %nmos_pass_ldo_SYMBOL = @DEFINE-SYMBOL(box=[-11, -6, 11, 6]) {
*     (-11, 1) @PIN(terminal="vref", label="\textbf{\textit{v}}_{\textbf{ref}}", direction="left");
*     (-11, -3) @PIN(terminal="ibias", label="\textbf{\textit{i}}_{\textbf{bias}}", direction="left");
*     (-11, -1) @PIN(terminal="loop_out", label="\textbf{\textit{loop}}_{\textbf{\textit{out}}}", direction="left");
*     (11, 0) @PIN(terminal="pass_gate", label="\textbf{\textit{pass}}_{\textbf{\textit{gate}}}", direction="right");
*     (11, -2) @PIN(terminal="vout", label="\textbf{\textit{v}}_{\textbf{out}}", direction="right");
*     (0, 6) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (0, 0) @RECTANGLE(width=20, height=10);
*     @LINE {(-11, 1) (-10, 1)};
*     @LINE {(-11, -3) (-10, -3)};
*     @LINE {(-11, -1) (-10, -1)};
*     @LINE {(11, 0) (10, 0)};
*     @LINE {(11, -2) (10, -2)};
*     @LINE {(0, 6) (0, 5)}
*   };
*   # @SET-SYMBOL %nmos_pass_ldo_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XAMP @PLACE(0, 0) => @ORIENT("R0");
*   #XMPASS @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(38, 0) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MPASS") #XMPASS(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMPASS(part);
*   #XMGATECAP @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(14, -5) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MGATECAP") #XMGATECAP(part);
*   #XCCOMP @SET-SYMBOL(terminals=[[1, "p"], [2, "n"]]) $CAPACITOR => @PLACE(38, -17) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="CCOMP") #XCCOMP(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(16, -8) => @ORIENT("R0") => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(38, -19) => @ORIENT("R0") => %gnd2;
*   $IO_PORT @ATTACH &vref(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-14, 2) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &ibias(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-14, -2) => @ORIENT("R0") => %port2;
*   $IO_PORT @ATTACH &loop_out(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(14, 0) => @ORIENT("MY") => %port3;
*   $IO_PORT @ATTACH &pass_gate(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(35, 0) => @ORIENT("R0") => %port4;
*   $IO_PORT @ATTACH &vout(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(44, -6) => @ORIENT("MY") => %port5;
*   %j1 = (11, 0);
*   %j2 = (16, -7);
*   %j3 = (38, -6);
*   %j4 = (38, -13);
*   %j5 = (0, 10);
*   %j6 = (38, 10);
*   %j7 = (-2, 10);
*   %j8 = (40, 10);
*   &vref @WIRE(mode="straight") {%port1::pin #XAMP:5};
*   &ibias @WIRE(mode="straight") {%port2::pin #XAMP:3};
*   &loop_out @WIRE(mode="straight") {#XAMP:6 %j1};
*   &loop_out @WIRE(mode="straight") {%j1 %port3::pin};
*   &loop_out @WIRE(mode="straight") {%j1 #XMGATECAP:2};
