simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
//   @USE-PACKAGE(name="rnl-std-functional", version="0.4")
// }

subckt opamp (VIP VIN VDD VSS VOUT)
parameters gain=1e6 vhigh=5 vlow=-5
Blin (nlin 0) bsource v=gain*(v(VIP)-v(VIN))
Bcore (VOUT 0) bsource v=0.5*(vhigh+(0.5*(vlow+v(nlin)+sqrt((v(nlin)-vlow)*(v(nlin)-vlow)+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12)))-sqrt((vhigh-(0.5*(vlow+v(nlin)+sqrt((v(nlin)-vlow)*(v(nlin)-vlow)+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12))))*(vhigh-(0.5*(vlow+v(nlin)+sqrt((v(nlin)-vlow)*(v(nlin)-vlow)+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12))))+(1e-4*(vhigh-vlow))*(1e-4*(vhigh-vlow))+1e-12))
ends opamp

subckt dut (VSS)
C1 (net2 VO2) capacitor c=10n
C2 (net5 VO4) capacitor c=10n
C3 (net0 VO6) capacitor c=10n
C4 (net10 VO8) capacitor c=10n
R1 (net9 net1) resistor r=100k
R10 (net5 VO4) resistor r=100k
R11 (VO2 net5) resistor r=100k
R12 (VO8 net5) resistor r=25k
R13 (VO4 net3) resistor r=100k
R14 (net3 VO7) resistor r=100k
R15 (net7 net8) resistor r=100k
R16 (VSS net7) resistor r=100k
R17 (VO8 net7) resistor r=170.7067k
R18 (VO6 net7) resistor r=170.7067k
R19 (net0 VO6) resistor r=100k
R2 (VO2 net9) resistor r=170.7067k
R20 (net8 net0) resistor r=100k
R21 (VO3 net0) resistor r=25k
R22 (net10 VO8) resistor r=100k
R23 (VO6 net10) resistor r=100k
R24 (VO7 net10) resistor r=25k
R3 (VO4 net9) resistor r=170.7067k
R4 (net6 net9) resistor r=100k
R5 (net2 VO2) resistor r=100k
R6 (net1 net2) resistor r=100k
R7 (VO6 net2) resistor r=25k
R8 (VO2 net4) resistor r=100k
R9 (net4 VO3) resistor r=100k
V1 (net6 VSS) vsource type=sine dc=0 ampl=1 freq=1k delay=0 damp=0 sinephase=0
X1 (VSS net9 0 VSS net1) opamp gain=1e6
X2 (VSS net2 0 VSS VO2) opamp gain=1e6
X3 (VSS net4 0 VSS VO3) opamp gain=1e6
X4 (VSS net5 0 VSS VO4) opamp gain=1e6
X5 (VSS net7 0 VSS net8) opamp gain=1e6
X6 (VSS net0 0 VSS VO6) opamp gain=1e6
X7 (VSS net3 0 VSS VO7) opamp gain=1e6
X8 (VSS net10 0 VSS VO8) opamp gain=1e6
