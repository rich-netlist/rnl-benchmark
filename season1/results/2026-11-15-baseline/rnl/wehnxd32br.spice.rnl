*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt buck_deadtime VDD VSS pwm vout
C1 vout VSS 0.22uF
L1 vout vsw 0.47uH
XMA1 net4 pwm VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=4 nf=1 m=1
XMA2 net4 net0 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=2 nf=1 m=1
XMA3 net4 pwm net7 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
XMA4 net7 net0 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=1
XMB1 net6 net4 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=32 nf=8 m=1
XMB2 net6 net4 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=16 nf=4 m=1
XMB3 gp net6 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=32 nf=8 m=4
XMB4 gp net6 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=32 nf=8 m=4
XMC1 net1 net5 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=16 nf=4 m=1
XMC2 net1 net5 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=32 nf=8 m=1
XMC3 gn net1 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=40 nf=8 m=4
XMC4 gn net1 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=40 nf=8 m=16
XMD1 net3 pwm VDD VDD sky130_fd_pr__pfet_01v8 l=1 w=2 nf=1 m=1
XMD2 net3 pwm VSS VSS sky130_fd_pr__nfet_01v8 l=1 w=1 nf=1 m=1
XMD3 net0 net3 VDD VDD sky130_fd_pr__pfet_01v8 l=1 w=2 nf=1 m=1
XMD4 net0 net3 VSS VSS sky130_fd_pr__nfet_01v8 l=1 w=1 nf=1 m=1
XMN vsw gn VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=50 nf=8 m=50
XMO1 net2 pwm VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=8 nf=2 m=1
XMO2 net5 net0 net2 VDD sky130_fd_pr__pfet_01v8 l=0.15 w=8 nf=2 m=1
XMO3 net5 pwm VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=8 nf=2 m=1
XMO4 net5 net0 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMP vsw gp VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=50 nf=8 m=40
RL vout VSS 10Ω
