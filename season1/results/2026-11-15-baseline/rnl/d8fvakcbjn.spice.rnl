
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @USE-PACKAGE(name="rnl-std-logic", version="0.4")
* }
* Ideal inverter: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt inverter A Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(1-V(hA))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends inverter

.subckt dut VDD VSS PHIRST Sp2 Sp1 Sn2 Sn1 TOP TON
C1 VSS net8 1p
C2 net9 VSS 1p
I1 net5 VSS DC 1m
I2 net4 VSS DC 1m
I3 net7 VSS DC 1m
I4 net6 VSS DC 1m
XM1 net8 PHIRST VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM10 net8 Sp1 net4 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 net9 PHIRST VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 net8 Sp2 net5 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 net9 Sn2 net7 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 VDD net0 net5 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 VDD net1 net7 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM7 VDD net2 net4 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM8 VDD net3 net6 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM9 net9 Sn1 net6 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
X1 net8 TOP VDD VSS inverter td=10p vt=10m
X2 net9 TON VDD VSS inverter td=10p vt=10m
X3 Sp2 net0 VDD VSS inverter td=10p vt=10m
X4 Sp1 net2 VDD VSS inverter td=10p vt=10m
X5 Sn2 net1 VDD VSS inverter td=10p vt=10m
X6 Sn1 net3 VDD VSS inverter td=10p vt=10m
