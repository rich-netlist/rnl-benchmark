*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-6, -7, 6, 7]) {
*     (0, 7) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (-6, 0) @PIN(terminal="PHIRST", label="\textbf{\textit{Φ}}_{\textbf{\textit{RST}}}", direction="left");
*     (-6, -2) @PIN(terminal="Sp2", label="\textbf{\textit{S}}_{\textbf{\textit{p2}}}", direction="left");
*     (-6, -4) @PIN(terminal="Sp1", label="\textbf{\textit{S}}_{\textbf{\textit{p1}}}", direction="left");
*     (6, -1) @PIN(terminal="Sn2", label="\textbf{\textit{S}}_{\textbf{\textit{n}}}_{\textbf{\textit{2}}}", direction="right");
*     (6, -3) @PIN(terminal="Sn1", label="\textbf{\textit{S}}_{\textbf{\textit{n1}}}", direction="right");
*     (-6, 2) @PIN(terminal="TOP", label="\textbf{\textit{T}}_{\textbf{\textit{OP}}}", direction="left");
*     (6, 1) @PIN(terminal="TON", label="\textbf{\textit{T}}_{\textbf{\textit{ON}}}", direction="right");
*     (0, 0) @RECTANGLE(width=10, height=12);
*     @LINE {(0, 7) (0, 6)};
*     @LINE {(-6, 0) (-5, 0)};
*     @LINE {(-6, -2) (-5, -2)};
*     @LINE {(-6, -4) (-5, -4)};
*     @LINE {(6, -1) (5, -1)};
*     @LINE {(6, -3) (5, -3)};
*     @LINE {(-6, 2) (-5, 2)};
