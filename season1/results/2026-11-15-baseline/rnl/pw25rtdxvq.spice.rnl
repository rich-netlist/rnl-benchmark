
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @USE-PACKAGE(name="rnl-std-logic", version="0.4")
* }
* Ideal inverter: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt inverter A Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(1-V(hA))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends inverter

.subckt dut VDD VSS EN VIN EN_bar VOUT
.model ideal_switch SW(RON=1 ROFF=1e12 VT=0.5 VH=0)
VB1 VDD VBIASH DC 1
VB2 net1 VSS DC 1
XM1 VIN EN VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM10 VCTRLp EN VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM11 VCTRLm EN_bar VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM12 VOUT VCTRLm VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM13 VOUT VCTRLp VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 VOUTS1 VIN VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 VOUTS1 VIN net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 net0 EN VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 VCTRLp VGn VCTRLm VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 VCTRLm VGp VCTRLp VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM7 VCTRLp VOUTS1 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM8 VCTRLm VOUTS1 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM9 VOUTS1 EN VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
S1 VBIASH VGn EN VSS ideal_switch
S2 VSS VGn EN_bar VSS ideal_switch
S3 VGp VDD EN_bar VSS ideal_switch
S4 VGp net1 EN VSS ideal_switch
X1 EN EN_bar VDD VSS inverter td=10p vt=10m
