simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt gilbert_mixer (VDD VSS lop lon rfp rfn iref ifoutp ifoutn)
CBIAS (iref VSS) capacitor c=1p
COUTN (ifoutn VSS) capacitor c=75f
COUTP (ifoutp VSS) capacitor c=75f
MQ1 (ifoutp lop net3 VSS) sky130_fd_pr__nfet_01v8_lvt l=0.15 w=40 nf=10 m=1
MQ2 (ifoutn lon net3 VSS) sky130_fd_pr__nfet_01v8_lvt l=0.15 w=40 nf=10 m=1
MQ3 (ifoutn lop net1 VSS) sky130_fd_pr__nfet_01v8_lvt l=0.15 w=40 nf=10 m=1
MQ4 (ifoutp lon net1 VSS) sky130_fd_pr__nfet_01v8_lvt l=0.15 w=40 nf=10 m=1
MREF (iref iref VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=20 nf=4 m=1
MRFN (net1 rfn net0 VSS) sky130_fd_pr__nfet_01v8_lvt l=0.3 w=40 nf=8 m=1
MRFP (net3 rfp net2 VSS) sky130_fd_pr__nfet_01v8_lvt l=0.3 w=40 nf=8 m=1
MTAILN (net0 iref VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=130 nf=26 m=1
MTAILP (net2 iref VSS VSS) sky130_fd_pr__nfet_01v8 l=1 w=130 nf=26 m=1
RDEG (net2 net0) resistor r=650
RLN (VDD ifoutn) resistor r=3.3k
RLP (VDD ifoutp) resistor r=3.3k
