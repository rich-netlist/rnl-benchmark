*     (-2, 5) @PIN(terminal="Vb", label="\textbf{\textit{V}}_{\textbf{b}}", direction="up");
*     (0, 0) @RECTANGLE(width=12, height=8);
*     @LINE {(-7, 0) (-6, 0)};
*     @LINE {(7, 0) (6, 0)};
*     @LINE {(-7, -2) (-6, -2)};
*     @LINE {(7, -2) (6, -2)};
*     @LINE {(0, 5) (0, 4)};
*     @LINE {(-2, 5) (-2, 4)}
*   };
