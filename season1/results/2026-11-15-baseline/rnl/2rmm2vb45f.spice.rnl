*   #C4 @SET-SYMBOL $CAPACITOR => @PLACE(91, -13) => @ORIENT("R0");
*   #C5 @SET-SYMBOL $CAPACITOR => @PLACE(105, -13) => @ORIENT("R0");
*   #CDUMMY @SET-SYMBOL $CAPACITOR => @PLACE(121, -13) => @ORIENT("R0");
*   $IO_PORT @ATTACH &vss(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(19, -36) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &reset(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(108, -19) => @ORIENT("R0") => %port2;
*   $IO_PORT @ATTACH &b0(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(28, -22) => @ORIENT("R270") => %port3;
*   $IO_PORT @ATTACH &b1(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(44, -22) => @ORIENT("R270") => %port4;
*   $IO_PORT @ATTACH &b2(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(60, -22) => @ORIENT("R270") => %port5;
*   $IO_PORT @ATTACH &b3(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(75, -22) => @ORIENT("R270") => %port6;
*   $IO_PORT @ATTACH &b4(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(88, -22) => @ORIENT("R270") => %port7;
*   $IO_PORT @ATTACH &b5(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(102, -22) => @ORIENT("R270") => %port8;
*   $IO_PORT @ATTACH &vdd(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(19, -17) => @ORIENT("R0") => %port9;
*   $IO_PORT @ATTACH &vout(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(19, -9) => @ORIENT("R0") => %port10;
*   %j1 = (46, -36);
*   %j2 = (62, -36);
*   %j3 = (77, -36);
*   %j4 = (90, -36);
*   %j5 = (104, -36);
*   %j6 = (47, -9);
*   %j7 = (63, -9);
*   %j8 = (78, -9);
*   %j9 = (91, -9);
*   %j10 = (105, -9);
*   %j11 = (113, -9);
*   %j12 = (113, -36);
*   %j13 = (41, -17);
*   %j14 = (57, -17);
*   %j15 = (72, -17);
*   %j16 = (85, -17);
*   %j17 = (30, -36);
*   %j18 = (25, -17);
*   %j19 = (113, -22);
*   %j20 = (31, -9);
*   &bot0 @WIRE(mode="straight") {#XU0:5 #C0:2};
*   &bot1 @WIRE(mode="straight") {#C1:2 #XU1:5};
