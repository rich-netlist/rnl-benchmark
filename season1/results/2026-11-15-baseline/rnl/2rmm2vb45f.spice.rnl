*   &b5 @WIRE(mode="straight") {%port8::pin #XU5:3};
*   &b4 @WIRE(mode="straight") {%port7::pin #XU4:3};
*   $JUNCTION @ATTACH %j17(p) => @PLACE(30, -36) => %dot1;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(46, -36) => %dot2;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(62, -36) => %dot3;
