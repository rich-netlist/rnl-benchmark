
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt scdac_unit vdd vss bit nbit bot
XDN nbit bit vss vss sky130_fd_pr__nfet_01v8 l=150000 w=600000 nf=1
XDP nbit bit vdd vdd sky130_fd_pr__pfet_01v8 l=150000 w=1200000 nf=1
XSN bot nbit vss vss sky130_fd_pr__nfet_01v8 l=150000 w=2000000 nf=1
XSP bot nbit vdd vdd sky130_fd_pr__pfet_01v8 l=150000 w=4000000 nf=2
* @RNL(author="analog-canvas") {
*   %scdac_unit_SYMBOL = @DEFINE-SYMBOL(box=[-6, -6, 6, 6]) {
*     (-6, 0) @PIN(terminal="bit", label="\textbf{\textit{bit}}", direction="left");
*     (6, -2) @PIN(terminal="nbit", label="\textbf{\textit{nbit}}", direction="right");
*     (-6, 3) @PIN(terminal="bot", label="\textbf{\textit{bot}}", direction="left");
*     (6, 2) @PIN(terminal="vss", label="\textbf{\textit{v}}_{\textbf{ss}}", direction="right");
*     (-6, -3) @PIN(terminal="vdd", label="\textbf{\textit{v}}_{\textbf{dd}}", direction="left");
*     (0, 0) @RECTANGLE(width=10, height=10);
*     @LINE {(-6, 0) (-5, 0)};
*     @LINE {(6, -2) (5, -2)};
*     @LINE {(-6, 3) (-5, 3)};
*     @LINE {(6, 2) (5, 2)};
*     @LINE {(-6, -3) (-5, -3)}
*   };
*   # @SET-SYMBOL %scdac_unit_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH #(level);
*   #XDP @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"], [4, "b"]]) $CANVAS_PMOS_4TERM => @PLACE(17, -6) => @ORIENT("R0");
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15") #XDP(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="w", text="1.2") #XDP(part);
*   #XDN @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"], [4, "b"]]) $CANVAS_NMOS_4TERM => @PLACE(17, -15) => @ORIENT("R0");
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15") #XDN(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="w", text="0.6") #XDN(part);
*   #XSP @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"], [4, "b"]]) $CANVAS_PMOS_4TERM => @PLACE(27, -6) => @ORIENT("R0");
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15") #XSP(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="w", text="4") #XSP(part);
*   #XSN @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"], [4, "b"]]) $CANVAS_NMOS_4TERM => @PLACE(27, -15) => @ORIENT("R0");
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15") #XSN(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="w", text="2") #XSN(part);
*   $IO_PORT @ATTACH &bit(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(10, -11) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &nbit(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(20, -9) => @ORIENT("R270") => %port2;
*   $IO_PORT @ATTACH &bot(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(30, -11) => @ORIENT("R180") => %port3;
*   $IO_PORT @ATTACH &vss(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(22, -21) => @ORIENT("R90") => %port4;
*   $IO_PORT @ATTACH &vdd(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(22, 0) => @ORIENT("R270") => %port5;
*   %j1 = (17, -11);
*   %j2 = (23, -11);
*   %j3 = (20, -11);
*   %j4 = (27, -11);
*   %j5 = (13, -11);
*   %j6 = (22, -2);
*   %j7 = (22, -18);
*   &bit @WIRE(mode="straight") {#XDP:2 (13, -6) %j5};
*   &bit @WIRE(mode="straight") {%j5 (13, -15) #XDN:2};
*   &nbit @WIRE(mode="straight") {#XSP:2 (23, -6) %j2};
*   &nbit @WIRE(mode="straight") {%j2 (23, -15) #XSN:2};
*   &bot @WIRE(mode="straight") {#XSP:1 %j4};
*   &bot @WIRE(mode="straight") {%j4 #XSN:1};
*   &nbit @WIRE(mode="straight") {#XDP:1 %j1};
*   &nbit @WIRE(mode="straight") {%j1 #XDN:1};
*   &nbit @WIRE(mode="straight") {%j1 %j3};
*   &nbit @WIRE(mode="straight") {%j3 %j2};
*   &nbit @WIRE(mode="straight") {%port2::pin %j3};
*   &bot @WIRE(mode="straight") {%j4 %port3::pin};
*   &bit @WIRE(mode="straight") {%port1::pin %j5};
*   &vdd @WIRE(mode="straight") {#XDP:3 (17, -2) %j6};
*   &vdd @WIRE(mode="straight") {%j6 (27, -2) #XSP:3};
*   &vdd @WIRE(mode="straight") {%port5::pin %j6};
*   &vss @WIRE(mode="straight", linestyle="dashed") {#XDN:4 (18, -15) (18, -17) #XDN:3};
*   &vss @WIRE(mode="straight", linestyle="dashed") {#XSN:4 (28, -15) (28, -17) #XSN:3};
*   &vss @WIRE(mode="straight") {#XDN:3 (17, -18) %j7};
*   &vss @WIRE(mode="straight") {%j7 %port4::pin};
*   &vss @WIRE(mode="straight") {%j7 (27, -18) #XSN:3};
*   $JUNCTION @ATTACH %j4(p) => @PLACE(27, -11) => %dot1;
*   $JUNCTION @ATTACH %j5(p) => @PLACE(13, -11) => %dot2;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(17, -11) => %dot3;
*   $JUNCTION @ATTACH %j3(p) => @PLACE(20, -11) => %dot4;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(23, -11) => %dot5;
*   $JUNCTION @ATTACH %j6(p) => @PLACE(22, -2) => %dot6;
*   $JUNCTION @ATTACH (17, -17)(p) => @PLACE(17, -17) => %dot7;
*   $JUNCTION @ATTACH %j7(p) => @PLACE(22, -18) => %dot8;
*   $JUNCTION @ATTACH (27, -17)(p) => @PLACE(27, -17) => %dot9;
*   #XDP
*       @TEXT("\textbf{\textit{XDP}}", key="name", dx=-5, dy=2, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XDP::name(label);
*   #XDN
*       @TEXT("\textbf{\textit{XDN}}", key="name", dx=-4, dy=-3, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XDN::name(label);
*   #XSP
*       @TEXT("\textbf{\textit{XSP}}", key="name", dx=1, dy=-1, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XSP::name(label);
*   #XSN
*       @TEXT("\textbf{\textit{XSN}}", key="name", dx=3, dy=-2, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XSN::name(label);
*   %port1
*       @TEXT("\textbf{\textit{bit}}", key="netname", dx=-2, dy=-1, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{nbit}}", key="netname", dx=-1, dy=2, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %port3
*       @TEXT("\textbf{\textit{bot}}", key="netname", dx=2, dy=1, halign="start", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
*   %port4
*       @TEXT("\textbf{\textit{v}}_{\textbf{ss}}", key="netname", dx=1, dy=-2, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::netname(label);
*   %port5
*       @TEXT("\textbf{\textit{v}}_{\textbf{dd}}", key="netname", dx=1, dy=2, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port5::netname(label)
* }
.ends scdac_unit

.subckt switched_capacitor_dac_6bit vdd vss reset b0 b1 b2 b3 b4 b5 vout
C0 vout bot0 16f
C1 vout bot1 32f
C2 vout bot2 64f
C3 vout bot3 128f
C4 vout bot4 256f
C5 vout bot5 512f
CDUMMY vout vss 16f
XRESET vout reset vss vss sky130_fd_pr__nfet_01v8 l=300000 w=2000000 nf=2
XU0 vdd vss b0 nb0 bot0 scdac_unit
XU1 vdd vss b1 nb1 bot1 scdac_unit
XU2 vdd vss b2 nb2 bot2 scdac_unit
XU3 vdd vss b3 nb3 bot3 scdac_unit
XU4 vdd vss b4 nb4 bot4 scdac_unit
XU5 vdd vss b5 nb5 bot5 scdac_unit
* @RNL(author="analog-canvas") {
*   $CANVAS_TYPESETTING @ATTACH #(level);
*   #XU0 @PLACE(28, -28) => @ORIENT("R270");
*   #XU1 @PLACE(44, -28) => @ORIENT("R270");
*   #XU2 @PLACE(60, -28) => @ORIENT("R270");
*   #XU3 @PLACE(75, -28) => @ORIENT("R270");
*   #XU4 @PLACE(88, -28) => @ORIENT("R270");
*   #XU5 @PLACE(102, -28) => @ORIENT("R270");
*   #XRESET @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"], [4, "b"]]) $CANVAS_NMOS_4TERM => @PLACE(113, -19) => @ORIENT("R0");
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.3") #XRESET(part);
