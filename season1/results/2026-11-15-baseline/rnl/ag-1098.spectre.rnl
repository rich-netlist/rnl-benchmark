subckt dut (VDD VSS VB LOP LON OUTP OUTN BIAS RFINP RFINN)
C1 (net1 RFINP) capacitor c=1p
C2 (net0 RFINN) capacitor c=1p
M1 (net2 net1 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (net3 net0 VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (OUTP LOP net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (OUTN LON net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (OUTP LON net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (OUTN LOP net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MP1 (net2 net3 net4 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
MP2 (net3 net2 net4 VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
MP3 (net4 VB VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (VDD OUTP) resistor r=1k
R2 (VDD OUTN) resistor r=1k
R3 (net1 BIAS) resistor r=1k
R4 (BIAS net0) resistor r=1k
