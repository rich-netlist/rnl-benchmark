.subckt rf_tr_switch VSS tx ant rx ctx crx
XM1 ant net10 tx net6 sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=10
XM2 tx net1 net7 net12 sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=2
XM3 net7 net4 VSS net11 sky130_fd_pr__nfet_01v8 l=0.15 w=10 nf=1 m=2
