simulator lang=spectre
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-style", version="0.4");
//   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
//   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
//   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
//   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
// }

subckt dut (Vdd VSS Vrf Vrf_bar Vrfdcn Vrfdcp Vlo Vlodc Vlo_bar Vout Vout_bar)
Cd1 (net1 Vrf) capacitor c=1p
Cd2 (net0 Vrf_bar) capacitor c=1p
Cf (Vout Vout_bar) capacitor c=1p
M1 (V1 Vrf VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (V1p Vrf_bar VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (V1 net1 Vdd Vdd) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (V1p net0 Vdd Vdd) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (Vout Vlo_bar V1p VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (Vout Vlo V1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M7 (Vout_bar Vlo_bar V1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M8 (Vout_bar Vlo V1p VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1 (Vdd Vout) resistor r=1k
R2 (Vout_bar Vdd) resistor r=1k
R3 (net1 Vrfdcp) resistor r=1M
R4 (Vrfdcp net0) resistor r=1M
R5 (Vrf Vrfdcn) resistor r=1M
R6 (Vrfdcn Vrf_bar) resistor r=1M
R7 (Vlo Vlodc) resistor r=1M
R8 (Vlodc Vlo_bar) resistor r=1M
