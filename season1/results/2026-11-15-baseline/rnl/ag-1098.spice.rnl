.subckt dut VDD VSS VB LOP LON OUTP OUTN BIAS RFINP RFINN
C1 net1 RFINP 1p
C2 net0 RFINN 1p
XM1 net2 net1 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 net3 net0 VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 OUTP LOP net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 OUTN LON net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 OUTP LON net3 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 OUTN LOP net3 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMP1 net2 net3 net4 VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XMP2 net3 net2 net4 VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XMP3 net4 VB VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
R1 VDD OUTP 1k
R2 VDD OUTN 1k
R3 net1 BIAS 1k
R4 BIAS net0 1k
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-7, -9, 7, 9]) {
*     (-7, 4) @PIN(terminal="VB", label="\textbf{\textit{V}}_{\textbf{B}}", direction="left");
*     (-7, 0) @PIN(terminal="LOP", label="\textbf{\textit{LOP}}", direction="left");
*     (0, -9) @PIN(terminal="LON", label="\textbf{\textit{LON}}", direction="down");
*     (-7, 2) @PIN(terminal="OUTP", label="\textbf{\textit{OUTP}}", direction="left");
*     (7, 1) @PIN(terminal="OUTN", label="\textbf{\textit{OUTN}}", direction="right");
*     (-7, -4) @PIN(terminal="BIAS", label="\textbf{\textit{BIAS}}", direction="left");
*     (-7, -2) @PIN(terminal="RFINP", label="\textbf{\textit{RFINP}}", direction="left");
*     (7, -1) @PIN(terminal="RFINN", label="\textbf{\textit{RFINN}}", direction="right");
*     (0, 9) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (0, 0) @RECTANGLE(width=12, height=16);
*     @LINE {(-7, 4) (-6, 4)};
*     @LINE {(-7, 0) (-6, 0)};
*     @LINE {(0, -9) (0, -8)};
*     @LINE {(-7, 2) (-6, 2)};
*     @LINE {(7, 1) (6, 1)};
*     @LINE {(-7, -4) (-6, -4)};
*     @LINE {(-7, -2) (-6, -2)};
*     @LINE {(7, -1) (6, -1)};
*     @LINE {(0, 9) (0, 8)}
*   };
*   # @SET-SYMBOL %dut_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #R1 @SET-SYMBOL $RESISTOR => @PLACE(-15, -5) => @ORIENT("R0");
*   #R2 @SET-SYMBOL $RESISTOR => @PLACE(15, -5) => @ORIENT("R0");
*   #XMP3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(0, 0) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP3") #XMP3(part);
*   #XMP1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(-11, -6) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MP1") #XMP1(part);
*   #XMP2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(11, -6) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP2") #XMP2(part);
*   #XM3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(-15, -19) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M3") #XM3(part);
*   #XM4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(-7, -19) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M4") #XM4(part);
*   #XM5 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(7, -19) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M5") #XM5(part);
*   #XM6 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(15, -19) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M6") #XM6(part);
*   #XM1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(-11, -24) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M1") #XM1(part);
*   #XM2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(11, -24) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M2") #XM2(part);
*   #C1 @SET-SYMBOL $CAPACITOR => @PLACE(-17, -24) => @ORIENT("R270");
*   #C2 @SET-SYMBOL $CAPACITOR => @PLACE(17, -24) => @ORIENT("R90");
*   #R3 @SET-SYMBOL $RESISTOR => @PLACE(-15, -27) => @ORIENT("R0");
*   #R4 @SET-SYMBOL $RESISTOR => @PLACE(15, -27) => @ORIENT("R180");
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(-11, -26) => @ORIENT("R0") => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(11, -26) => @ORIENT("R0") => %gnd2;
*   $IO_PORT @ATTACH &VB(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-5, 0) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &LOP(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-20, -19) => @ORIENT("R0") => %port2;
*   $IO_PORT @ATTACH &LOP(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(20, -19) => @ORIENT("MY") => %port3;
*   $IO_PORT @ATTACH &LON(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(0, -21) => @ORIENT("R90") => %port4;
*   $IO_PORT @ATTACH &OUTP(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-19, -12) => @ORIENT("R0") => %port5;
*   $IO_PORT @ATTACH &OUTN(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(19, -12) => @ORIENT("MY") => %port6;
*   $IO_PORT @ATTACH &BIAS(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-17, -29) => @ORIENT("R0") => %port7;
*   $IO_PORT @ATTACH &RFINP(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-21, -24) => @ORIENT("R0") => %port8;
*   $IO_PORT @ATTACH &RFINN(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(21, -24) => @ORIENT("MY") => %port9;
*   $IO_PORT @ATTACH &BIAS(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(17, -29) => @ORIENT("MY") => %port10;
*   %j1 = (-17, 2);
*   %j2 = (17, 2);
*   %j3 = (0, 2);
*   %j4 = (-15, 2);
*   %j5 = (15, 2);
*   %j6 = (0, -3);
