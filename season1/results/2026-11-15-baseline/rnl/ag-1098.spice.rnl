*   &BIAS @WIRE(mode="straight") {#R4:1 %port10::pin};
*   &RFINN @WIRE(mode="straight") {#C2:2 %port9::pin};
*   $JUNCTION @ATTACH (15, -24)(p) => @PLACE(15, -24) => %dot1;
*   $JUNCTION @ATTACH (-15, -24)(p) => @PLACE(-15, -24) => %dot2;
*   $JUNCTION @ATTACH %j11(p) => @PLACE(0, -19) => %dot3;
