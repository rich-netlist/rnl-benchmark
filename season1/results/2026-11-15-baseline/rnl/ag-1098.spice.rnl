*   &net2 @WIRE(mode="straight") {#XMP2:2 (2, -6) (-2, -10) %j7};
*   &net3 @WIRE(mode="straight") {#XMP1:2 (-2, -6) (2, -10) %j8};
*   &OUTP @WIRE(mode="straight") {#R1:2 %j9};
*   &OUTP @WIRE(mode="straight") {%j9 #XM3:1};
*   &OUTN @WIRE(mode="straight") {#R2:2 %j10};
