*   &OUTP @WIRE(mode="straight") {%port5::pin %j9};
*   &OUTN @WIRE(mode="straight") {%port6::pin %j10};
*   &OUTP @WIRE(mode="straight") {#XM5:1 (7, -16) (2, -16) (-2, -12) %j9};
*   &OUTN @WIRE(mode="straight") {#XM4:1 (-7, -16) (-2, -16) (2, -12) %j10};
*   &net2 @WIRE(mode="straight") {#XM3:3 (-15, -22) #XM1:1};
*   &net2 @WIRE(mode="straight") {#XM1:1 (-7, -22) #XM4:3};
*   &net3 @WIRE(mode="straight") {#XM6:3 (15, -22) #XM2:1};
*   &net3 @WIRE(mode="straight") {#XM2:1 (7, -22) #XM5:3};
*   &LON @WIRE(mode="straight") {#XM4:2 %j11};
*   &LON @WIRE(mode="straight") {%j11 #XM5:2};
*   &LON @WIRE(mode="straight") {%port4::pin %j11};
*   &net1 @WIRE(mode="straight") {#C1:1 #XM1:2};
*   &net1 @WIRE(mode="straight") {#R3:1 #C1:1};
*   &BIAS @WIRE(mode="straight") {#R3:2 %port7::pin};
