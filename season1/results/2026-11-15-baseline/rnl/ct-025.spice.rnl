
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt dut VDD VSS Vin1 Vin2 Vout1 Vout2
I1 net0 VSS DC 1m
I2 net1 VSS DC 1m
I3 VDD X DC 1m
I4 VDD Y DC 1m
XM1 X Vin1 net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 Y Vin2 net1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 net0 X VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 net1 Y VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 Vout1 Y VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 Vout2 X VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
RD1 Vout1 VSS 1k
RD2 Vout2 VSS 1k
RS net1 net0 1k
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-7, -6, 7, 6]) {
*     (-7, -1) @PIN(terminal="Vin1", label="\textbf{\textit{V}}_{\textbf{in1}}", direction="left");
*     (7, 1) @PIN(terminal="Vin2", label="\textbf{\textit{V}}_{\textbf{in2}}", direction="right");
*     (7, -1) @PIN(terminal="Vout1", label="\textbf{\textit{V}}_{\textbf{out1}}", direction="right");
*     (7, -3) @PIN(terminal="Vout2", label="\textbf{\textit{V}}_{\textbf{out2}}", direction="right");
*     (0, 6) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (0, 0) @RECTANGLE(width=12, height=10);
*     @LINE {(-7, -1) (-6, -1)};
*     @LINE {(7, 1) (6, 1)};
*     @LINE {(7, -1) (6, -1)};
*     @LINE {(7, -3) (6, -3)};
*     @LINE {(0, 6) (0, 5)}
*   };
*   # @SET-SYMBOL %dut_SYMBOL;
