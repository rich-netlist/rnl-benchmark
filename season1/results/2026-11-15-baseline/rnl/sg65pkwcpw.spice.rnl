
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt ffe3_cml_driver VDD VSS txn txp den dep vcas vpre dp dn vmain dln dlp vpost
XM1 txn den net5 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=16
XM2 txp dep net5 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=16
XM3 txn dp net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=48
XM4 txp dn net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=48
XM5 txn dln net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=16
XM6 txp dlp net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=4 nf=1 m=16
XMC1 net5 vcas net1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1 m=32
XMC2 net0 vcas net4 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1 m=96
XMC3 net2 vcas net3 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=2 nf=1 m=32
XMT1 net1 vpre VSS VSS sky130_fd_pr__nfet_01v8 l=0.5 w=2 nf=1 m=32
XMT2 net4 vmain VSS VSS sky130_fd_pr__nfet_01v8 l=0.5 w=2 nf=1 m=96
XMT3 net3 vpost VSS VSS sky130_fd_pr__nfet_01v8 l=0.5 w=2 nf=1 m=32
RL1 VDD txn 50Ω
RL2 VDD txp 50Ω
* @RNL(author="analog-canvas") {
*   %ffe3_cml_driver_SYMBOL = @DEFINE-SYMBOL(box=[-7, -10, 7, 10]) {
*     (0, 10) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (-7, 5) @PIN(terminal="txn", label="\textbf{\textit{txn}}", direction="left");
*     (7, 3) @PIN(terminal="txp", label="\textbf{\textit{txp}}", direction="right");
*     (-7, 3) @PIN(terminal="den", label="\textbf{\textit{den}}", direction="left");
*     (-7, 1) @PIN(terminal="dep", label="\textbf{\textit{dep}}", direction="left");
*     (-7, -3) @PIN(terminal="vcas", label="\textbf{\textit{v}}_{\textbf{cas}}", direction="left");
*     (-7, -5) @PIN(terminal="vpre", label="\textbf{\textit{v}}_{\textbf{pre}}", direction="left");
*     (-7, -1) @PIN(terminal="dp", label="\textbf{\textit{dp}}", direction="left");
*     (7, 1) @PIN(terminal="dn", label="\textbf{\textit{dn}}", direction="right");
*     (-7, -7) @PIN(terminal="vmain", label="\textbf{\textit{v}}_{\textbf{main}}", direction="left");
*     (7, -1) @PIN(terminal="dln", label="\textbf{\textit{dln}}", direction="right");
*     (7, -3) @PIN(terminal="dlp", label="\textbf{\textit{dlp}}", direction="right");
*     (7, -5) @PIN(terminal="vpost", label="\textbf{\textit{v}}_{\textbf{post}}", direction="right");
*     (0, 0) @RECTANGLE(width=12, height=18);
*     @LINE {(0, 10) (0, 9)};
*     @LINE {(-7, 5) (-6, 5)};
*     @LINE {(7, 3) (6, 3)};
*     @LINE {(-7, 3) (-6, 3)};
*     @LINE {(-7, 1) (-6, 1)};
*     @LINE {(-7, -3) (-6, -3)};
*     @LINE {(-7, -5) (-6, -5)};
*     @LINE {(-7, -1) (-6, -1)};
*     @LINE {(7, 1) (6, 1)};
*     @LINE {(-7, -7) (-6, -7)};
*     @LINE {(7, -1) (6, -1)};
*     @LINE {(7, -3) (6, -3)};
*     @LINE {(7, -5) (6, -5)}
*   };
*   # @SET-SYMBOL %ffe3_cml_driver_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
