*   $CANVAS_NAME @ATTACH(name="MC1") #XMC1(part);
*   $CANVAS_PARAMETER_TEXT @ATTACH(name="l", text="0.15u") #XMC1(part);
*   #XMT1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(14, -4) => @ORIENT("R0");
