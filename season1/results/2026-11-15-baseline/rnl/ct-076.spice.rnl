*   %j13 = (36, -33);
*   %j14 = (58, -33);
*   %j15 = (62, -33);
*   %j16 = (19, -15);
*   %j17 = (75, -15);
*   %j18 = (47, -29);
*   &VDD @WIRE(mode="straight") {#XM1:1 %j1};
*   &VDD @WIRE(mode="straight") {#XM2:1 %j2};
*   &VDD @WIRE(mode="straight") {#RD:1 %j3};
