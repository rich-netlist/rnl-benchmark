*   &Vout @WIRE(mode="straight") {%j7 %j12};
*   &Vout @WIRE(mode="straight") {%j7 %port5::pin};
*   &Vout @WIRE(mode="straight") {%j12 (53, -25) #XM6:1};
*   &net0 @WIRE(mode="straight") {#XM1:3 %j8};
*   &net0 @WIRE(mode="straight") {%j8 %j9};
*   &net0 @WIRE(mode="straight") {#XM2:3 %j9};
*   &net0 @WIRE(mode="straight") {%j9 %j13};
*   &net0 @WIRE(mode="straight") {%j13 #ISS1:1};
*   &net0 @WIRE(mode="straight") {%j13 (41, -33) #XM3:3};
*   &net1 @WIRE(mode="straight") {#XM6:3 %j11};
*   &net1 @WIRE(mode="straight") {%j11 %j14};
*   &net1 @WIRE(mode="straight") {%j14 #ISS2:1};
*   &net1 @WIRE(mode="straight") {%j14 %j15};
*   &net1 @WIRE(mode="straight") {#XM5:3 %j15};
*   &net1 @WIRE(mode="straight") {%j15 %j10};
*   &net1 @WIRE(mode="straight") {#XM4:3 %j10};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j16 %j1};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j1 %j2};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j2 %j3};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j3 %j4};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j4 %j5};
*   &VDD @WIRE(mode="straight", linestyle="bold") {%j5 %j17};
*   &Vb @WIRE(mode="straight") {#XM3:2 %j18};
*   &Vb @WIRE(mode="straight") {%j18 #XM6:2};
*   &Vb @WIRE(mode="straight") {%port6::pin %j18};
*   &B @WIRE(mode="straight") {#XM2:2 %port2::pin};
*   &B_bar @WIRE(mode="straight") {#XM5:2 %port3::pin};
*   $JUNCTION @ATTACH %j18(p) => @PLACE(47, -29) => %dot1;
*   &A @WIRE(mode="straight") {%port1::pin #XM1:2};
*   &A_bar @WIRE(mode="straight") {%port4::pin #XM4:2};
*   $JUNCTION @ATTACH %j7(p) => @PLACE(47, -23) => %dot2;
*   $JUNCTION @ATTACH %j12(p) => @PLACE(47, -25) => %dot3;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(21, -15) => %dot4;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(32, -15) => %dot5;
