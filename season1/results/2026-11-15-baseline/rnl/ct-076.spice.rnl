
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7")
* }
.subckt dut VDD VSS A B B_bar A_bar Vout Vb
ISS1 net0 VSS DC 1m
ISS2 net1 VSS DC 1m
XM1 VDD A net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 VDD B net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 Vout Vb net0 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 VDD A_bar net1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM5 VDD B_bar net1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM6 Vout Vb net1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
RD VDD Vout 1k
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-6, -7, 6, 7]) {
*     (-6, 1) @PIN(terminal="A", label="\textbf{\textit{A}}", direction="left");
*     (-6, -1) @PIN(terminal="B", label="\textbf{\textit{B}}", direction="left");
*     (6, 0) @PIN(terminal="B_bar", label="\overline{\textbf{\textit{B}}}", direction="right");
*     (6, -2) @PIN(terminal="A_bar", label="\overline{\textbf{\textit{A}}}", direction="right");
*     (6, 2) @PIN(terminal="Vout", label="\textbf{\textit{V}}_{\textbf{out}}", direction="right");
*     (0, 7) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (0, -7) @PIN(terminal="Vb", label="\textbf{\textit{V}}_{\textbf{b}}", direction="down");
*     (0, 0) @RECTANGLE(width=10, height=12);
*     @LINE {(-6, 1) (-5, 1)};
*     @LINE {(-6, -1) (-5, -1)};
*     @LINE {(6, 0) (5, 0)};
*     @LINE {(6, -2) (5, -2)};
*     @LINE {(6, 2) (5, 2)};
*     @LINE {(0, 7) (0, 6)};
*     @LINE {(0, -7) (0, -6)}
*   };
*   # @SET-SYMBOL %dut_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XM1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(21, -29) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M1") #XM1(part);
*   #XM2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(32, -29) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M2") #XM2(part);
*   #XM3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(41, -29) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M3") #XM3(part);
*   #XM6 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(53, -29) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M6") #XM6(part);
*   #XM5 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(62, -29) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M5") #XM5(part);
*   #XM4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(73, -29) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="M4") #XM4(part);
*   #RD @SET-SYMBOL $RESISTOR => @PLACE(47, -19) => @ORIENT("R0");
*   #ISS1 @SET-SYMBOL $CURRENT_SOURCE => @PLACE(36, -37) => @ORIENT("R0");
