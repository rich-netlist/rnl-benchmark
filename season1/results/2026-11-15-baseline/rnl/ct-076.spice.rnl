*   #ISS2 @SET-SYMBOL $CURRENT_SOURCE => @PLACE(58, -37) => @ORIENT("R0");
*   $CANVAS_PARAMETER @ATTACH(name="amplitude", text="1m") #ISS2(part);
*   $CANVAS_PARAMETER @ATTACH(name="damping", text="0") #ISS2(part);
*   $CANVAS_PARAMETER @ATTACH(name="delay", text="0") #ISS2(part);
*   $CANVAS_PARAMETER @ATTACH(name="fall", text="1ps") #ISS2(part);
*   $CANVAS_PARAMETER @ATTACH(name="frequency", text="1k") #ISS2(part);
*   $CANVAS_PARAMETER @ATTACH(name="high", text="1m") #ISS2(part);
*   $CANVAS_PARAMETER @ATTACH(name="low", text="0") #ISS2(part);
*   $CANVAS_PARAMETER @ATTACH(name="offset", text="0") #ISS2(part);
