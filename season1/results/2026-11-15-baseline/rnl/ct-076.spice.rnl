*   $CANVAS_PARAMETER @ATTACH(name="phase", text="0") #ISS2(part);
*   $CANVAS_PARAMETER @ATTACH(name="rise", text="1ps") #ISS2(part);
*   $CANVAS_PARAMETER @ATTACH(name="waveform", text="dc") #ISS2(part);
*   $CANVAS_PARAMETER @ATTACH(name="width", text="5ns") #ISS2(part);
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(36, -39) => @ORIENT("R0") => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(58, -39) => @ORIENT("R0") => %gnd2;
*   $IO_PORT @ATTACH &A(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(18, -29) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &B(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(29, -29) => @ORIENT("R0") => %port2;
*   $IO_PORT @ATTACH &B_bar(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(65, -29) => @ORIENT("MY") => %port3;
*   $IO_PORT @ATTACH &A_bar(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(76, -29) => @ORIENT("MY") => %port4;
*   $IO_PORT @ATTACH &Vout(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(54, -23) => @ORIENT("MY") => %port5;
*   $IO_PORT @ATTACH &Vb(p) => @SET-SYMBOL $CANVAS_PORT_FILLED => @PLACE(47, -33) => @ORIENT("R90") => %port6;
*   %j1 = (21, -15);
*   %j2 = (32, -15);
*   %j3 = (47, -15);
*   %j4 = (62, -15);
*   %j5 = (73, -15);
*   %j6 = (41, -25);
*   %j7 = (47, -23);
*   %j8 = (21, -33);
*   %j9 = (32, -33);
