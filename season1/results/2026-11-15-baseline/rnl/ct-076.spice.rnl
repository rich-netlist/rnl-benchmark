*   $CANVAS_PARAMETER @ATTACH(name="damping", text="0") #ISS1(part);
*   $CANVAS_PARAMETER @ATTACH(name="delay", text="0") #ISS1(part);
*   $CANVAS_PARAMETER @ATTACH(name="fall", text="1ps") #ISS1(part);
*   $CANVAS_PARAMETER @ATTACH(name="frequency", text="1k") #ISS1(part);
*   $CANVAS_PARAMETER @ATTACH(name="high", text="1m") #ISS1(part);
*   $CANVAS_PARAMETER @ATTACH(name="low", text="0") #ISS1(part);
*   $CANVAS_PARAMETER @ATTACH(name="offset", text="0") #ISS1(part);
