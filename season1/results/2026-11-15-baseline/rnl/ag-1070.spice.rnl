
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @USE-PACKAGE(name="rnl-std-logic", version="0.4")
* }
* Ideal buffer: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt buffer A Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(V(hA))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends buffer

* Ideal inverter: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt inverter A Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(1-V(hA))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends inverter

* Ideal nand-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt nand_gate A B Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
BhB hB 0 V={0.5*(1+tanh((V(B,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(1-V(hA)*V(hB))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends nand_gate

* Ideal nor-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt nor_gate A B Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
BhB hB 0 V={0.5*(1+tanh((V(B,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*((1-V(hA))*(1-V(hB)))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends nor_gate

* Ideal or-gate: switches at V(VDD,VSS)/2; vt sets the step width, td the delay
.subckt or_gate A B Y VDD VSS params: vt=10m td=10p
BhA hA 0 V={0.5*(1+tanh((V(A,VSS)-0.5*V(VDD,VSS))/vt))}
BhB hB 0 V={0.5*(1+tanh((V(B,VSS)-0.5*V(VDD,VSS))/vt))}
Bf nfn VSS V={V(VDD,VSS)*(1-(1-V(hA))*(1-V(hB)))}
Rd nfn ndl 1k
Cd ndl VSS {td/1000}
BY Y VSS V={V(ndl,VSS)}
.ends or_gate

.subckt CP VDD VSS cal_bar out out_bar Vc
Cm net1 VSS 1p
Cp net3 VSS 1p
XM1 net3 net0 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM2 Vc net4 net3 VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XM3 Vc net5 net1 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XM4 net1 cal_bar VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
X1 cal_bar net0 VDD VSS inverter td=10p vt=10m
X2 cal_bar net2 VDD VSS inverter td=10p vt=10m
X3 out net2 net4 VDD VSS or_gate td=10p vt=10m
X4 net2 out_bar net5 VDD VSS nor_gate td=10p vt=10m
* @RNL(author="analog-canvas") {
*   %CP_SYMBOL = @DEFINE-SYMBOL(box=[-8, -7, 8, 7]) {
*     (-5, 7) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (-8, 0) @PIN(terminal="cal_bar", label="\overline{\textbf{\textit{cal}}}", direction="left");
*     (-8, 2) @PIN(terminal="out", label="\textbf{\textit{out}}", direction="left");
*     (-8, -2) @PIN(terminal="out_bar", label="\overline{\textbf{\textit{out}}}", direction="left");
*     (4, 7) @PIN(terminal="Vc", label="\textbf{\textit{V}}_{\textbf{c}}", direction="up");
*     (0, 0) @RECTANGLE(width=14, height=12);
*     @LINE {(-5, 7) (-5, 6)};
*     @LINE {(-8, 0) (-7, 0)};
*     @LINE {(-8, 2) (-7, 2)};
*     @LINE {(-8, -2) (-7, -2)};
*     @LINE {(4, 7) (4, 6)}
*   };
*   # @SET-SYMBOL %CP_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #X1 @SET-SYMBOL(terminals=[[1, "a"], [2, "y"]]) $INVERTER => @PLACE(11, -3) => @ORIENT("R0");
*   #XM1 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(18, -3) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M1") #XM1(part);
*   #X2 @SET-SYMBOL(terminals=[[1, "a"], [2, "y"]]) $INVERTER => @PLACE(9, -13) => @ORIENT("R0");
*   #X3 @SET-SYMBOL(terminals=[[1, "a"], [2, "b"], [3, "y"]]) $OR_2INPUT => @PLACE(17, -10) => @ORIENT("R0");
*   #XM2 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(24, -10) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M2") #XM2(part);
*   #X4 @SET-SYMBOL(terminals=[[1, "a"], [2, "b"], [3, "y"]]) $NOR_2INPUT => @PLACE(17, -16) => @ORIENT("R0");
*   #XM3 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(24, -16) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M3") #XM3(part);
*   #XM4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(18, -23) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="M4") #XM4(part);
*   #Cp @SET-SYMBOL $CAPACITOR => @PLACE(32, -8) => @ORIENT("R0");
*   #Cm @SET-SYMBOL $CAPACITOR => @PLACE(32, -22) => @ORIENT("R0");
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(18, -1) => @ORIENT("R0") => %vdd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(18, -25) => @ORIENT("R0") => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(32, -10) => @ORIENT("R0") => %gnd2;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(32, -24) => @ORIENT("R0") => %gnd3;
*   $IO_PORT @ATTACH &cal_bar(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(2, -3) => @ORIENT("R0") => %port1;
*   $IO_PORT @ATTACH &out(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(2, -9) => @ORIENT("R0") => %port2;
*   $IO_PORT @ATTACH &out_bar(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(2, -17) => @ORIENT("R0") => %port3;
*   $IO_PORT @ATTACH &Vc(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(28, -13) => @ORIENT("MY") => %port4;
*   %j1 = (4, -3);
*   %j2 = (4, -13);
*   %j3 = (12, -13);
*   %j4 = (24, -6);
*   %j5 = (24, -13);
*   %j6 = (24, -20);
*   &cal_bar @WIRE(mode="straight") {%port1::pin %j1};
*   &cal_bar @WIRE(mode="straight") {%j1 #X1:1};
*   &cal_bar @WIRE(mode="straight") {#XM4:2 (4, -23) %j2};
*   &cal_bar @WIRE(mode="straight") {%j2 %j1};
*   &cal_bar @WIRE(mode="straight") {#X2:1 %j2};
*   &net0 @WIRE(mode="straight") {#X1:2 #XM1:2};
*   &out @WIRE(mode="straight") {%port2::pin #X3:1};
*   &out_bar @WIRE(mode="straight") {%port3::pin #X4:2};
*   &net2 @WIRE(mode="straight") {#X2:2 %j3};
*   &net2 @WIRE(mode="straight") {%j3 (12, -11) #X3:2};
*   &net2 @WIRE(mode="straight") {#X4:1 (12, -15) %j3};
*   &net4 @WIRE(mode="straight") {#X3:3 #XM2:2};
*   &net5 @WIRE(mode="straight") {#X4:3 #XM3:2};
*   &net3 @WIRE(mode="straight") {#XM1:1 (18, -6) %j4};
*   &net3 @WIRE(mode="straight") {%j4 #XM2:3};
*   &net3 @WIRE(mode="straight") {#Cp:1 %j4};
*   &Vc @WIRE(mode="straight") {#XM2:1 %j5};
*   &Vc @WIRE(mode="straight") {%j5 #XM3:1};
*   &Vc @WIRE(mode="straight") {%port4::pin %j5};
*   &net1 @WIRE(mode="straight") {#XM3:3 %j6};
*   &net1 @WIRE(mode="straight") {%j6 (18, -20) #XM4:1};
*   &net1 @WIRE(mode="straight") {#Cm:1 %j6};
*   &VDD @WIRE(mode="straight") {%vdd1::pin #XM1:3};
*   $JUNCTION @ATTACH %j1(p) => @PLACE(4, -3) => %dot1;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(4, -13) => %dot2;
*   $JUNCTION @ATTACH %j5(p) => @PLACE(24, -13) => %dot3;
*   &VSS @WIRE(mode="straight") {%gnd1::pin #XM4:3};
*   &VSS @WIRE(mode="straight") {%gnd2::pin #Cp:2};
*   &VSS @WIRE(mode="straight") {%gnd3::pin #Cm:2};
*   $JUNCTION @ATTACH %j6(p) => @PLACE(24, -20) => %dot4;
*   $JUNCTION @ATTACH %j3(p) => @PLACE(12, -13) => %dot5;
*   $JUNCTION @ATTACH %j4(p) => @PLACE(24, -6) => %dot6;
*   #X1
*       @TEXT("\textbf{\textit{X}}_{\textbf{1}}", key="name", dx=-0.5, dy=-2.9, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #X1::name(label);
*   #XM1
*       @TEXT("\textbf{\textit{M}}_{\textbf{1}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM1::name(label);
*   #X2
*       @TEXT("\textbf{\textit{X}}_{\textbf{2}}", key="name", dx=-0.5, dy=-2.9, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #X2::name(label);
*   #X3
*       @TEXT("\textbf{\textit{X}}_{\textbf{3}}", key="name", dx=-0.5, dy=-3.3, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #X3::name(label);
*   #XM2
*       @TEXT("\textbf{\textit{M}}_{\textbf{2}}", key="name", dx=0.4, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM2::name(label);
*   #X4
*       @TEXT("\textbf{\textit{X}}_{\textbf{4}}", key="name", dx=0, dy=-3.3, halign="middle", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #X4::name(label);
*   #XM3
*       @TEXT("\textbf{\textit{M}}_{\textbf{3}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM3::name(label);
*   #XM4
*       @TEXT("\textbf{\textit{M}}_{\textbf{4}}", key="name", dx=0.5, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #XM4::name(label);
*   #Cp
*       @TEXT("\textbf{\textit{C}}_{\textbf{p}}", key="name", dx=1.2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #Cp::name(label);
*   #Cm
*       @TEXT("\textbf{\textit{C}}_{\textbf{m}}", key="name", dx=1.2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="name") #Cm::name(label);
*   %vdd1 @TEXT("\textbf{\textit{V}}_{\textbf{DD}}", dx=2, dy=1, size=1.5116, bold=false) => %power1;
*   $CANVAS_LABEL @ATTACH(bind="port") %power1(label);
*   %port1
*       @TEXT("\overline{\textbf{\textit{cal}}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port1::netname(label);
*   %port2
*       @TEXT("\textbf{\textit{out}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116, bold=false,
*       textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port2::netname(label);
*   %port3
*       @TEXT("\overline{\textbf{\textit{out}}}", key="netname", dx=-2, dy=-0.5, halign="end", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port3::netname(label);
*   %port4
*       @TEXT("\textbf{\textit{V}}_{\textbf{c}}", key="netname", dx=2, dy=-0.5, halign="start", valign="baseline", size=1.5116,
*       bold=false, textvisible=true);
*   $CANVAS_LABEL @ATTACH(bind="port") %port4::netname(label);
*   %vdd1 @TEXT("${p}", key="netname", textvisible=false)
* }
.ends CP

.subckt dut VDD VSS clk out_bar out Vip Vim cal valid cal_bar
Ccal_n net3 VSS 1p
Ccal_p net4 VSS 1p
XMN1m net0 net1 net6 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMN1p net1 net0 net2 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMNcm net6 net3 net5 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMNcp net2 net4 net5 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMNim net6 Vim net5 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMNip net2 Vip net5 VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMNs Vip cal Vim VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMNt net5 clk VSS VSS sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
XMP1m net0 net1 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XMP1p net1 net0 VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XMP2m net0 clk VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XMP2p net1 clk VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XMP3m net6 clk VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XMP3p net2 clk VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
XMP4 net5 clk VDD VDD sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
X1 net1 out_bar VDD VSS buffer td=10p vt=10m
X2 net0 out VDD VSS buffer td=10p vt=10m
X3 out out_bar valid VDD VSS nand_gate td=10p vt=10m
X4 VDD VSS cal_bar out out_bar net4 CP
X5 VDD VSS cal_bar out_bar out net3 CP
* @RNL(author="analog-canvas") {
*   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-8, -8, 8, 8]) {
*     (0, 8) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
*     (-8, 3) @PIN(terminal="clk", label="\textbf{\textit{clk}}", direction="left");
*     (-8, 1) @PIN(terminal="out_bar", label="\overline{\textbf{\textit{out}}}", direction="left");
*     (8, 1) @PIN(terminal="out", label="\textbf{\textit{out}}", direction="right");
*     (-8, -3) @PIN(terminal="Vip", label="\textbf{\textit{V}}_{\textbf{ip}}", direction="left");
*     (8, -1) @PIN(terminal="Vim", label="\textbf{\textit{V}}_{\textbf{im}}", direction="right");
*     (-8, -5) @PIN(terminal="cal", label="\textbf{\textit{cal}}", direction="left");
*     (8, -3) @PIN(terminal="valid", label="valid", direction="right");
*     (-8, -1) @PIN(terminal="cal_bar", label="\overline{\textbf{\textit{cal}}}", direction="left");
*     (0, 0) @RECTANGLE(width=14, height=14);
*     @LINE {(0, 8) (0, 7)};
*     @LINE {(-8, 3) (-7, 3)};
*     @LINE {(-8, 1) (-7, 1)};
*     @LINE {(8, 1) (7, 1)};
*     @LINE {(-8, -3) (-7, -3)};
*     @LINE {(8, -1) (7, -1)};
*     @LINE {(-8, -5) (-7, -5)};
*     @LINE {(8, -3) (7, -3)};
*     @LINE {(-8, -1) (-7, -1)}
*   };
*   # @SET-SYMBOL %dut_SYMBOL;
*   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
*   #XMP1p @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(-7, 0) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MP1p") #XMP1p(part);
*   #XMP2p @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(-9, 0) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP2p") #XMP2p(part);
*   #XMP3p @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(-17, 0) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MP3p") #XMP3p(part);
*   #XMN1p @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(-7, -8) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MN1p") #XMN1p(part);
*   #XMNip @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(-7, -16) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MNip") #XMNip(part);
*   #XMNcp @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(-12, -16) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MNcp") #XMNcp(part);
*   #Ccal_p @SET-SYMBOL $CAPACITOR => @PLACE(-19, -18) => @ORIENT("R270");
*   #X1 @SET-SYMBOL(terminals=[[1, "a"], [2, "y"]]) $BUFFER => @PLACE(-11, -6) => @ORIENT("R180");
*   #XMP1m @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(7, 0) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP1m") #XMP1m(part);
*   #XMP2m @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(9, 0) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MP2m") #XMP2m(part);
*   #XMP3m @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(17, 0) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP3m") #XMP3m(part);
*   #XMN1m @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(7, -8) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MN1m") #XMN1m(part);
*   #XMNim @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(7, -16) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MNim") #XMNim(part);
*   #XMNcm @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(12, -16) => @ORIENT("MY");
*   $CANVAS_NAME @ATTACH(name="MNcm") #XMNcm(part);
*   #Ccal_n @SET-SYMBOL $CAPACITOR => @PLACE(19, -18) => @ORIENT("MYR90");
*   #X2 @SET-SYMBOL(terminals=[[1, "a"], [2, "y"]]) $BUFFER => @PLACE(11, -6) => @ORIENT("MX");
*   #XMP4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(-1, -16) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MP4") #XMP4(part);
*   #XMNt @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(1, -24) => @ORIENT("R0");
*   $CANVAS_NAME @ATTACH(name="MNt") #XMNt(part);
*   #XMNs @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(0, -30) => @ORIENT("R90");
*   $CANVAS_NAME @ATTACH(name="MNs") #XMNs(part);
*   #X3 @SET-SYMBOL(terminals=[[1, "a"], [2, "b"], [3, "y"]]) $NAND_2INPUT => @PLACE(0, -37) => @ORIENT("R0");
*   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(-1, -14) => @ORIENT("R0") => %vdd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(1, -26) => @ORIENT("R0") => %gnd1;
