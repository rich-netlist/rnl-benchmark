subckt dut (VDD VSS clk out_bar out Vip Vim cal valid cal_bar)
Ccal_n (net3 VSS) capacitor c=1p
Ccal_p (net4 VSS) capacitor c=1p
MN1m (net0 net1 net6 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MN1p (net1 net0 net2 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MNcm (net6 net3 net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MNcp (net2 net4 net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MNim (net6 Vim net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MNip (net2 Vip net5 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MNs (Vip cal Vim VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MNt (net5 clk VSS VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
MP1m (net0 net1 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
MP1p (net1 net0 VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
MP2m (net0 clk VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
MP2p (net1 clk VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
MP3m (net6 clk VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
MP3p (net2 clk VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
MP4 (net5 clk VDD VDD) sky130_fd_pr__pfet_01v8 l=0.15 w=1 nf=1 m=1
X1 (net1 out_bar VDD VSS) buffer td=10p vt=10m
X2 (net0 out VDD VSS) buffer td=10p vt=10m
X3 (out out_bar valid VDD VSS) nand_gate td=10p vt=10m
X4 (VDD VSS cal_bar out out_bar net4) CP
X5 (VDD VSS cal_bar out_bar out net3) CP
// @RNL(author="analog-canvas") {
//   %dut_SYMBOL = @DEFINE-SYMBOL(box=[-8, -8, 8, 8]) {
//     (0, 8) @PIN(terminal="VDD", label="\textbf{\textit{V}}_{\textbf{DD}}", direction="up");
//     (-8, 3) @PIN(terminal="clk", label="\textbf{\textit{clk}}", direction="left");
//     (-8, 1) @PIN(terminal="out_bar", label="\overline{\textbf{\textit{out}}}", direction="left");
//     (8, 1) @PIN(terminal="out", label="\textbf{\textit{out}}", direction="right");
//     (-8, -3) @PIN(terminal="Vip", label="\textbf{\textit{V}}_{\textbf{ip}}", direction="left");
//     (8, -1) @PIN(terminal="Vim", label="\textbf{\textit{V}}_{\textbf{im}}", direction="right");
//     (-8, -5) @PIN(terminal="cal", label="\textbf{\textit{cal}}", direction="left");
//     (8, -3) @PIN(terminal="valid", label="valid", direction="right");
//     (-8, -1) @PIN(terminal="cal_bar", label="\overline{\textbf{\textit{cal}}}", direction="left");
//     (0, 0) @RECTANGLE(width=14, height=14);
//     @LINE {(0, 8) (0, 7)};
//     @LINE {(-8, 3) (-7, 3)};
//     @LINE {(-8, 1) (-7, 1)};
//     @LINE {(8, 1) (7, 1)};
//     @LINE {(-8, -3) (-7, -3)};
//     @LINE {(8, -1) (7, -1)};
//     @LINE {(-8, -5) (-7, -5)};
//     @LINE {(8, -3) (7, -3)};
//     @LINE {(-8, -1) (-7, -1)}
//   };
//   # @SET-SYMBOL %dut_SYMBOL;
//   $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #(level);
//   #MP1p @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(-7, 0) => @ORIENT("MY");
//   #MP2p @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(-9, 0) => @ORIENT("R0");
//   #MP3p @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(-17, 0) => @ORIENT("MY");
//   #MN1p @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(-7, -8) => @ORIENT("MY");
//   #MNip @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(-7, -16) => @ORIENT("R0");
//   #MNcp @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(-12, -16) => @ORIENT("R0");
//   #Ccal_p @SET-SYMBOL $CAPACITOR => @PLACE(-19, -18) => @ORIENT("R270");
//   #X1 @SET-SYMBOL(terminals=[[1, "a"], [2, "y"]]) $BUFFER => @PLACE(-11, -6) => @ORIENT("R180");
//   #MP1m @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(7, 0) => @ORIENT("R0");
//   #MP2m @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(9, 0) => @ORIENT("MY");
//   #MP3m @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(17, 0) => @ORIENT("R0");
//   #MN1m @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(7, -8) => @ORIENT("R0");
//   #MNim @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(7, -16) => @ORIENT("MY");
//   #MNcm @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(12, -16) => @ORIENT("MY");
//   #Ccal_n @SET-SYMBOL $CAPACITOR => @PLACE(19, -18) => @ORIENT("MYR90");
//   #X2 @SET-SYMBOL(terminals=[[1, "a"], [2, "y"]]) $BUFFER => @PLACE(11, -6) => @ORIENT("MX");
//   #MP4 @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $PMOS => @PLACE(-1, -16) => @ORIENT("R0");
//   #MNt @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(1, -24) => @ORIENT("R0");
//   #MNs @SET-SYMBOL(terminals=[[1, "d"], [2, "g"], [3, "s"]]) $NMOS => @PLACE(0, -30) => @ORIENT("R90");
//   #X3 @SET-SYMBOL(terminals=[[1, "a"], [2, "b"], [3, "y"]]) $NAND_2INPUT => @PLACE(0, -37) => @ORIENT("R0");
//   $SUPPLY @ATTACH &VDD(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(-1, -14) => @ORIENT("R0") => %vdd1;
//   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(1, -26) => @ORIENT("R0") => %gnd1;
//   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(-21, -18) => @ORIENT("R0") => %gnd2;
//   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(21, -18) => @ORIENT("R0") => %gnd3;
//   $IO_PORT @ATTACH &clk(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-13, -3) => @ORIENT("R90") => %port1;
//   $IO_PORT @ATTACH &clk(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(13, -3) => @ORIENT("R90") => %port2;
//   $IO_PORT @ATTACH &clk(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(-5, -27) => @ORIENT("R90") => %port3;
