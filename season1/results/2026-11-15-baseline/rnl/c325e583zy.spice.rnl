
* @RNL(type="header") {
*   @VERSION("0.4");
*   @USE-PACKAGE(name="rnl-std-style", version="0.4");
*   @USE-PACKAGE(name="rnl-std-basic", version="0.4");
*   @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
*   @USE-PACKAGE(name="rnl-std-no-labels", version="0.4");
*   @USE-PACKAGE(name="analog-canvas-extensions", version="0.7");
*   @USE-PACKAGE(name="rnl-std-functional", version="0.4")
* }
.subckt icm_opamp_vdd_vss VIP VIN VDD VSS VOUT params: gain=1e6
Blin nlin 0 V={gain*(V(VIP)-V(VIN))}
Bcore VOUT 0 V={0.5*(V(VDD)+(0.5*(V(VSS)+V(nlin)+sqrt((V(nlin)-V(VSS))*(V(nlin)-V(VSS))+(1e-4*(V(VDD)-V(VSS)))*(1e-4*(V(VDD)-V(VSS)))+1e-12)))-sqrt((V(VDD)-(0.5*(V(VSS)+V(nlin)+sqrt((V(nlin)-V(VSS))*(V(nlin)-V(VSS))+(1e-4*(V(VDD)-V(VSS)))*(1e-4*(V(VDD)-V(VSS)))+1e-12))))*(V(VDD)-(0.5*(V(VSS)+V(nlin)+sqrt((V(nlin)-V(VSS))*(V(nlin)-V(VSS))+(1e-4*(V(VDD)-V(VSS)))*(1e-4*(V(VDD)-V(VSS)))+1e-12))))+(1e-4*(V(VDD)-V(VSS)))*(1e-4*(V(VDD)-V(VSS)))+1e-12))}
.ends icm_opamp_vdd_vss

.subckt vccg_regulator VCCU VSS Vref BS1 BS2 BS3 VCCG
C1 net1 VSS 10pF
Cload VCCG VSS 100pF
XM1 VCCG net3 VCCU VCCU sky130_fd_pr__pfet_01v8 l=0.5 w=50 nf=1 m=1
XM2 net0 net1 VCCG VCCU sky130_fd_pr__pfet_01v8 l=0.5 w=20 nf=1 m=1
XM3 net0 BS3 VSS VSS sky130_fd_pr__nfet_01v8 l=1 w=5 nf=1 m=1
XM4 net3 BS1 VCCU VCCU sky130_fd_pr__pfet_01v8 l=1 w=5 nf=1 m=1
XM5 net3 BS2 net0 VSS sky130_fd_pr__nfet_01v8 l=1 w=5 nf=1 m=1
XM6 net3 net3 VCCU VCCU sky130_fd_pr__pfet_01v8 l=0.5 w=2 nf=1 m=1
R1 VSS net2 100kΩ
R2 VCCG net2 100kΩ
X1 Vref net2 VCCU VSS net1 icm_opamp_vdd_vss gain=1e6
* @RNL(author="analog-canvas") {
*   %vccg_regulator_SYMBOL = @DEFINE-SYMBOL(box=[-6, -6, 6, 6]) {
*     (0, 6) @PIN(terminal="VCCU", label="\textbf{\textit{V}}_{\textbf{CCU}}", direction="up");
*     (-6, -3) @PIN(terminal="Vref", label="\textbf{\textit{V}}_{\textbf{ref}}", direction="left");
*     (-6, 1) @PIN(terminal="BS1", label="\textbf{\textit{BS1}}", direction="left");
*     (-6, -1) @PIN(terminal="BS2", label="\textbf{\textit{BS2}}", direction="left");
*     (6, -1) @PIN(terminal="BS3", label="\textbf{\textit{BS3}}", direction="right");
*     (-2, 6) @PIN(terminal="VCCG", label="\textbf{\textit{V}}_{\textbf{CCG}}", direction="up");
*     (0, 0) @RECTANGLE(width=10, height=10);
*     @LINE {(0, 6) (0, 5)};
*     @LINE {(-6, -3) (-5, -3)};
*     @LINE {(-6, 1) (-5, 1)};
*     @LINE {(-6, -1) (-5, -1)};
*     @LINE {(6, -1) (5, -1)};
*     @LINE {(-2, 6) (-2, 5)}
*   };
*   # @SET-SYMBOL %vccg_regulator_SYMBOL;
