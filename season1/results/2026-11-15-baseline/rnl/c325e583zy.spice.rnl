*   $CANVAS_NAME @ATTACH(name="M3") #XM3(part);
*   #X1 @SET-SYMBOL(terminals=[[1, "inp"], [2, "inn"], [5, "out"]]) $OPAMP => @PLACE(17, -14) => @ORIENT("R0");
*   $CANVAS_VARIANT @ATTACH(symbol="opamp") #X1(part);
*   $CANVAS_PARAMETER @ATTACH(name="vhigh", text="VDD") #X1(part);
*   $CANVAS_PARAMETER @ATTACH(name="vlow", text="VSS") #X1(part);
*   #C1 @SET-SYMBOL $CAPACITOR => @PLACE(24, -16) => @ORIENT("R0");
*   #R2 @SET-SYMBOL $RESISTOR => @PLACE(51, -19) => @ORIENT("R0");
*   #R1 @SET-SYMBOL $RESISTOR => @PLACE(55, -28) => @ORIENT("R270");
*   #Cload @SET-SYMBOL $CAPACITOR => @PLACE(58, -12) => @ORIENT("R0");
*   $SUPPLY @ATTACH &VCCU(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(31, 1) => @ORIENT("R0") => %vdd1;
*   $SUPPLY @ATTACH &VCCU(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(37, 1) => @ORIENT("R0") => %vdd2;
*   $SUPPLY @ATTACH &VCCU(p) => @SET-SYMBOL $SUPPLY_SYMBOL => @PLACE(44, 1) => @ORIENT("R0") => %vdd3;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(44, -24) => @ORIENT("R0") => %gnd1;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(24, -18) => @ORIENT("R0") => %gnd2;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(58, -14) => @ORIENT("R0") => %gnd3;
*   $GROUND @ATTACH &VSS(p) => @SET-SYMBOL $GROUND_SYMBOL => @PLACE(59, -29) => @ORIENT("R0") => %gnd4;
*   $IO_PORT @ATTACH &Vref(p) => @SET-SYMBOL $IO_PORT_SYMBOL => @PLACE(8, -13) => @ORIENT("R0") => %port1;
