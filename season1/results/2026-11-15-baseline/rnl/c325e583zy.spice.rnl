*   &VCCG @WIRE(mode="straight") {#R2:1 %j6};
*   &net2 @WIRE(mode="straight") {#R2:2 %j7};
*   &net2 @WIRE(mode="straight") {%j7 #R1:2};
*   &VSS @WIRE(mode="straight") {#R1:1 (59, -28) %gnd4::pin};
*   &Vref @WIRE(mode="straight") {%port1::pin #X1:1};
*   &net2 @WIRE(mode="straight") {%j7 (11, -28) (11, -15) #X1:2};
*   &net1 @WIRE(mode="straight") {#X1:5 #C1:1};
*   &net1 @WIRE(mode="straight") {#C1:1 #XM2:2};
*   &BS1 @WIRE(mode="straight") {%port2::pin #XM4:2};
*   &BS2 @WIRE(mode="straight") {%port3::pin #XM5:2};
*   &BS3 @WIRE(mode="straight") {%port4::pin #XM3:2};
*   $JUNCTION @ATTACH %j5(p) => @PLACE(44, -10) => %dot1;
*   $JUNCTION @ATTACH %j6(p) => @PLACE(51, -10) => %dot2;
*   $JUNCTION @ATTACH (58, -10)(p) => @PLACE(58, -10) => %dot3;
*   &VCCU @WIRE(mode="straight") {#XM6:3 %vdd2::pin};
*   &VSS @WIRE(mode="straight") {#Cload:2 %gnd3::pin};
*   &VSS @WIRE(mode="straight") {#C1:2 %gnd2::pin};
*   &VSS @WIRE(mode="straight") {#XM3:3 %gnd1::pin};
*   $JUNCTION @ATTACH %j4(p) => @PLACE(44, -18) => %dot4;
*   $JUNCTION @ATTACH (24, -14)(p) => @PLACE(24, -14) => %dot5;
*   $JUNCTION @ATTACH %j7(p) => @PLACE(51, -28) => %dot6;
*   $JUNCTION @ATTACH %j1(p) => @PLACE(31, -6) => %dot7;
*   $JUNCTION @ATTACH %j3(p) => @PLACE(37, -4) => %dot8;
*   $JUNCTION @ATTACH %j2(p) => @PLACE(37, -6) => %dot9;
