.subckt reflection_phase_shifter VSS rfin rfout vtune
C1 rfin VSS 3.2pF
C2 net0 VSS 3.2pF
C3 net3 VSS 3.2pF
C4 rfout VSS 3.2pF
L1 net0 rfin 2.35nH
L2 rfin rfout 3.3nH
L3 net3 rfout 2.35nH
L4 net0 net3 3.3nH
L5 net1 net0 1.5nH
L6 net2 net3 1.5nH
XMV1 net1 vtune net1 VSS sky130_fd_pr__nfet_01v8 l=0.5 w=480 nf=80 m=1
XMV2 net2 vtune net2 VSS sky130_fd_pr__nfet_01v8 l=0.5 w=480 nf=80 m=1
* @RNL(author="analog-canvas") {
