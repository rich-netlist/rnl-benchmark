subckt dut (VDD VSS Vout1 Vout2 F F_bar)
ISS (net0 VSS) isource dc=1m
ISS1 (net3 VSS) isource dc=1m
ISS2 (net4 VSS) isource dc=1m
M1 (Vout1 A net1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M2 (Vout2 A_bar net1 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M3 (net1 B net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M4 (Vout2 B_bar net0 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M5 (B F_bar net4 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M6 (B_bar F net4 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M7 (A_bar NC0002 net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
M8 (A NC0001 net3 VSS) sky130_fd_pr__nfet_01v8 l=0.15 w=1 nf=1 m=1
R1A (VDD A_bar) resistor r=1k
R1B (VDD A) resistor r=1k
R2A (net2 B) resistor r=1k
R2B (net2 B_bar) resistor r=1k
RD1 (VDD Vout1) resistor r=1k
RD2 (VDD Vout2) resistor r=1k
RT (VDD net2) resistor r=1k
